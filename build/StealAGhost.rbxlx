		Name = { fr = "Écureuil Fantôme Stressé", en = "Stressed Ghost Squirrel" },
		Gag = { fr = "A caché ses noisettes en 1923. Les cherche encore.", en = "Hid his nuts in 1923. Still looking." },
		Look = { Body = "Sheet", Color = { 175, 115, 60 }, Accent = { 230, 190, 140 }, Face = "Shocked", Accessories = { "CatEars", "SquirrelTail" } },
	},

	-- ===================== MYTHIQUES =====================
	{
		Id = "MegaBouhCosmique", Rarity = "Mythic", Price = 3500000, Income = 2500,
		Name = { fr = "Méga Bouh Cosmique", en = "Cosmic Mega Boo" },
		Gag = { fr = "A fait peur à une galaxie entière.", en = "Once scared an entire galaxy." },
		Look = { Body = "Sheet", Color = { 60, 40, 150 }, Accent = { 255, 120, 255 }, Face = "Happy", Accessories = { "Rings" } },
	},
	{
		Id = "EmpereurDesChaussettes", Rarity = "Mythic", Price = 5600000, Income = 4000,
		Name = { fr = "Empereur des Chaussettes", en = "Sock Emperor" },
		Gag = { fr = "Toutes les chaussettes perdues finissent chez lui.", en = "Every lost sock ends up at his palace." },
		Look = { Body = "Sock", Color = { 255, 215, 80 }, Accent = { 200, 30, 50 }, Face = "Monocle", Accessories = { "Crown", "Cape" } },
	},
	{
		Id = "SpectroPizzaSupreme", Rarity = "Mythic", Price = 8400000, Income = 6000,
		Name = { fr = "Spectro-Pizza Suprême", en = "Supreme Spectro-Pizza" },
		Gag = { fr = "Livrée en 30 secondes ou elle te hante.", en = "Delivered in 30 seconds or it haunts you." },
		Look = { Body = "Pizza", Color = { 255, 205, 70 }, Accent = { 200, 40, 40 }, Face = "Happy", Accessories = { "Pepperoni" } },
	},

	-- ===================== HALLOWEEN (édition limitée) =====================
	{
		Id = "CitrouilleToupie", Rarity = "Halloween", Price = 750000, Income = 1000,
		Name = { fr = "Citrouille Toupie", en = "Spinning Pumpkin" },
		Gag = { fr = "Tourne tellement qu'elle fait de la soupe.", en = "Spins so fast it makes soup." },
		Look = { Body = "Blob", Color = { 255, 130, 20 }, Accent = { 60, 140, 40 }, Face = "JackO", Accessories = { "Stem" }, Spin = 6 },
	},
	{
		Id = "SorciereTrottinette", Rarity = "Halloween", Price = 980000, Income = 1300,
		Name = { fr = "Sorcière Trottinette", en = "Scooter Witch" },
		Gag = { fr = "Le balai, c'était trop lent.", en = "The broom was too slow." },
		Look = { Body = "Sheet", Color = { 170, 120, 230 }, Accent = { 40, 30, 50 }, Face = "Happy", Accessories = { "WitchHat", "Scooter" } },
	},
	{
		Id = "SqueletteDisco", Rarity = "Halloween", Price = 1240000, Income = 1650,
		Name = { fr = "Squelette Disco", en = "Disco Skeleton" },
		Gag = { fr = "Danse jusqu'à l'os.", en = "Dances down to the bone." },
		Look = { Body = "Sheet", Color = { 240, 235, 220 }, Accent = { 220, 220, 255 }, Face = "Skull", Accessories = { "DiscoBall" } },
	},
	{
		Id = "BonbonHurleur", Rarity = "Halloween", Price = 1500000, Income = 2000,
		Name = { fr = "Bonbon Hurleur", en = "Howling Candy" },
		Gag = { fr = "Crie quand on veut le manger.", en = "Screams when you try to eat it." },
		Look = { Body = "Candy", Color = { 255, 90, 180 }, Accent = { 255, 230, 120 }, Face = "Shocked", Accessories = {} },
	},
}

-- Accès rapide par Id : GhostData.ById.DrapMou
GhostData.ById = {}
-- Liste par rareté : GhostData.ByRarity.Rare = { ... }
GhostData.ByRarity = {}

for index, ghost in GhostData.List do
	ghost.Order = index
	GhostData.ById[ghost.Id] = ghost
	GhostData.ByRarity[ghost.Rarity] = GhostData.ByRarity[ghost.Rarity] or {}
	table.insert(GhostData.ByRarity[ghost.Rarity], ghost)
end

-- Variantes rares : un fantôme du chemin peut être Doré (x3) ou Arc-en-ciel (x5).
-- Elles multiplient le revenu ET le prix. Chance = de jour, NightChance = pendant la nuit.
GhostData.Mutations = {
	Gold = { Mult = 3, Chance = 0.03, NightChance = 0.06, Color = { 255, 200, 40 }, Name = { fr = "Doré", en = "Golden" } },
	Rainbow = { Mult = 5, Chance = 0.006, NightChance = 0.015, Color = { 255, 110, 230 }, Name = { fr = "Arc-en-ciel", en = "Rainbow" } },
}
GhostData.MutationOrder = { "Gold", "Rainbow" }

-- Un fantôme est noté "DrapMou" ou, s'il a une variante, "DrapMou#Gold".
-- split("DrapMou#Gold") -> "DrapMou", "Gold"
function GhostData.split(key: string): (string, string?)
	local base, mutation = string.match(key, "^(%w+)#(%w+)$")
	if base then
		return base, mutation
	end
	return key, nil
end

function GhostData.key(baseId: string, mutation: string?): string
	if mutation then
		return baseId .. "#" .. mutation
	end
	return baseId
end

-- Les infos du fantôme (sans la variante). Marche avec "DrapMou" comme avec "DrapMou#Gold".
function GhostData.get(key: string)
	if type(key) ~= "string" then
		return nil
	end
	local base, mutation = GhostData.split(key)
	if mutation and not GhostData.Mutations[mutation] then
		return nil
	end
	return GhostData.ById[base]
end

function GhostData.mutationOf(key: string)
	local _, mutation = GhostData.split(key)
	return mutation and GhostData.Mutations[mutation]
end

-- Revenu par seconde et prix, variante comprise
function GhostData.incomeOf(key: string): number
	local ghost = GhostData.get(key)
	local mutation = GhostData.mutationOf(key)
	return if ghost then ghost.Income * (if mutation then mutation.Mult else 1) else 0
end

function GhostData.priceOf(key: string): number
	local ghost = GhostData.get(key)
	local mutation = GhostData.mutationOf(key)
	return if ghost then ghost.Price * (if mutation then mutation.Mult else 1) else 0
end

-- Tire une variante au hasard (ou nil). roll = nombre entre 0 et 1.
function GhostData.rollMutation(roll: number, isNight: boolean, boost: number?): string?
	local acc = 0
	for i = #GhostData.MutationOrder, 1, -1 do
		local name = GhostData.MutationOrder[i]
		local m = GhostData.Mutations[name]
		acc += (if isNight then m.NightChance else m.Chance) * (boost or 1)
		if roll < acc then
			return name
		end
	end
	return nil
end

-- Choisit un fantôme au hasard dans une rareté. roll = nombre entre 0 et 1.
function GhostData.pick(rarity: string, roll: number)
	local list = GhostData.ByRarity[rarity]
	if not list or #list == 0 then
		list = GhostData.ByRarity.Common
	end
	local index = math.clamp(math.floor(roll * #list) + 1, 1, #list)
	return list[index]
end

return GhostData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">GhostFactory</string>
          <string name="Source"><![CDATA[--[[
	GhostFactory : fabrique le modèle 3D d'un fantôme avec des formes simples
	(boules, blocs, cylindres). Aucun asset externe, très léger pour les mobiles.

	GhostFactory.build("DrapMou") renvoie un Model :
	  - toutes les pièces sont ancrées (Anchored) et sans collision
	  - on le déplace avec model:PivotTo(cframe)
	  - attribut "Bottom" = distance entre le centre et le bas du fantôme
	  - attribut "Top" = distance entre le centre et le haut du fantôme

	FANTÔMES DESSINÉS À LA MAIN DANS STUDIO
	Construis ton fantôme avec des Parts, groupe-les (Ctrl+G) et range le Model dans
	ReplicatedStorage > GhostModels, avec comme nom l'Id du fantôme (ex. "DrapMou",
	voir GhostData). Le jeu l'utilise à la place du modèle fabriqué ici :
	  - il est redimensionné tout seul (attribut "Height" sur le Model pour choisir sa
	    hauteur en studs, sinon environ 5 studs)
	  - s'il regarde dans la mauvaise direction : attribut "Turn" = 90, 180 ou -90
	  - le halo de rareté, les variantes Dorée et Arc-en-ciel sont ajoutés automatiquement
]]

local GhostData = require(script.Parent.GhostData)
local Rarities = require(script.Parent.Rarities)

local GhostFactory = {}

local BLACK = Color3.fromRGB(25, 20, 30)
local WHITE = Color3.fromRGB(255, 255, 255)
local GRAY = Color3.fromRGB(120, 125, 135)
local GOLD = Color3.fromRGB(255, 200, 40)
local PINK = Color3.fromRGB(255, 130, 170)

local ROT_UP = CFrame.Angles(0, 0, math.rad(90)) -- cylindre debout
local ROT_FRONT = CFrame.Angles(0, math.rad(90), 0) -- disque face à l'avant

local function rgb(t: { number }?, fallback: Color3): Color3
	if not t then
		return fallback
	end
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- Crée une pièce. kind = "Block", "Ball", "Cylinder" ou "Wedge"
local function newPart(ctx, kind: string, size: Vector3, cf: CFrame, color: Color3, extra: { [string]: any }?)
	local p: BasePart
	if kind == "Wedge" then
		p = Instance.new("WedgePart")
	else
		local part = Instance.new("Part")
		if kind == "Ball" then
			part.Shape = Enum.PartType.Ball
		elseif kind == "Cylinder" then
			part.Shape = Enum.PartType.Cylinder
		end
		p = part
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.Size = size
	p.CFrame = cf
	p.Color = color
	if extra then
		if extra.Material then
			p.Material = extra.Material
		end
		if extra.Transparency then
			p.Transparency = extra.Transparency
		end
		if extra.Reflectance then
			p.Reflectance = extra.Reflectance
		end
		if extra.Name then
			p.Name = extra.Name
		end
	end
	p.Parent = ctx.model
	return p
end

local function ball(ctx, d: number, pos: Vector3, color: Color3, extra: { [string]: any }?)
	return newPart(ctx, "Ball", Vector3.one * d, CFrame.new(pos), color, extra)
end

local function block(ctx, size: Vector3, cf: CFrame, color: Color3, extra: { [string]: any }?)
	return newPart(ctx, "Block", size, cf, color, extra)
end

-- Bloc aux coins arrondis (vu de face) : deux blocs en croix + 4 cylindres dans les coins.
-- C'est ce qui donne l'aspect "jouet en pâte à modeler" sans modèle 3D externe.
local function roundedBlock(ctx, size: Vector3, cf: CFrame, color: Color3, extra: { [string]: any }?, radius: number?)
	local r = math.min(radius or 0.3 * math.min(size.X, size.Y), size.X / 2, size.Y / 2)
	local main = block(ctx, Vector3.new(size.X - 2 * r, size.Y, size.Z), cf, color, extra)
	block(ctx, Vector3.new(size.X, size.Y - 2 * r, size.Z), cf, color, extra)
	for _, sx in { -1, 1 } do
		for _, sy in { -1, 1 } do
			local corner = cf * CFrame.new(sx * (size.X / 2 - r), sy * (size.Y / 2 - r), 0) * ROT_FRONT
			newPart(ctx, "Cylinder", Vector3.new(size.Z, 2 * r, 2 * r), corner, color, extra)
		end
	end
	return main
end

-- Cylindre debout (axe vertical)
local function upCyl(ctx, h: number, d: number, pos: Vector3, color: Color3, extra: { [string]: any }?)
	return newPart(ctx, "Cylinder", Vector3.new(h, d, d), CFrame.new(pos) * ROT_UP, color, extra)
end

-- Disque tourné vers l'avant (axe avant-arrière)
local function frontDisc(ctx, t: number, d: number, pos: Vector3, color: Color3, extra: { [string]: any }?)
	return newPart(ctx, "Cylinder", Vector3.new(t, d, d), CFrame.new(pos) * ROT_FRONT, color, extra)
end

-- Cylindre couché (axe gauche-droite)
local function sideCyl(ctx, t: number, d: number, pos: Vector3, color: Color3, extra: { [string]: any }?)
	return newPart(ctx, "Cylinder", Vector3.new(t, d, d), CFrame.new(pos), color, extra)
end

-- Position Z de la surface avant du corps (pour coller les yeux dessus)
local function frontZ(m, x: number, y: number): number
	if m.sphere then
		local c = m.sphere.center
		local r = m.sphere.r
		local inside = r * r - (x - c.X) ^ 2 - (y - c.Y) ^ 2
		if inside <= 0 then
			return c.Z
		end
		return c.Z - math.sqrt(inside)
	elseif m.cylR then
		local inside = m.cylR * m.cylR - x * x
		if inside <= 0 then
			return 0
		end
		return -math.sqrt(inside)
	end
	return m.front
end

----------------------------------------------------------------------
-- CORPS : chaque fonction construit le corps et renvoie ses mesures
----------------------------------------------------------------------
local Bodies = {}

function Bodies.Sheet(ctx)
	local s = ctx.s
	local body = { Material = ctx.material, Transparency = ctx.transparency, Reflectance = ctx.reflectance }
	ball(ctx, 4 * s, Vector3.new(0, 0.6 * s, 0), ctx.color, body)
	upCyl(ctx, 2.2 * s, 4 * s, Vector3.new(0, -0.9 * s, 0), ctx.color, body)
	-- trois petits pieds ronds (deux devant, un derrière)
	for i = 0, 2 do
		local a = math.rad(90 + i * 120)
		ball(ctx, 1.5 * s, Vector3.new(math.cos(a) * 1.25 * s, -2 * s, math.sin(a) * 1.25 * s), ctx.color, body)
	end
	return {
		top = 2.6 * s,
		bottom = -2.75 * s,
		faceY = 0.8 * s,
		faceX = 0,
		halfWidth = 2 * s,
		back = 2 * s,
		sphere = { center = Vector3.new(0, 0.6 * s, 0), r = 2 * s },
	}
end

function Bodies.Blob(ctx)
	local s = ctx.s
	ball(ctx, 4.2 * s, Vector3.zero, ctx.color, { Material = ctx.material, Transparency = ctx.transparency, Reflectance = ctx.reflectance })
	return {
		top = 2.1 * s,
		bottom = -2.1 * s,
		faceY = 0.3 * s,
		faceX = 0,
		halfWidth = 2.1 * s,
		back = 2.1 * s,
		sphere = { center = Vector3.zero, r = 2.1 * s },
	}
end

function Bodies.Block(ctx)
	local s = ctx.s
	local size = ctx.look.Size or { 3.4, 3.4, 1.2 }
	local v = Vector3.new(size[1], size[2], size[3]) * s
	roundedBlock(ctx, v, CFrame.identity, ctx.color, { Material = ctx.material, Transparency = ctx.transparency, Reflectance = ctx.reflectance })
	return {
		top = v.Y / 2,
		bottom = -v.Y / 2,
		faceY = v.Y * 0.12,
		faceX = 0,
		halfWidth = v.X / 2,
		back = v.Z / 2,
		front = -v.Z / 2,
	}
end

function Bodies.Tube(ctx)
	local s = ctx.s
	local size = ctx.look.Size or { 2.6, 4 }
	local d, h = size[1] * s, size[2] * s
	upCyl(ctx, h, d, Vector3.zero, ctx.color, { Material = ctx.material, Transparency = ctx.transparency })
	return {
		top = h / 2,
		bottom = -h / 2,
		faceY = h * 0.15,
		faceX = 0,
		halfWidth = d / 2,
		back = d / 2,
		cylR = d / 2,
	}
end

function Bodies.Cloud(ctx)
	local s = ctx.s
	local body = { Material = ctx.material, Transparency = ctx.transparency }
	ball(ctx, 3.4 * s, Vector3.zero, ctx.color, body)
	ball(ctx, 2.6 * s, Vector3.new(1.8 * s, -0.3 * s, 0.2 * s), ctx.color, body)
	ball(ctx, 2.6 * s, Vector3.new(-1.8 * s, -0.3 * s, 0.2 * s), ctx.color, body)
	ball(ctx, 2.6 * s, Vector3.new(0.5 * s, 1.3 * s, 0.4 * s), ctx.color, body)
	return {
		top = 2.6 * s,
		bottom = -1.7 * s,
		faceY = 0.1 * s,
		faceX = 0,
		halfWidth = 3.1 * s,
		back = 1.7 * s,
		sphere = { center = Vector3.zero, r = 1.7 * s },
	}
end

function Bodies.Sock(ctx)
	local s = ctx.s
	local body = { Material = ctx.material, Transparency = ctx.transparency }
	roundedBlock(ctx, Vector3.new(2, 3.4, 2) * s, CFrame.new(0, 0.6 * s, 0), ctx.color, body, 0.45 * s)
	block(ctx, Vector3.new(2.2, 0.6, 2.2) * s, CFrame.new(0, 2.1 * s, 0), ctx.accent)
	block(ctx, Vector3.new(2.1, 0.4, 2.1) * s, CFrame.new(0, -0.4 * s, 0), ctx.accent)
	roundedBlock(ctx, Vector3.new(3.2, 1.5, 2) * s, CFrame.new(0, -1.85 * s, -0.6 * s) * CFrame.Angles(0, math.rad(90), 0), ctx.color, body, 0.5 * s)
	return {
		top = 2.4 * s,
		bottom = -2.6 * s,
		faceY = 0.9 * s,
		faceX = 0,
		halfWidth = 1.1 * s,
		back = 1 * s,
		front = -1 * s,
	}
end

function Bodies.Disc(ctx)
	local s = ctx.s
	frontDisc(ctx, 0.7 * s, 4.4 * s, Vector3.zero, ctx.color, { Material = ctx.material })
	-- un peu de "sirop" sur le bord
	frontDisc(ctx, 0.75 * s, 1.4 * s, Vector3.new(1.2 * s, -1.2 * s, 0), Color3.fromRGB(150, 80, 30))
	return {
		top = 2.2 * s,
		bottom = -2.2 * s,
		faceY = 0.3 * s,
		faceX = 0,
		halfWidth = 2.2 * s,
		back = 0.35 * s,
		front = -0.35 * s,
	}
end

function Bodies.Tornado(ctx)
	local s = ctx.s
	local body = { Material = ctx.material, Transparency = ctx.transparency }
	upCyl(ctx, 1.3 * s, 4.4 * s, Vector3.new(0, 1.3 * s, 0), ctx.color, body)
	upCyl(ctx, 1.3 * s, 3.4 * s, Vector3.new(0, 0, 0), ctx.accent, body)
	upCyl(ctx, 1.3 * s, 2.2 * s, Vector3.new(0, -1.3 * s, 0), ctx.color, body)
	upCyl(ctx, 1 * s, 1 * s, Vector3.new(0, -2.3 * s, 0), ctx.accent, body)
	return {
		top = 1.95 * s,
		bottom = -2.8 * s,
		faceY = 1.25 * s,
		faceX = 0,
		halfWidth = 2.2 * s,
		back = 2.2 * s,
		cylR = 2.2 * s,
		faceScale = 0.8,
	}
end

function Bodies.Pizza(ctx)
	local s = ctx.s
	local h, d = 4.6 * s, 4 * s
	newPart(
		ctx,
		"Wedge",
		Vector3.new(0.7 * s, h, d),
		CFrame.Angles(0, 0, math.pi) * CFrame.Angles(0, math.pi / 2, 0),
		ctx.color,
		{ Material = ctx.material }
	)
	-- la croûte
	block(ctx, Vector3.new(d + 0.4 * s, 0.7 * s, 1 * s), CFrame.new(0, h / 2 + 0.2 * s, 0), Color3.fromRGB(200, 130, 60))
	return {
		top = h / 2 + 0.55 * s,
		bottom = -h / 2,
		faceY = h / 6,
		faceX = -d / 6,
		halfWidth = d / 2,
		back = 0.5 * s,
		front = -0.35 * s,
	}
end

function Bodies.Candy(ctx)
	local s = ctx.s
	ball(ctx, 3.2 * s, Vector3.zero, ctx.color, { Material = ctx.material, Reflectance = 0.1 })
	block(ctx, Vector3.new(1.6, 2.2, 0.5) * s, CFrame.new(2.2 * s, 0, 0) * CFrame.Angles(0, 0, math.rad(-20)), ctx.accent)
	block(ctx, Vector3.new(1.6, 2.2, 0.5) * s, CFrame.new(-2.2 * s, 0, 0) * CFrame.Angles(0, 0, math.rad(20)), ctx.accent)
	return {
		top = 1.6 * s,
		bottom = -1.6 * s,
		faceY = 0.15 * s,
		faceX = 0,
		halfWidth = 1.6 * s,
		back = 1.6 * s,
		sphere = { center = Vector3.zero, r = 1.6 * s },
	}
end

function Bodies.Leaf(ctx)
	local s = ctx.s
	local leafCf = CFrame.Angles(0, 0, math.rad(45))
	block(ctx, Vector3.new(3, 3, 0.4) * s, leafCf, ctx.color, { Material = ctx.material })
	-- nervure centrale et petite tige
	block(ctx, Vector3.new(0.18 * s, 4.2 * s, 0.45 * s), CFrame.new(0, 0, 0.02 * s), ctx.accent)
	upCyl(ctx, 1.2 * s, 0.3 * s, Vector3.new(0, -2.5 * s, 0), ctx.accent)
	return {
		top = 2.1 * s,
		bottom = -3.1 * s,
		faceY = 0.2 * s,
		faceX = 0,
		halfWidth = 2.1 * s,
		back = 0.2 * s,
		front = -0.25 * s,
	}
end

function Bodies.Mushroom(ctx)
	local s = ctx.s
	-- chapeau rouge à pois blancs + pied clair (le visage est sur le pied)
	upCyl(ctx, 1.3 * s, 4.8 * s, Vector3.new(0, 1.1 * s, 0), ctx.color, { Material = ctx.material })
	ball(ctx, 3.6 * s, Vector3.new(0, 1.6 * s, 0), ctx.color, { Material = ctx.material })
	for _, p in { Vector3.new(-1.3, 2.6, -0.9), Vector3.new(1.1, 2.9, -0.6), Vector3.new(0.1, 3.3, 0.6), Vector3.new(-0.4, 2.2, -1.8) } do
		ball(ctx, 0.7 * s, p * s, WHITE)
	end
	upCyl(ctx, 2.6 * s, 2.4 * s, Vector3.new(0, -0.8 * s, 0), ctx.accent)
	return {
		top = 3.4 * s,
		bottom = -2.1 * s,
		faceY = -0.85 * s,
		faceX = 0,
		halfWidth = 2.4 * s,
		back = 1.2 * s,
		cylR = 1.2 * s,
	}
end

----------------------------------------------------------------------
-- VISAGES
----------------------------------------------------------------------
local Faces = {}

local function eyeAt(ctx, m, x: number, y: number, d: number, color: Color3?, extra: { [string]: any }?)
	local z = frontZ(m, x, y) + 0.12 * ctx.s
	return ball(ctx, d, Vector3.new(x, y, z), color or BLACK, extra)
end

local function flatAt(ctx, m, size: Vector3, x: number, y: number, rotZ: number, color: Color3, extra: { [string]: any }?)
	local z = frontZ(m, x, y) - 0.02 * ctx.s
	return block(ctx, size, CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(rotZ)), color, extra)
end

local function twoEyes(ctx, m, d: number?)
	local f = ctx.f
	local eyeD = (d or 0.75) * f
	eyeAt(ctx, m, m.faceX - 0.65 * f, m.faceY + 0.35 * f, eyeD)
	eyeAt(ctx, m, m.faceX + 0.65 * f, m.faceY + 0.35 * f, eyeD)
end

local function smile(ctx, m, sad: boolean?)
	local f = ctx.f
	local y = m.faceY - 0.5 * f
	local curve = if sad then -0.9 else 0.9
	for i = -3, 3 do
		local x = i * 0.16 * f
		local dy = curve * (x / f) ^ 2
		local px, py = m.faceX + x, y + dy
		ball(ctx, 0.19 * f, Vector3.new(px, py, frontZ(m, px, py) + 0.03 * ctx.s), BLACK)
	end
end

function Faces.Happy(ctx, m)
	twoEyes(ctx, m)
	smile(ctx, m)
end

function Faces.Sad(ctx, m)
	twoEyes(ctx, m)
	smile(ctx, m, true)
end

function Faces.Sleepy(ctx, m)
	local f = ctx.f
	flatAt(ctx, m, Vector3.new(0.7 * f, 0.15 * f, 0.3 * f), m.faceX - 0.65 * f, m.faceY + 0.35 * f, 0, BLACK)
	flatAt(ctx, m, Vector3.new(0.7 * f, 0.15 * f, 0.3 * f), m.faceX + 0.65 * f, m.faceY + 0.35 * f, 0, BLACK)
	eyeAt(ctx, m, m.faceX, m.faceY - 0.4 * f, 0.45 * f)
end

function Faces.Angry(ctx, m)
	local f = ctx.f
	twoEyes(ctx, m)
	flatAt(ctx, m, Vector3.new(0.7 * f, 0.18 * f, 0.3 * f), m.faceX - 0.65 * f, m.faceY + 0.85 * f, -25, BLACK)
	flatAt(ctx, m, Vector3.new(0.7 * f, 0.18 * f, 0.3 * f), m.faceX + 0.65 * f, m.faceY + 0.85 * f, 25, BLACK)
	flatAt(ctx, m, Vector3.new(0.9 * f, 0.18 * f, 0.3 * f), m.faceX, m.faceY - 0.45 * f, 0, BLACK)
end

function Faces.Shy(ctx, m)
	local f = ctx.f
	twoEyes(ctx, m, 0.5)
	eyeAt(ctx, m, m.faceX - 1.1 * f, m.faceY - 0.1 * f, 0.55 * f, PINK, { Transparency = 0.2 })
	eyeAt(ctx, m, m.faceX + 1.1 * f, m.faceY - 0.1 * f, 0.55 * f, PINK, { Transparency = 0.2 })
	eyeAt(ctx, m, m.faceX, m.faceY - 0.35 * f, 0.3 * f)
end

function Faces.Shocked(ctx, m)
	local f = ctx.f
	twoEyes(ctx, m, 0.95)
	eyeAt(ctx, m, m.faceX, m.faceY - 0.5 * f, 0.8 * f)
end

function Faces.BigMouth(ctx, m)
	local f = ctx.f
	twoEyes(ctx, m)
	flatAt(ctx, m, Vector3.new(1.6 * f, 0.7 * f, 0.4 * f), m.faceX, m.faceY - 0.55 * f, 0, BLACK)
	flatAt(ctx, m, Vector3.new(0.3 * f, 0.3 * f, 0.45 * f), m.faceX - 0.35 * f, m.faceY - 0.35 * f, 0, WHITE)
	flatAt(ctx, m, Vector3.new(0.3 * f, 0.3 * f, 0.45 * f), m.faceX + 0.35 * f, m.faceY - 0.35 * f, 0, WHITE)
end

function Faces.Cool(ctx, m)
	local f = ctx.f
	flatAt(ctx, m, Vector3.new(2.2 * f, 0.55 * f, 0.35 * f), m.faceX, m.faceY + 0.35 * f, 0, BLACK, { Reflectance = 0.3 })
	smile(ctx, m)
end

function Faces.Blank(ctx, m)
	local f = ctx.f
	local cyan = ctx.accent
	flatAt(ctx, m, Vector3.new(0.45, 0.45, 0.3) * f, m.faceX - 0.65 * f, m.faceY + 0.35 * f, 0, cyan, { Material = Enum.Material.Neon })
	flatAt(ctx, m, Vector3.new(0.45, 0.45, 0.3) * f, m.faceX + 0.65 * f, m.faceY + 0.35 * f, 0, cyan, { Material = Enum.Material.Neon })
	flatAt(ctx, m, Vector3.new(0.9, 0.15, 0.3) * f, m.faceX, m.faceY - 0.4 * f, 0, cyan, { Material = Enum.Material.Neon })
end

function Faces.Cat(ctx, m)
	local f = ctx.f
	twoEyes(ctx, m)
	eyeAt(ctx, m, m.faceX, m.faceY - 0.1 * f, 0.3 * f, PINK)
	flatAt(ctx, m, Vector3.new(0.5 * f, 0.15 * f, 0.3 * f), m.faceX - 0.22 * f, m.faceY - 0.42 * f, -30, BLACK)
	flatAt(ctx, m, Vector3.new(0.5 * f, 0.15 * f, 0.3 * f), m.faceX + 0.22 * f, m.faceY - 0.42 * f, 30, BLACK)
end

function Faces.Dizzy(ctx, m)
	local f = ctx.f
	for _, side in { -1, 1 } do
		local x = m.faceX + side * 0.65 * f
		flatAt(ctx, m, Vector3.new(0.7 * f, 0.15 * f, 0.3 * f), x, m.faceY + 0.35 * f, 45, BLACK)
		flatAt(ctx, m, Vector3.new(0.7 * f, 0.15 * f, 0.3 * f), x, m.faceY + 0.35 * f, -45, BLACK)
	end
	eyeAt(ctx, m, m.faceX, m.faceY - 0.45 * f, 0.45 * f)
end

function Faces.Monocle(ctx, m)
	local f = ctx.f
	twoEyes(ctx, m)
	local x, y = m.faceX + 0.65 * f, m.faceY + 0.35 * f
	local z = frontZ(m, x, y)
	frontDisc(ctx, 0.08 * f, 1.05 * f, Vector3.new(x, y, z + 0.02 * f), GOLD, { Transparency = 0.3, Reflectance = 0.3 })
	smile(ctx, m)
end

function Faces.Pirate(ctx, m)
	local f = ctx.f
	eyeAt(ctx, m, m.faceX - 0.65 * f, m.faceY + 0.35 * f, 0.8 * f)
	local x, y = m.faceX + 0.65 * f, m.faceY + 0.35 * f
	frontDisc(ctx, 0.25 * f, 0.85 * f, Vector3.new(x, y, frontZ(m, x, y) + 0.05 * f), BLACK)
	flatAt(ctx, m, Vector3.new(2.6 * f, 0.12 * f, 0.25 * f), m.faceX, m.faceY + 0.55 * f, -12, BLACK)
	smile(ctx, m)
end

function Faces.Skull(ctx, m)
	local f = ctx.f
	twoEyes(ctx, m, 1.05)
	flatAt(ctx, m, Vector3.new(0.25, 0.35, 0.3) * f, m.faceX, m.faceY - 0.15 * f, 0, BLACK)
	flatAt(ctx, m, Vector3.new(1.2, 0.3, 0.3) * f, m.faceX, m.faceY - 0.6 * f, 0, BLACK)
	for i = -1, 1 do
		flatAt(ctx, m, Vector3.new(0.08, 0.32, 0.35) * f, m.faceX + i * 0.3 * f, m.faceY - 0.6 * f, 0, WHITE)
	end
end

function Faces.JackO(ctx, m)
	local f = ctx.f
	local glow = Color3.fromRGB(255, 230, 80)
	local neon = { Material = Enum.Material.Neon }
	flatAt(ctx, m, Vector3.new(0.6, 0.6, 0.3) * f, m.faceX - 0.7 * f, m.faceY + 0.4 * f, 45, glow, neon)
	flatAt(ctx, m, Vector3.new(0.6, 0.6, 0.3) * f, m.faceX + 0.7 * f, m.faceY + 0.4 * f, 45, glow, neon)
	flatAt(ctx, m, Vector3.new(2, 0.45, 0.3) * f, m.faceX, m.faceY - 0.5 * f, 0, glow, neon)
	flatAt(ctx, m, Vector3.new(0.3, 0.25, 0.35) * f, m.faceX - 0.4 * f, m.faceY - 0.38 * f, 0, ctx.color)
	flatAt(ctx, m, Vector3.new(0.3, 0.25, 0.35) * f, m.faceX + 0.4 * f, m.faceY - 0.62 * f, 0, ctx.color)
end

----------------------------------------------------------------------
-- ACCESSOIRES
----------------------------------------------------------------------
local Accessories = {}

function Accessories.Jam(ctx, m)
	local s = ctx.s
	local w, h = m.halfWidth * 2 * 0.8, (m.top - m.bottom) * 0.8
	block(ctx, Vector3.new(w, h, 0.06 * s), CFrame.new(0, 0, m.front - 0.02 * s), ctx.accent, { Transparency = 0.1 })
end

function Accessories.Bun(ctx, m)
	local s = ctx.s
	ball(ctx, 1.6 * s, Vector3.new(0, m.top + 0.3 * s, 0.4 * s), ctx.accent)
	ball(ctx, 0.5 * s, Vector3.new(0.6 * s, m.top + 0.7 * s, 0.5 * s), Color3.fromRGB(255, 120, 160))
end

function Accessories.Crumbs(ctx, _m)
	local s = ctx.s
	local spots = {
		Vector3.new(1.8, -1.3, -0.8),
		Vector3.new(1.2, -2.0, 0.6),
		Vector3.new(-1.0, -2.1, -1.1),
		Vector3.new(-1.9, -0.9, 0.4),
	}
	for i, p in spots do
		block(ctx, Vector3.one * 0.4 * s, CFrame.new(p * s) * CFrame.Angles(i, i * 2, 0), ctx.accent)
	end
end

function Accessories.Spaghetti(ctx, m)
	local s = ctx.s
	local pasta = Color3.fromRGB(255, 220, 120)
	for i, z in { -0.9, -0.3, 0.3, 0.9 } do
		local tilt = if i % 2 == 0 then 25 else -20
		local cf = CFrame.new(0, m.top - 0.35 * s, z * s) * CFrame.Angles(0, 0, math.rad(tilt))
		newPart(ctx, "Cylinder", Vector3.new(3.4 * s, 0.25 * s, 0.25 * s), cf, pasta)
	end
	ball(ctx, 1 * s, Vector3.new(0.3 * s, m.top + 0.25 * s, 0), ctx.accent)
end

function Accessories.LoadingRing(ctx, m)
	local s = ctx.s
	upCyl(ctx, 0.15 * s, 2.6 * s, Vector3.new(0, m.top + 0.8 * s, 0), ctx.accent, { Material = Enum.Material.Neon, Transparency = 0.3 })
	block(ctx, Vector3.one * 0.5 * s, CFrame.new(1.5 * s, m.top - 0.3 * s, -0.5 * s), ctx.accent, { Material = Enum.Material.Neon })
end

function Accessories.ChickenComb(ctx, m)
	local s = ctx.s
	for _, z in { -0.5, 0, 0.5 } do
		ball(ctx, 0.8 * s, Vector3.new(0, m.top + 0.1 * s + (0.15 - math.abs(z) * 0.3) * s, z * s), ctx.accent)
	end
	local y = m.faceY - 0.05 * s
	newPart(ctx, "Wedge", Vector3.new(0.6, 0.4, 0.8) * s, CFrame.new(0, y, frontZ(m, 0, y) - 0.2 * s), GOLD)
end

function Accessories.FridgeHandle(ctx, m)
	local s = ctx.s
	local x = m.halfWidth - 0.35 * s
	block(ctx, Vector3.new(m.halfWidth * 2, 0.1 * s, 0.1 * s), CFrame.new(0, m.top - 0.75 * s, m.front - 0.03 * s), ctx.accent)
	block(ctx, Vector3.new(0.25, 0.6, 0.35) * s, CFrame.new(x, m.top - 0.4 * s, m.front - 0.15 * s), ctx.accent)
	block(ctx, Vector3.new(0.25, 1.2, 0.35) * s, CFrame.new(x, m.bottom + 1 * s, m.front - 0.15 * s), ctx.accent)
end

function Accessories.Stalk(ctx, m)
	local s = ctx.s
	upCyl(ctx, 1.8 * s, 1.4 * s, Vector3.new(0, m.bottom - 0.5 * s, 0), ctx.accent)
end

function Accessories.Pompom(ctx, m)
	local s = ctx.s
	ball(ctx, 1.3 * s, Vector3.new(0, m.top + 0.35 * s, m.front + 1.7 * s), ctx.accent)
end

function Accessories.Handle(ctx, m)
	local s = ctx.s
	upCyl(ctx, 3.2 * s, 0.45 * s, Vector3.new(0, m.bottom - 1.6 * s, 0), ctx.accent)
end

function Accessories.Rain(ctx, m)
	local s = ctx.s
	local emitterPart = block(ctx, Vector3.new(m.halfWidth * 1.4, 0.2, 1.5 * s), CFrame.new(0, m.bottom - 0.2 * s, 0), WHITE, { Transparency = 1 })
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(ctx.accent)
	e.Size = NumberSequence.new(0.18 * s)
	e.Speed = NumberRange.new(4, 6)
	e.Acceleration = Vector3.new(0, -25, 0)
	e.EmissionDirection = Enum.NormalId.Bottom
	e.Rate = 10
	e.Lifetime = NumberRange.new(0.4, 0.6)
	e.LightEmission = 0.3
	e.Parent = emitterPart
end

function Accessories.Antenna(ctx, m)
	local s = ctx.s
	upCyl(ctx, 1.8 * s, 0.18 * s, Vector3.new(0, m.top + 0.8 * s, 0), GRAY)
	ball(ctx, 0.55 * s, Vector3.new(0, m.top + 1.8 * s, 0), ctx.accent, { Material = Enum.Material.Neon })
end

function Accessories.ChefHat(ctx, m)
	local s = ctx.s
	upCyl(ctx, 1.1 * s, 1.9 * s, Vector3.new(0, m.top + 0.35 * s, 0), WHITE)
	ball(ctx, 2.3 * s, Vector3.new(0, m.top + 1.3 * s, 0), WHITE)
end

function Accessories.Flame(ctx, m)
	local s = ctx.s
	local flame = ball(ctx, 1.1 * s, Vector3.new(0, m.top + 0.6 * s, 0), ctx.accent, { Material = Enum.Material.Neon })
	ball(ctx, 0.6 * s, Vector3.new(0, m.top + 0.45 * s, -0.25 * s), Color3.fromRGB(255, 240, 120), { Material = Enum.Material.Neon })
	upCyl(ctx, 1 * s, 0.5 * s, Vector3.new(m.halfWidth - 0.15 * s, m.top - 0.4 * s, -0.6 * s), ctx.color)
	local light = Instance.new("PointLight")
	light.Color = ctx.accent
	light.Range = 10
	light.Brightness = 1.2
	light.Shadows = false
	light.Parent = flame
end

function Accessories.CatEars(ctx, m)
	local s = ctx.s
	local size = Vector3.new(0.35, 1.3, 1.1) * s
	newPart(ctx, "Wedge", size, CFrame.new(-0.95 * s, m.top - 0.1 * s, 0) * CFrame.Angles(0, -math.pi / 2, 0), ctx.color)
	newPart(ctx, "Wedge", size, CFrame.new(0.95 * s, m.top - 0.1 * s, 0) * CFrame.Angles(0, math.pi / 2, 0), ctx.color)
	ball(ctx, 0.5 * s, Vector3.new(-0.95 * s, m.top - 0.05 * s, -0.25 * s), ctx.accent)
	ball(ctx, 0.5 * s, Vector3.new(0.95 * s, m.top - 0.05 * s, -0.25 * s), ctx.accent)
end

function Accessories.Bumps(ctx, _m)
	local s = ctx.s
	local darker = ctx.color:Lerp(BLACK, 0.25)
	for _, p in { Vector3.new(1.15, 0.9, 0.3), Vector3.new(-1.15, -0.6, 0.2), Vector3.new(0.6, -1.5, -1.0), Vector3.new(-0.5, 1.7, 0.95) } do
		ball(ctx, 0.6 * s, p * s, darker)
	end
end

function Accessories.PirateHat(ctx, m)
	local s = ctx.s
	block(ctx, Vector3.new(3.4, 0.9, 1.6) * s, CFrame.new(0, m.top + 0.4 * s, 0), Color3.fromRGB(30, 30, 35))
	block(ctx, Vector3.new(3.45, 0.2, 1.65) * s, CFrame.new(0, m.top + 0.05 * s, 0), GOLD)
	ball(ctx, 0.5 * s, Vector3.new(0, m.top + 0.45 * s, -0.8 * s), WHITE)
end

function Accessories.String(ctx, m)
	local s = ctx.s
	upCyl(ctx, 3 * s, 0.1 * s, Vector3.new(0, m.bottom - 1.5 * s, 0), ctx.accent)
	ball(ctx, 0.45 * s, Vector3.new(0, m.bottom - 0.05 * s, 0), ctx.color)
end

function Accessories.Lumps(ctx, _m)
	local s = ctx.s
	local darker = ctx.color:Lerp(BLACK, 0.15)
	for _, p in { Vector3.new(1.6, 0.6, 0.9), Vector3.new(-1.5, -0.9, -0.5), Vector3.new(0.4, -1.6, -1.0) } do
		ball(ctx, 1.3 * s, p * s, darker)
	end
end

function Accessories.Crown(ctx, m)
	local s = ctx.s
	local gold = { Reflectance = 0.25 }
	upCyl(ctx, 0.9 * s, 2.2 * s, Vector3.new(0, m.top + 0.35 * s, 0), GOLD, gold)
	for _, p in { Vector3.new(0.9, 0, 0), Vector3.new(-0.9, 0, 0), Vector3.new(0, 0, 0.9), Vector3.new(0, 0, -0.9) } do
		ball(ctx, 0.45 * s, Vector3.new(p.X * s, m.top + 0.9 * s, p.Z * s), GOLD, gold)
	end
	ball(ctx, 0.45 * s, Vector3.new(0, m.top + 0.35 * s, -1.1 * s), Color3.fromRGB(230, 30, 60), { Reflectance = 0.3 })
end

function Accessories.Headphones(ctx, m)
	local s = ctx.s
	local w = m.halfWidth + 0.1 * s
	block(ctx, Vector3.new(w * 2 + 0.3 * s, 0.35 * s, 0.6 * s), CFrame.new(0, m.top + 0.1 * s, 0), BLACK)
	for _, side in { -1, 1 } do
		block(ctx, Vector3.new(0.3, 1.1, 0.5) * s, CFrame.new(side * (w + 0.05 * s), m.top - 0.45 * s, 0), BLACK)
		sideCyl(ctx, 0.7 * s, 1.5 * s, Vector3.new(side * w, m.faceY + 0.3 * s, 0), ctx.accent, { Material = Enum.Material.Neon })
	end
end

function Accessories.TopHat(ctx, m)
	local s = ctx.s
	local hat = Color3.fromRGB(25, 25, 30)
	upCyl(ctx, 0.2 * s, 2.8 * s, Vector3.new(0, m.top + 0.1 * s, 0), hat)
	upCyl(ctx, 1.7 * s, 1.8 * s, Vector3.new(0, m.top + 1 * s, 0), hat)
	upCyl(ctx, 0.35 * s, 1.85 * s, Vector3.new(0, m.top + 0.4 * s, 0), Color3.fromRGB(200, 40, 60))
end

function Accessories.Mustache(ctx, m)
	local s = ctx.s
	local f = ctx.f
	local y = m.faceY - 0.12 * f
	local z = frontZ(m, m.faceX, y) - 0.12 * s
	block(ctx, Vector3.new(1.5 * f, 0.3 * f, 0.25 * s), CFrame.new(m.faceX, y, z), BLACK)
	ball(ctx, 0.45 * f, Vector3.new(m.faceX - 0.8 * f, y + 0.08 * f, z), BLACK)
	ball(ctx, 0.45 * f, Vector3.new(m.faceX + 0.8 * f, y + 0.08 * f, z), BLACK)
end

function Accessories.Rocket(ctx, m)
	local s = ctx.s
	for _, side in { -1, 1 } do
		local x = side * 0.65 * s
		local z = m.back + 0.35 * s
		upCyl(ctx, 2 * s, 0.9 * s, Vector3.new(x, 0, z), GRAY, { Reflectance = 0.2 })
		local fire = ball(ctx, 0.7 * s, Vector3.new(x, -1.15 * s, z), Color3.fromRGB(255, 140, 30), { Material = Enum.Material.Neon })
		local e = Instance.new("ParticleEmitter")
		e.Color = ColorSequence.new(Color3.fromRGB(255, 200, 60), Color3.fromRGB(255, 70, 20))
		e.Size = NumberSequence.new(0.6 * s, 0)
		e.Speed = NumberRange.new(5, 7)
		e.EmissionDirection = Enum.NormalId.Bottom
		e.Rate = 15
		e.Lifetime = NumberRange.new(0.3, 0.4)
		e.LightEmission = 1
		e.Parent = fire
	end
end

function Accessories.Rings(ctx, m)
	local s = ctx.s
	newPart(
		ctx,
		"Cylinder",
		Vector3.new(0.15 * s, 7.2 * s, 7.2 * s),
		CFrame.new(0, m.faceY - 0.6 * s, 0) * CFrame.Angles(math.rad(15), 0, 0) * ROT_UP,
		ctx.accent,
		{ Material = Enum.Material.Neon, Transparency = 0.35 }
	)
end

function Accessories.Cape(ctx, m)
	local s = ctx.s
	block(ctx, Vector3.new(3.6, 3.8, 0.25) * s, CFrame.new(0, -0.3 * s, m.back + 0.15 * s) * CFrame.Angles(math.rad(-8), 0, 0), ctx.accent)
end

function Accessories.Pepperoni(ctx, m)
	local s = ctx.s
	for _, p in { Vector2.new(1.0, 1.85), Vector2.new(-1.6, -1.3), Vector2.new(-0.9, -0.65) } do
		frontDisc(ctx, 0.15 * s, 0.9 * s, Vector3.new(p.X * s, p.Y * s, m.front - 0.05 * s), ctx.accent)
	end
end

function Accessories.Stem(ctx, m)
	local s = ctx.s
	newPart(ctx, "Cylinder", Vector3.new(0.9 * s, 0.5 * s, 0.5 * s), CFrame.new(0, m.top + 0.35 * s, 0) * CFrame.Angles(math.rad(10), 0, 0) * ROT_UP, ctx.accent)
end

function Accessories.WitchHat(ctx, m)
	local s = ctx.s
	local dark = ctx.accent
	upCyl(ctx, 0.18 * s, 3.6 * s, Vector3.new(0, m.top + 0.05 * s, 0), dark)
	upCyl(ctx, 0.9 * s, 2.2 * s, Vector3.new(0, m.top + 0.55 * s, 0), dark)
	upCyl(ctx, 0.3 * s, 2.25 * s, Vector3.new(0, m.top + 0.3 * s, 0), Color3.fromRGB(255, 140, 30))
	upCyl(ctx, 0.9 * s, 1.5 * s, Vector3.new(0, m.top + 1.4 * s, 0.1 * s), dark)
	upCyl(ctx, 0.9 * s, 0.8 * s, Vector3.new(0, m.top + 2.2 * s, 0.25 * s), dark)
end

function Accessories.Scooter(ctx, m)
	local s = ctx.s
	local y = m.bottom - 0.5 * s
	block(ctx, Vector3.new(1.4, 0.3, 4) * s, CFrame.new(0, y, 0), GRAY)
	sideCyl(ctx, 0.5 * s, 1 * s, Vector3.new(0, y - 0.4 * s, 1.6 * s), BLACK)
	sideCyl(ctx, 0.5 * s, 1 * s, Vector3.new(0, y - 0.4 * s, -1.6 * s), BLACK)
	upCyl(ctx, 3.6 * s, 0.3 * s, Vector3.new(0, y + 1.8 * s, -1.9 * s), GRAY)
	sideCyl(ctx, 2.4 * s, 0.3 * s, Vector3.new(0, y + 3.6 * s, -1.9 * s), Color3.fromRGB(255, 140, 30))
end

function Accessories.DiscoBall(ctx, m)
	local s = ctx.s
	upCyl(ctx, 0.6 * s, 0.1 * s, Vector3.new(0, m.top + 0.4 * s, 0), GRAY)
	local disco = ball(ctx, 1.8 * s, Vector3.new(0, m.top + 1.6 * s, 0), Color3.fromRGB(220, 220, 240), { Material = Enum.Material.Foil, Reflectance = 0.5 })
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 200)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 220, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 80)),
	})
	e.Size = NumberSequence.new(0.3 * s)
	e.Speed = NumberRange.new(3, 5)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rate = 8
	e.Lifetime = NumberRange.new(0.6, 1)
	e.LightEmission = 1
	e.Parent = disco
end

function Accessories.Hilum(ctx, m)
	local s = ctx.s
	ball(ctx, 1.6 * s, Vector3.new(0, m.top - 0.25 * s, 0.3 * s), ctx.accent)
	upCyl(ctx, 0.6 * s, 0.25 * s, Vector3.new(0, m.top + 0.4 * s, 0.3 * s), ctx.color)
end

function Accessories.SquirrelTail(ctx, m)
	local s = ctx.s
	ball(ctx, 2.4 * s, Vector3.new(0, -0.6 * s, m.back + 0.8 * s), ctx.accent)
	ball(ctx, 2.6 * s, Vector3.new(0, 1.3 * s, m.back + 1.3 * s), ctx.accent)
	ball(ctx, 2 * s, Vector3.new(0, 2.9 * s, m.back + 0.9 * s), ctx.accent)
end

----------------------------------------------------------------------
-- VARIANTES (Doré, Arc-en-ciel)
----------------------------------------------------------------------
local RAINBOW = {
	Color3.fromRGB(255, 80, 80),
	Color3.fromRGB(255, 170, 40),
	Color3.fromRGB(255, 240, 70),
	Color3.fromRGB(90, 230, 100),
	Color3.fromRGB(70, 180, 255),
	Color3.fromRGB(170, 100, 255),
}

-- Les petits détails sombres (yeux, bouche) gardent leur couleur
local function isFaceDetail(part: BasePart): boolean
	local c = part.Color
	return c.R + c.G + c.B < 0.45
end

local function applyMutation(ctx, m, mutation: string)
	local model = ctx.model
	local index = 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" and d.Transparency < 1 and not isFaceDetail(d) then
			index += 1
			if mutation == "Gold" then
				d.Color = d.Color:Lerp(GOLD, 0.75)
				d.Reflectance = 0.3
			elseif mutation == "Rainbow" then
				d.Color = RAINBOW[(index - 1) % #RAINBOW + 1]
				d.Material = Enum.Material.Neon
			end
		end
	end
	-- Arc-en-ciel : un petit arc de 6 boules colorées au-dessus de la tête
	if mutation == "Rainbow" then
		local s = ctx.s
		for i, color in RAINBOW do
			local angle = math.rad(180 * (i - 1) / (#RAINBOW - 1))
			local pos = Vector3.new(math.cos(angle) * 2.2 * s, m.top + 0.9 * s + math.sin(angle) * 1.4 * s, 0)
			ball(ctx, 0.75 * s, pos, color, { Material = Enum.Material.Neon })
		end
	end
	local root = model.PrimaryPart :: BasePart
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Name = "MutationSparkles"
	sparkle.LightEmission = 1
	sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	sparkle.Speed = NumberRange.new(1, 3)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Lifetime = NumberRange.new(0.8, 1.4)
	if mutation == "Gold" then
		sparkle.Color = ColorSequence.new(GOLD, WHITE)
		sparkle.Rate = 6
	else
		sparkle.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, RAINBOW[1]),
			ColorSequenceKeypoint.new(0.5, RAINBOW[4]),
			ColorSequenceKeypoint.new(1, RAINBOW[6]),
		})
		sparkle.Rate = 12
	end
	sparkle.Parent = root
end

----------------------------------------------------------------------
-- CONSTRUCTION
----------------------------------------------------------------------

-- Renvoie les mesures d'un fantôme (taille, échelle) sans le construire
function GhostFactory.scaleOf(ghostId: string): number
	local ghost = GhostData.get(ghostId)
	if not ghost then
		return 1
	end
	return ghost.Look.Scale or Rarities.Info[ghost.Rarity].Scale
end

-- Modèle fait à la main dans Studio : ReplicatedStorage > GhostModels > <Id>
function GhostFactory.customSource(ghostId: string): Model?
	local shared = script.Parent
	local container = shared and shared.Parent
	local folder = container and container:FindFirstChild("GhostModels")
	local source = folder and folder:FindFirstChild(ghostId)
	if source and source:IsA("Model") then
		return source
	end
	return nil
end

-- Prépare une copie du modèle Studio : centrée, à la bonne taille, sans collision.
-- Renvoie le modèle et ses mesures (comme un corps fabriqué).
local function fromCustom(ctx, source: Model)
	local model = source:Clone()
	model.Name = ctx.model.Name
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.CastShadow = false
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
	-- même hauteur que les autres fantômes de la rareté (ou l'attribut "Height")
	local _, size = model:GetBoundingBox()
	local height = source:GetAttribute("Height") or 5.2 * ctx.s
	if size.Y > 0 then
		model:ScaleTo(model:GetScale() * height / size.Y)
	end
	local boxCf, box = model:GetBoundingBox()
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Transparency = 1
	root.Size = Vector3.one
	-- attribut "Turn" (en degrés) si le fantôme regarde dans la mauvaise direction
	local turn = tonumber(source:GetAttribute("Turn")) or 0
	root.CFrame = CFrame.new(boxCf.Position) * model:GetPivot().Rotation * CFrame.Angles(0, math.rad(turn), 0)
	root.Parent = model
	model.PrimaryPart = root
	model:PivotTo(CFrame.identity)
	ctx.model:Destroy()
	ctx.model = model
	return {
		top = box.Y / 2,
		bottom = -box.Y / 2,
		faceY = 0,
		faceX = 0,
		halfWidth = box.X / 2,
		back = box.Z / 2,
		front = -box.Z / 2,
	}
end

-- ghostKey = "DrapMou" ou "DrapMou#Gold" (avec variante)
function GhostFactory.build(ghostKey: string): Model
	local ghost = GhostData.get(ghostKey) or GhostData.get("DrapMou")
	local _, mutation = GhostData.split(ghostKey)
	if mutation and not GhostData.Mutations[mutation] then
		mutation = nil
	end
	local look = ghost.Look
	local rarityInfo = Rarities.Info[ghost.Rarity]

	local model = Instance.new("Model")
	model.Name = "Ghost_" .. ghost.Id

	local ctx = {
		model = model,
		look = look,
		s = look.Scale or rarityInfo.Scale,
		f = 1,
		color = rgb(look.Color, WHITE),
		accent = rgb(look.Accent, GOLD),
		material = if look.Material then Enum.Material[look.Material] else Enum.Material.SmoothPlastic,
		transparency = look.Transparency,
		reflectance = look.Reflectance,
	}

	local m
	local custom = GhostFactory.customSource(ghost.Id)
	if custom then
		m = fromCustom(ctx, custom)
		model = ctx.model
	else
		-- La "racine" invisible : c'est elle qu'on déplace
		local root = newPart(ctx, "Block", Vector3.one, CFrame.identity, WHITE, { Transparency = 1, Name = "Root" })
		model.PrimaryPart = root

		local bodyBuilder = Bodies[look.Body] or Bodies.Sheet
		m = bodyBuilder(ctx)
		ctx.f = ctx.s * (look.FaceScale or m.faceScale or 1)

		local faceBuilder = Faces[look.Face] or Faces.Happy
		faceBuilder(ctx, m)

		for _, accessoryName in look.Accessories or {} do
			local builder = Accessories[accessoryName]
			if builder then
				builder(ctx, m)
			else
				warn("[GhostFactory] Accessoire inconnu : " .. tostring(accessoryName))
			end
		end
	end
	local root = model.PrimaryPart :: BasePart

	-- Effets selon la rareté : lumière dès Légendaire, étincelles dès Mythique
	local rank = rarityInfo.Rank
	local rarityColor = Rarities.color(ghost.Rarity)
	if rank >= 4 then
		local light = Instance.new("PointLight")
		light.Color = rarityColor
		light.Range = 8 + rank
		light.Brightness = 1
		light.Shadows = false
		light.Parent = root
	end
	if rank >= 5 then
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Name = "RaritySparkles"
		sparkles.Color = ColorSequence.new(rarityColor, WHITE)
		sparkles.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.4),
			NumberSequenceKeypoint.new(1, 0),
		})
		sparkles.Speed = NumberRange.new(1, 3)
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.Rate = 6
		sparkles.Lifetime = NumberRange.new(1, 1.6)
		sparkles.LightEmission = 1
		sparkles.Parent = root
	end

	if mutation then
		applyMutation(ctx, m, mutation)
	end

	model:SetAttribute("GhostId", GhostData.key(ghost.Id, mutation))
	model:SetAttribute("Top", m.top)
	model:SetAttribute("Bottom", -m.bottom)
	model:SetAttribute("Spin", look.Spin or 1)
	return model
end

return GhostFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Missions</string>
          <string name="Source"><![CDATA[--[[
	Missions : les missions du jour (partagé entre le serveur et les joueurs).
	Chaque jour, chaque joueur reçoit 3 missions : une facile, une moyenne, une difficile.
	Les missions changent à minuit UTC. Récompense en pièces (calculée selon le revenu
	du joueur au moment où il réussit), et un bonus quand les 3 sont faites.
]]

local Missions = {}

Missions.Tiers = { "easy", "medium", "hard" }

-- Les missions possibles pour chaque difficulté
Missions.Pool = {
	easy = { "Buy", "Earn", "Lock" },
	medium = { "Sell", "BuyRare", "NightOutside" },
	hard = { "Steal", "Bonk", "BuyEpic" },
}

-- Target = objectif (Earn est calculé selon le revenu), Icon = emoji affiché
Missions.Defs = {
	Buy = { Target = 3, Icon = "🛒" },
	Earn = { Icon = "🪙" },
	Lock = { Target = 1, Icon = "🔒" },
	Sell = { Target = 2, Icon = "💰" },
	BuyRare = { Target = 1, Icon = "💎", MinRarity = "Rare" },
	NightOutside = { Target = 30, Icon = "🌙" },
	Steal = { Target = 1, Icon = "🦹" },
	Bonk = { Target = 1, Icon = "🔨" },
	BuyEpic = { Target = 1, Icon = "✨", MinRarity = "Epic" },
}

-- Récompense = X minutes de revenus, avec un minimum
Missions.Rewards = {
	easy = { Minutes = 3, Min = 300 },
	medium = { Minutes = 5, Min = 600 },
	hard = { Minutes = 8, Min = 1200 },
	bonus = { Minutes = 10, Min = 2000 },
}

function Missions.reward(tier: string, incomePerSecond: number): number
	local r = Missions.Rewards[tier] or Missions.Rewards.easy
	return math.max(r.Min, math.floor(incomePerSecond * 60 * r.Minutes))
end

-- Objectif de la mission "Gagne X pièces" : environ 10 minutes de revenus
function Missions.earnTarget(incomePerSecond: number): number
	return math.max(500, math.floor(incomePerSecond * 600))
end

function Missions.today(t: number): number
	return t // 86400
end

-- Tire les 3 missions d'un joueur pour un jour donné (toujours les mêmes pour ce jour)
function Missions.generate(day: number, userId: number, incomePerSecond: number)
	local seed = (day * 7919 + math.abs(userId)) % 2147483647
	local function nextRandom(): number
		seed = (seed * 1103515245 + 12345) % 2147483648
		return seed / 2147483648
	end
	local list = {}
	for _, tier in Missions.Tiers do
		local pool = Missions.Pool[tier]
		local id = pool[math.floor(nextRandom() * #pool) + 1]
		local target = Missions.Defs[id].Target or Missions.earnTarget(incomePerSecond)
		table.insert(list, { Id = id, Tier = tier, Target = target, Progress = 0, Done = false })
	end
	return list
end

return Missions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Monsters</string>
          <string name="Source"><![CDATA[--[[
	Monsters : les monstres (partagé entre le serveur et les joueurs).
	  - Gloutrouille sort pendant la Nuit Hantée
	  - les joueurs peuvent aussi lâcher un monstre avec des Robux (Developer Product)

	Un monstre lâché avec des Robux :
	  - poursuit les joueurs qui sont HORS de leur base (il n'entre jamais dans les bases)
	  - ne touche pas celui qui l'a lâché
	  - attrapé : retour à la base et on lâche le fantôme volé, mais on ne perd PAS de pièces
	  - un seul à la fois par serveur : les suivants attendent leur tour

	Speed = vitesse, CatchRange = distance pour attraper, Duration = durée en secondes,
	Hover = hauteur au-dessus du sol. L'avant du modèle est en -Z.
]]

local Monsters = {}

Monsters.List = {
	{
		Id = "Gloutrouille",
		Icon = "🎃",
		Name = { fr = "Gloutrouille", en = "Gloutrouille" },
		Desc = { fr = "La citrouille en gelée qui a toujours faim.", en = "The jelly pumpkin who is always hungry." },
		Product = "MonsterGloutrouille",
		Speed = 15,
		CatchRange = 5,
		Duration = 40,
		Hover = 5,
		Color = { 255, 125, 25 },
	},
	{
		Id = "MamieToile",
		Icon = "🕷️",
		Name = { fr = "Mamie Toile", en = "Granny Web" },
		Desc = { fr = "Une araignée géante à lunettes. Elle lance sa toile de loin.", en = "A giant spider with glasses. She throws her web from far away." },
		Product = "MonsterSpider",
		Speed = 12,
		CatchRange = 9,
		Duration = 45,
		Hover = 4,
		Color = { 170, 90, 255 },
	},
	{
		Id = "ChauveSourisTurbo",
		Icon = "🦇",
		Name = { fr = "Chauve-Souris Turbo", en = "Turbo Bat" },
		Desc = { fr = "Petite, mais beaucoup trop rapide.", en = "Small, but way too fast." },
		Product = "MonsterBat",
		Speed = 20,
		CatchRange = 4,
		Duration = 30,
		Hover = 7,
		Color = { 90, 200, 255 },
	},
}

Monsters.ById = {}
for order, monster in Monsters.List do
	monster.Order = order
	Monsters.ById[monster.Id] = monster
end

function Monsters.get(id: any)
	return if type(id) == "string" then Monsters.ById[id] else nil
end

---------------------------------------------------------------- Modèles 3D

local function part(model: Model, shape: Enum.PartType?, size: Vector3, cf: CFrame, color: Color3, extra: { [string]: any }?)
	local p = Instance.new("Part")
	if shape then
		p.Shape = shape
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	if extra then
		local writable: any = p
		for key, value in extra do
			writable[key] = value
		end
	end
	p.Parent = model
	return p
end

local BALL = Enum.PartType.Ball
local CYL = Enum.PartType.Cylinder
local WHITE = Color3.fromRGB(255, 255, 255)
local BLACK = Color3.fromRGB(25, 20, 30)

-- Un gros œil brillant avec pupille et reflet (regarde vers -Z)
local function eye(model: Model, pos: Vector3, d: number, iris: Color3?)
	part(model, BALL, Vector3.one * d, CFrame.new(pos), WHITE)
	local pupil = d * 0.55
	local pupilPos = pos + Vector3.new(0, -0.05 * d, -d * 0.32)
	part(model, BALL, Vector3.one * pupil, CFrame.new(pupilPos), iris or BLACK)
	part(model, BALL, Vector3.one * pupil * 0.35, CFrame.new(pupilPos + Vector3.new(0.12 * d, 0.12 * d, -pupil * 0.4)), WHITE)
end

local Builders = {}

-- Gloutrouille : une citrouille en gelée avec des dents en bonbons
function Builders.Gloutrouille(model: Model)
	local orange = Color3.fromRGB(255, 125, 25)
	local darker = orange:Lerp(Color3.new(0, 0, 0), 0.15)
	part(model, BALL, Vector3.one * 9, CFrame.identity, orange)
	-- côtes de citrouille
	for _, x in { -2.8, 2.8 } do
		part(model, BALL, Vector3.new(7.2, 8.6, 7.2), CFrame.new(x, 0, 0.5), darker)
	end
	part(model, BALL, Vector3.one * 10.3, CFrame.identity, Color3.fromRGB(170, 80, 255), {
		Transparency = 0.7,
		Material = Enum.Material.Glass,
	})
	-- yeux qui brillent, sourcils froncés
	local glow = Color3.fromRGB(190, 255, 80)
	for _, x in { -1.8, 1.8 } do
		part(model, nil, Vector3.new(1.7, 1.7, 0.6), CFrame.new(x, 1.4, -4.2) * CFrame.Angles(0, 0, math.rad(45)), glow, {
			Material = Enum.Material.Neon,
		})
		part(model, nil, Vector3.new(2, 0.4, 0.5), CFrame.new(x, 2.6, -4.05) * CFrame.Angles(0, 0, math.rad(x > 0 and 20 or -20)), BLACK)
	end
	-- grande bouche + dents en bonbons + langue
	part(model, nil, Vector3.new(5.6, 1.9, 0.6), CFrame.new(0, -1.4, -4.05), Color3.fromRGB(40, 10, 45))
	part(model, BALL, Vector3.new(2.2, 0.8, 1), CFrame.new(0.6, -2, -4.1), Color3.fromRGB(255, 90, 130))
	local candy = { Color3.fromRGB(255, 255, 240), Color3.fromRGB(255, 210, 60), Color3.fromRGB(255, 130, 30) }
	for i = 0, 4 do
		part(model, nil, Vector3.new(0.75, 0.85, 0.5), CFrame.new(-2.1 + i * 1.05, -0.75, -4.35), candy[i % 3 + 1])
	end
	-- tige, feuille et petits bras
	part(model, CYL, Vector3.new(2, 1, 1), CFrame.new(0, 5.2, 0) * CFrame.Angles(0, 0, math.rad(80)), Color3.fromRGB(70, 140, 40))
	part(model, BALL, Vector3.new(2.2, 0.4, 1.4), CFrame.new(1, 5.2, 0) * CFrame.Angles(0, 0, math.rad(-25)), Color3.fromRGB(90, 180, 60))
	for _, x in { -5, 5 } do
		part(model, BALL, Vector3.one * 2.4, CFrame.new(x, -1.5, -1), orange, { Name = "Arm" })
	end
end

-- Mamie Toile : une araignée violette avec un chignon blanc, de grands yeux et 8 pattes
function Builders.MamieToile(model: Model)
	local purple = Color3.fromRGB(120, 60, 170)
	local dark = Color3.fromRGB(70, 35, 100)
	part(model, BALL, Vector3.new(7, 6, 8), CFrame.new(0, 0.6, 2.6), dark) -- abdomen
	part(model, BALL, Vector3.one * 5.2, CFrame.new(0, 0.4, -1.6), purple) -- tête
	-- motif sur le dos
	part(model, BALL, Vector3.new(2.4, 1, 2.4), CFrame.new(0, 3.4, 2.8), Color3.fromRGB(255, 120, 200))
	-- chignon blanc de mamie
	part(model, BALL, Vector3.new(2.8, 1.8, 2.6), CFrame.new(0, 2.9, -1.2), Color3.fromRGB(245, 245, 250))
	part(model, BALL, Vector3.one * 1.5, CFrame.new(0, 3.8, -1.1), Color3.fromRGB(245, 245, 250))
	-- deux grands yeux de dessin animé
	for _, x in { -1.15, 1.15 } do
		eye(model, Vector3.new(x, 1, -3.6), 1.9, Color3.fromRGB(120, 70, 30))
	end
	-- petits yeux en plus (c'est une araignée !)
	for _, x in { -0.5, 0.5 } do
		part(model, BALL, Vector3.one * 0.5, CFrame.new(x, 2.1, -3.7), BLACK)
	end
	-- sourire avec deux dents de lapin
	part(model, nil, Vector3.new(1.6, 0.25, 0.3), CFrame.new(0, -0.6, -4.1), BLACK)
	for _, x in { -0.2, 0.2 } do
		part(model, nil, Vector3.new(0.36, 0.5, 0.25), CFrame.new(x, -0.9, -4.1), WHITE)
	end
	-- 8 pattes (4 de chaque côté)
	for side = -1, 1, 2 do
		for i = 0, 3 do
			local z = -1.8 + i * 1.6
			local upper = part(model, CYL, Vector3.new(4, 0.6, 0.6), CFrame.new(side * 3.6, 1.6, z) * CFrame.Angles(0, 0, math.rad(side * 30)), purple, { Name = "Leg" })
			upper:SetAttribute("Side", side)
			part(model, CYL, Vector3.new(4.4, 0.5, 0.5), CFrame.new(side * 6.4, -0.8, z) * CFrame.Angles(0, 0, math.rad(side * -60)), dark, { Name = "Leg" })
		end
	end
	-- un fil de toile au-dessus
	part(model, CYL, Vector3.new(14, 0.08, 0.08), CFrame.new(0, 9, 2.6) * CFrame.Angles(0, 0, math.rad(90)), WHITE, { Transparency = 0.3 })
end

-- Chauve-Souris Turbo : une petite boule bleue avec de grandes ailes et des lunettes d'aviateur
function Builders.ChauveSourisTurbo(model: Model)
	local blue = Color3.fromRGB(70, 90, 160)
	local wing = Color3.fromRGB(45, 55, 110)
	part(model, BALL, Vector3.one * 4.2, CFrame.identity, blue)
	part(model, BALL, Vector3.new(3, 2.2, 1), CFrame.new(0, -0.6, -1.8), Color3.fromRGB(140, 160, 230)) -- ventre
	-- oreilles pointues
	for _, x in { -1.1, 1.1 } do
		local ear = CFrame.new(x, 2.3, 0) * CFrame.Angles(0, 0, math.rad(x > 0 and -15 or 15))
		part(model, nil, Vector3.new(0.9, 1.8, 0.5), ear, blue)
		part(model, nil, Vector3.new(0.5, 1.2, 0.2), ear * CFrame.new(0, -0.1, -0.2), Color3.fromRGB(255, 140, 190))
	end
	-- lunettes d'aviateur
	part(model, nil, Vector3.new(4.4, 0.35, 0.35), CFrame.new(0, 0.7, -1.2), Color3.fromRGB(120, 70, 30))
	for _, x in { -0.85, 0.85 } do
		part(model, CYL, Vector3.new(0.3, 1.4, 1.4), CFrame.new(x, 0.7, -1.95) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(150, 230, 255), {
			Transparency = 0.25,
			Reflectance = 0.4,
		})
		part(model, BALL, Vector3.one * 0.55, CFrame.new(x, 0.65, -2.05), BLACK)
	end
	-- petits crocs
	for _, x in { -0.35, 0.35 } do
		part(model, nil, Vector3.new(0.25, 0.45, 0.25), CFrame.new(x, -0.55, -2.05), WHITE)
	end
	-- grandes ailes en trois morceaux
	for side = -1, 1, 2 do
		for i = 1, 3 do
			local wingPart = part(model, nil, Vector3.new(2.4, 0.25, 2.2 - i * 0.3), CFrame.new(side * (1.6 + i * 1.9), 0.4 + i * 0.15, 0.3) * CFrame.Angles(0, 0, math.rad(side * (8 + i * 6))), wing, { Name = "Wing" })
			wingPart:SetAttribute("Side", side)
		end
	end
	-- une traînée de vitesse
	part(model, nil, Vector3.new(0.3, 0.3, 4), CFrame.new(0, 0, 3.6), Color3.fromRGB(150, 220, 255), { Material = Enum.Material.Neon, Transparency = 0.4 })
end

-- Fabrique le modèle d'un monstre (avec son nom au-dessus)
function Monsters.build(id: string): Model
	local monster = Monsters.ById[id] or Monsters.ById.Gloutrouille
	local model = Instance.new("Model")
	model.Name = monster.Id
	local root = part(model, nil, Vector3.one, CFrame.identity, WHITE, { Transparency = 1, Name = "Root" })
	model.PrimaryPart = root
	local builder = Builders[monster.Id] or Builders.Gloutrouille
	builder(model)

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(monster.Color[1], monster.Color[2], monster.Color[3])
	light.Range = 22
	light.Brightness = 2
	light.Shadows = false
	light.Parent = root
	return model
end

return Monsters
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Rarities</string>
          <string name="Source"><![CDATA[--[[
	Rarities : les 6 raretés, leurs couleurs et leurs chances d'apparition.
	DayWeight / NightWeight = "poids" : plus le nombre est grand, plus c'est fréquent.
]]

local Rarities = {}

Rarities.Order = { "Common", "Rare", "Epic", "Legendary", "Mythic", "Halloween" }

Rarities.Info = {
	Common = { Rank = 1, Color = { 190, 196, 210 }, Scale = 0.85, DayWeight = 55, NightWeight = 38 },
	Rare = { Rank = 2, Color = { 70, 160, 255 }, Scale = 1.0, DayWeight = 30, NightWeight = 30 },
	Epic = { Rank = 3, Color = { 175, 90, 255 }, Scale = 1.15, DayWeight = 11, NightWeight = 16 },
	Legendary = { Rank = 4, Color = { 255, 190, 40 }, Scale = 1.3, DayWeight = 3.6, NightWeight = 8 },
	Mythic = { Rank = 5, Color = { 255, 60, 130 }, Scale = 1.6, DayWeight = 0.4, NightWeight = 4 },
	-- Halloween : seulement la nuit, et seulement pendant l'événement
	Halloween = { Rank = 6, Color = { 255, 125, 20 }, Scale = 1.4, DayWeight = 0, NightWeight = 4, EventOnly = true },
}

function Rarities.rank(rarity: string): number
	local info = Rarities.Info[rarity]
	return info and info.Rank or 0
end

function Rarities.color(rarity: string): Color3
	local c = Rarities.Info[rarity].Color
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- Tire une rareté au hasard. roll = nombre entre 0 et 1.
function Rarities.roll(roll: number, isNight: boolean, eventActive: boolean): string
	local total = 0
	local weights = {}
	for _, name in Rarities.Order do
		local info = Rarities.Info[name]
		local w = if isNight then info.NightWeight else info.DayWeight
		if info.EventOnly and not eventActive then
			w = 0
		end
		weights[name] = w
		total += w
	end
	local target = roll * total
	local acc = 0
	for _, name in Rarities.Order do
		acc += weights[name]
		if target < acc then
			return name
		end
	end
	return "Common"
end

return Rarities
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes : la liste des "messages" entre les joueurs (client) et le serveur.
	Règle d'or : le client DEMANDE, le serveur VÉRIFIE et DÉCIDE.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.Names = {
	-- Client -> Serveur (des demandes, toujours vérifiées)
	"BuyGhost", -- (uid) acheter un fantôme du chemin
	"SellGhost", -- (slot) revendre un fantôme de sa base
	"StealBegin", -- (baseIndex, slot) début du maintien sur "Voler"
	"Steal", -- (baseIndex, slot) fin du maintien sur "Voler"
	"Bonk", -- (weaponId) coup d'arme (Batte par défaut)
	"RequestLock", -- () verrouiller sa base
	"ClaimDaily", -- () récupérer le cadeau du jour
	"Rebirth", -- () faire un rebirth
	"TutorialDone", -- () le tutoriel est terminé
	"RedeemCode", -- (code) utiliser un code promo
	"BuyFloor", -- () acheter l'étage 2 de sa base
	"SpinWheel", -- () utiliser un tour de Roue de la Fortune
	"ShopBuy", -- (key) acheter un article de la boutique (le serveur ouvre la fenêtre Robux)
	-- Serveur -> Client
	"Notify", -- (key, params, kind) petit message pour un joueur
	"Announce", -- (key, params, kind) grande annonce pour tout le serveur
	"Effect", -- (kind, data) effet visuel / sonore
	"DailyInfo", -- (info) état du cadeau du jour
	"IndexInfo", -- (info) fantômes découverts dans le Fantômédex
	"MissionsInfo", -- (info) missions du jour et progrès
}

local FOLDER_NAME = "Remotes"

-- Appelé UNE fois par le serveur au démarrage
function Remotes.setup()
	assert(RunService:IsServer(), "Remotes.setup() est réservé au serveur")
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	for _, name in Remotes.Names do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

-- Récupère un RemoteEvent par son nom (attend qu'il existe côté client)
function Remotes.get(name: string): RemoteEvent
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	return folder:WaitForChild(name) :: RemoteEvent
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[--[[
	Shop : tout ce qui s'achète avec des Robux (partagé serveur + joueurs).

	Pass = Game Pass (acheté une fois, gardé pour toujours) : son ID va dans Config.GamePasses
	Product = Developer Product (peut s'acheter plusieurs fois) : son ID va dans Config.Products
	Robux = prix conseillé, à reprendre quand tu crées l'article sur le Creator Hub.

	Tant qu'un ID vaut 0 :
	  - dans Studio, le bouton d'achat donne l'article gratuitement (pour tester)
	  - dans le vrai jeu, l'article affiche "Bientôt"
]]

local Shop = {}

Shop.Categories = {
	{ Id = "Passes", Icon = "⭐", Name = { fr = "Passes", en = "Passes" } },
	{ Id = "Weapons", Icon = "⚔️", Name = { fr = "Armes", en = "Weapons" } },
	{ Id = "Wheel", Icon = "🎡", Name = { fr = "Roue", en = "Wheel" } },
	{ Id = "Monsters", Icon = "👹", Name = { fr = "Monstres", en = "Monsters" } },
	{ Id = "Coins", Icon = "🪙", Name = { fr = "Pièces", en = "Coins" } },
}

Shop.Items = {
	-- Passes
	{
		Key = "DoubleCoins",
		Kind = "Pass",
		Category = "Passes",
		Icon = "💰",
		Robux = 149,
		Attribute = "DoubleCoins",
		Name = { fr = "x2 Pièces", en = "x2 Coins" },
		Desc = { fr = "Double tous tes revenus, pour toujours", en = "Double all your income, forever" },
	},
	-- Armes (les infos viennent de Weapons.luau)
	{ Key = "WeaponHammer", Kind = "Pass", Category = "Weapons", Weapon = "MarteauPouet", Robux = 99, Attribute = "Weapon_MarteauPouet" },
	{ Key = "WeaponBroom", Kind = "Pass", Category = "Weapons", Weapon = "BalaiSorciere", Robux = 149, Attribute = "Weapon_BalaiSorciere" },
	{ Key = "WeaponVacuum", Kind = "Pass", Category = "Weapons", Weapon = "AspiraFantome", Robux = 199, Attribute = "Weapon_AspiraFantome" },
	-- Tours de roue (objets aléatoires payants : chances affichées avant l'achat)
	{
		Key = "Spin1",
		Kind = "Product",
		Category = "Wheel",
		Icon = "🎡",
		Robux = 25,
		Spins = 1,
		Random = true,
		Name = { fr = "1 tour de roue", en = "1 wheel spin" },
		Desc = { fr = "Chaque case fait gagner quelque chose", en = "Every slot wins something" },
	},
	{
		Key = "Spin5",
		Kind = "Product",
		Category = "Wheel",
		Icon = "🎡",
		Robux = 99,
		Spins = 5,
		Random = true,
		Name = { fr = "5 tours de roue", en = "5 wheel spins" },
		Desc = { fr = "1 tour offert par rapport à 5 x 1", en = "1 free spin compared to 5 x 1" },
	},
	-- Monstres (les infos viennent de Monsters.luau)
	{ Key = "MonsterGloutrouille", Kind = "Product", Category = "Monsters", Monster = "Gloutrouille", Robux = 39 },
	{ Key = "MonsterBat", Kind = "Product", Category = "Monsters", Monster = "ChauveSourisTurbo", Robux = 59 },
	{ Key = "MonsterSpider", Kind = "Product", Category = "Monsters", Monster = "MamieToile", Robux = 79 },
	-- Pièces
	{
		Key = "CoinPack",
		Kind = "Product",
		Category = "Coins",
		Icon = "🪙",
		Robux = 25,
		Name = { fr = "Pack de pièces", en = "Coin pack" },
		Desc = { fr = "{coins} pièces tout de suite", en = "{coins} coins right now" },
	},
}

Shop.ByKey = {}
for order, item in Shop.Items do
	item.Order = order
	Shop.ByKey[item.Key] = item
end

function Shop.get(key: any)
	return if type(key) == "string" then Shop.ByKey[key] else nil
end

-- L'ID Roblox de l'article (0 = pas encore créé)
function Shop.idOf(item, config): number
	local list = if item.Kind == "Pass" then config.GamePasses else config.Products
	return tonumber(list[item.Key]) or 0
end

-- Retrouve l'article à partir d'un ID Roblox
function Shop.fromId(kind: string, id: number, config)
	if id == 0 then
		return nil
	end
	for _, item in Shop.Items do
		if item.Kind == kind and Shop.idOf(item, config) == id then
			return item
		end
	end
	return nil
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Sounds</string>
          <string name="Source"><![CDATA[--[[
	Sounds : tous les sons du jeu au même endroit.

	Par défaut on utilise des sons intégrés à Roblox ("rbxasset://...") : gratuits et
	toujours disponibles. Pour mettre un son du Creator Store à la place :
	  1. Dans Studio : onglet Accueil > Boîte à outils (Toolbox) > catégorie Audio
	  2. Choisis un son gratuit, clic droit > "Copier l'ID de l'élément" (Copy Asset ID)
	  3. Remplace l'Id ci-dessous par "rbxassetid://" suivi du numéro, ex. "rbxassetid://1234567"
	Laisse "" pour désactiver un son.

	Pitch = hauteur (1 = normal, 2 = plus aigu, 0.5 = plus grave)
	Jingle = liste de hauteurs jouées l'une après l'autre (petite fanfare)
]]

local PING = "rbxasset://sounds/electronicpingshort.wav"
local SWOOSH = "rbxasset://sounds/swoosh.wav"
local OOF = "rbxasset://sounds/uuhhh.mp3"
local JUMP = "rbxasset://sounds/action_jump.mp3"

local Sounds = {
	Click = { Id = PING, Volume = 0.25, Pitch = 2.2 },
	Buy = { Id = PING, Volume = 0.6, Jingle = { 1.2, 1.6 } },
	Sell = { Id = PING, Volume = 0.5, Jingle = { 1.6, 1.2 } },
	Gift = { Id = PING, Volume = 0.6, Jingle = { 1, 1.26, 1.5, 2 } },
	Error = { Id = PING, Volume = 0.4, Pitch = 0.55 },
	StealStart = { Id = SWOOSH, Volume = 0.8, Pitch = 1.2 },
	StealAlert = { Id = PING, Volume = 0.7, Jingle = { 2, 1.5, 2, 1.5 } },
	StealSuccess = { Id = PING, Volume = 0.8, Jingle = { 1, 1.26, 1.5, 2, 1.5, 2 } },
	StealFail = { Id = OOF, Volume = 0.7, Pitch = 1.1 },
	Bonk = { Id = JUMP, Volume = 1, Pitch = 2.4 },
	Lock = { Id = PING, Volume = 0.6, Jingle = { 0.8, 0.6 } },
	Mythic = { Id = PING, Volume = 0.9, Jingle = { 1.5, 2, 2.5, 3, 2.5, 3 } },
	NightStart = { Id = SWOOSH, Volume = 1, Pitch = 0.4 },
	NightEnd = { Id = PING, Volume = 0.5, Jingle = { 1, 1.5, 2 } },
	MonsterCatch = { Id = OOF, Volume = 1, Pitch = 0.6 },
	Heartbeat = { Id = PING, Volume = 0.5, Jingle = { 0.35, 0.3 } },
	Rebirth = { Id = PING, Volume = 0.9, Jingle = { 1, 1.26, 1.5, 2, 2.52, 3 } },
	Swing = { Id = SWOOSH, Volume = 0.6, Pitch = 1.7 },
	Vacuum = { Id = SWOOSH, Volume = 0.9, Pitch = 0.6 },
	WheelTick = { Id = PING, Volume = 0.2, Pitch = 2.8 },
	WheelWin = { Id = PING, Volume = 0.8, Jingle = { 1, 1.5, 2, 1.5, 2, 2.5 } },
	MonsterSummon = { Id = SWOOSH, Volume = 1, Pitch = 0.3 },
	-- Musique de fond pendant la Nuit Hantée (aucune par défaut).
	-- Mets ici l'ID d'une musique gratuite du Creator Store (catégorie Audio > Music).
	NightMusic = { Id = "", Volume = 0.4, Looped = true },
	DayMusic = { Id = "", Volume = 0.25, Looped = true },
}

return Sounds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Strings</string>
          <string name="Source"><![CDATA[--[[
