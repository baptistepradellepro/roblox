	-- Codes promo
	Codes = "Codes secrets",
	CodesDesc = "Tape un code secret",
	CodePlaceholder = "CODE",
	CodeRedeem = "OK",
	CodeOk = "Code accepté : +{coins} pièces !",
	CodeOkGhost = "Code accepté : {ghost} est à toi !",
