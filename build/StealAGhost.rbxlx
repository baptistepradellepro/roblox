-- Remplace {mots} dans un texte par les valeurs données
function Strings.fill(text: string, params: { [string]: any }?): string
	if not params then
		return text
	end
	return (string.gsub(text, "{(%w+)}", function(name)
		local value = params[name]
		if value == nil then
			return "{" .. name .. "}"
		end
		return tostring(value)
	end))
end

-- Texte traduit avec ses {mots} remplacés. Ex : format("fr", "Sold", { coins = "1.2K" })
function Strings.format(lang: string, key: string, params: { [string]: any }?): string
	local tableForLang = Strings[lang] or Strings.en
	local text = tableForLang[key] or Strings.en[key] or key
	return Strings.fill(text, params)
end

return Strings
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[--[[
	Weapons : les armes pour chasser les voleurs (partagé entre le serveur et les joueurs).
	  - la Batte est offerte à tout le monde
	  - les autres s'achètent avec un Game Pass (ID dans Config.GamePasses)

	Ce qu'une arme fait quand on frappe (le serveur vérifie tout) :
	  - un voleur qui porte un fantôme : il le lâche (le fantôme rentre chez lui),
	    il est repoussé et étourdi un moment
	  - un intrus dans TA base : il est repoussé dehors
	  - les autres joueurs : rien (pas de bagarre gratuite)
	On ne peut pas frapper en portant un fantôme volé : les armes servent à défendre.

	Range = portée en studs, Cooldown = temps entre deux coups, Stun = étourdissement,
	Knock = force du recul, Sweep = touche tous les voleurs à portée (sinon le plus proche)
	Anim = l'animation officielle de Roblox jouée au coup : "Slash" (coup classique)
	ou "Lunge" (coup vers l'avant)
	Hold = comment on tient l'arme : "Up" (dressée, comme l'épée classique de Roblox)
	ou "Forward" (pointée devant soi, comme un aspirateur)
]]

local Weapons = {}

Weapons.List = {
	{
		Id = "Batte",
		Hold = "Up",
		Anim = "Slash",
		Length = 3.2, -- longueur de l'arme (pour la traînée)
		Icon = "🏏",
		Name = { fr = "Batte", en = "Bat" },
		Desc = { fr = "Offerte. Un bon coup et le voleur lâche tout !", en = "Free. One good hit and the thief drops everything!" },
		Free = true,
		Range = 9,
		Cooldown = 1.6,
		Stun = 1.5,
		Knock = 45,
		Sound = "Bonk",
		Color = { 190, 130, 70 },
	},
	{
		Id = "MarteauPouet",
		Hold = "Up",
		Anim = "Slash",
		Length = 3.3, -- longueur de l'arme (pour la traînée)
		Icon = "🔨",
		Name = { fr = "Marteau Pouet Géant", en = "Giant Squeaky Hammer" },
		Desc = { fr = "Plus loin, plus fort, et ça fait POUET.", en = "Longer reach, stronger, and it goes SQUEAK." },
		Pass = "WeaponHammer",
		Range = 11,
		Cooldown = 1.3,
		Stun = 2.2,
		Knock = 70,
		Sound = "Bonk",
		Color = { 255, 90, 160 },
	},
	{
		Id = "BalaiSorciere",
		Hold = "Up",
		Anim = "Slash",
		Length = 4.9, -- longueur de l'arme (pour la traînée)
		Icon = "🧹",
		Name = { fr = "Balai de Sorcière", en = "Witch Broom" },
		Desc = { fr = "Un grand coup de balai : touche tous les voleurs autour.", en = "A big sweep: hits every thief around you." },
		Pass = "WeaponBroom",
		Range = 12,
		Cooldown = 1.5,
		Stun = 1.6,
		Knock = 55,
		Sweep = true,
		Sound = "Bonk",
		Color = { 170, 90, 255 },
	},
	{
		Id = "AspiraFantome",
		Hold = "Forward",
		Anim = "Lunge",
		Length = 3.5, -- longueur de l'arme (pour la traînée)
		Icon = "🌀",
		Name = { fr = "Aspira-Fantôme", en = "Ghost Vacuum" },
		Desc = { fr = "Aspire le fantôme volé de très loin.", en = "Sucks the stolen ghost back from far away." },
		Pass = "WeaponVacuum",
		Range = 20,
		Cooldown = 2.5,
		Stun = 0.8,
		Knock = 25,
		Sound = "Vacuum",
		Color = { 80, 255, 170 },
	},
}

Weapons.ById = {}
for order, weapon in Weapons.List do
	weapon.Order = order
	Weapons.ById[weapon.Id] = weapon
end

function Weapons.get(id: any)
	return if type(id) == "string" then Weapons.ById[id] else nil
end

---------------------------------------------------------------- Modèles 3D

local function newPart(tool: Instance, shape: Enum.PartType?, size: Vector3, offset: CFrame, color: Color3, handle: BasePart?, extra: { [string]: any }?)
	local p = Instance.new("Part")
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = false
	if extra then
		local writable: any = p
		for key, value in extra do
			writable[key] = value
		end
	end
	if handle then
		p.CFrame = handle.CFrame * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = p
		weld.Parent = p
	end
	p.Parent = tool
	return p
end

-- Les cylindres de Roblox sont couchés sur X : on les tourne pour suivre l'axe Z de l'arme
local ALONG_Z = CFrame.Angles(0, math.rad(90), 0)

local Builders = {}

-- L'arme est dessinée le long de l'axe Z de la poignée ("Handle"), le manche vers -Z
function Builders.Batte(tool: Tool, handle: BasePart)
	local wood = Color3.fromRGB(205, 145, 80)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(1.6, 0.42, 0.42), CFrame.new(0, 0, -1.2) * ALONG_Z, Color3.fromRGB(40, 40, 50), handle)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(1.6, 0.55, 0.55), CFrame.new(0, 0, 0.2) * ALONG_Z, wood, handle)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(2, 0.85, 0.85), CFrame.new(0, 0, 1.8) * ALONG_Z, wood, handle)
	-- le bout noir et le pommeau
	newPart(tool, Enum.PartType.Ball, Vector3.one * 0.95, CFrame.new(0, 0, 2.8), Color3.fromRGB(35, 35, 45), handle)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(0.25, 0.65, 0.65), CFrame.new(0, 0, -2.05) * ALONG_Z, Color3.fromRGB(150, 80, 40), handle)
	-- une grande bande rouge pour faire "batte de champion"
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(0.8, 0.9, 0.9), CFrame.new(0, 0, 0.9) * ALONG_Z, Color3.fromRGB(230, 50, 60), handle)
end

function Builders.MarteauPouet(tool: Tool, handle: BasePart)
	local pink = Color3.fromRGB(255, 90, 160)
	local yellow = Color3.fromRGB(255, 220, 60)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(4, 0.45, 0.45), CFrame.new(0, 0, 0) * ALONG_Z, yellow, handle)
	-- la tête du marteau, en travers
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(2.6, 1.7, 1.7), CFrame.new(0, 0, 2.4), pink, handle)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(0.3, 1.8, 1.8), CFrame.new(1.3, 0, 2.4), Color3.fromRGB(255, 255, 255), handle)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(0.3, 1.8, 1.8), CFrame.new(-1.3, 0, 2.4), Color3.fromRGB(255, 255, 255), handle)
	-- une étoile jaune sur le côté (un rond, vu de loin)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(0.12, 0.9, 0.9), CFrame.new(0, 0.86, 2.4) * CFrame.Angles(0, 0, math.rad(90)), yellow, handle)
end

function Builders.BalaiSorciere(tool: Tool, handle: BasePart)
	local wood = Color3.fromRGB(120, 75, 40)
	local straw = Color3.fromRGB(255, 190, 70)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(4.6, 0.35, 0.35), CFrame.new(0, 0, 0.3) * ALONG_Z, wood, handle)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(0.4, 0.75, 0.75), CFrame.new(0, 0, 2.4) * ALONG_Z, Color3.fromRGB(150, 70, 230), handle)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(1.6, 1.3, 1.3), CFrame.new(0, 0, 3.3) * ALONG_Z, straw, handle)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(0.9, 1.7, 1.7), CFrame.new(0, 0, 4.3) * ALONG_Z, straw, handle)
	-- petites étincelles magiques
	newPart(tool, Enum.PartType.Ball, Vector3.one * 0.35, CFrame.new(0.6, 0.5, 4.6), Color3.fromRGB(200, 140, 255), handle, { Material = Enum.Material.Neon })
end

function Builders.AspiraFantome(tool: Tool, handle: BasePart)
	local body = Color3.fromRGB(60, 70, 90)
	local neon = Color3.fromRGB(80, 255, 170)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(1.4, 0.5, 0.5), CFrame.new(0, -0.1, -0.9) * ALONG_Z, Color3.fromRGB(40, 40, 50), handle)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(2.2, 1.2, 1.2), CFrame.new(0, 0.5, 0.6) * ALONG_Z, body, handle)
	-- la grosse bouche qui aspire, avec son anneau vert lumineux
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(0.9, 1.5, 1.5), CFrame.new(0, 0.5, 2) * ALONG_Z, body, handle)
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(0.2, 1.2, 1.2), CFrame.new(0, 0.5, 2.48) * ALONG_Z, neon, handle, { Material = Enum.Material.Neon })
	newPart(tool, Enum.PartType.Cylinder, Vector3.new(0.22, 0.6, 0.6), CFrame.new(0, 0.5, 2.5) * ALONG_Z, Color3.fromRGB(230, 255, 240), handle, { Material = Enum.Material.Neon })
	-- le tuyau vert qui fait une boucle sous l'appareil
	local hose = Color3.fromRGB(60, 200, 120)
	for i = 0, 4 do
		local a = math.rad(-30 - i * 60)
		newPart(tool, Enum.PartType.Cylinder, Vector3.new(0.8, 0.35, 0.35), CFrame.new(0, -0.3 + math.sin(a) * 0.7, -0.6 + math.cos(a) * 0.7) * CFrame.Angles(a + math.pi / 2, 0, 0) * ALONG_Z, hose, handle)
	end
end

-- Fabrique l'outil (Tool) à mettre dans le sac du joueur
function Weapons.buildTool(id: string): Tool
	local weapon = Weapons.ById[id] or Weapons.ById.Batte
	local tool = Instance.new("Tool")
	tool.Name = weapon.Name.fr
	tool.ToolTip = weapon.Icon
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("WeaponId", weapon.Id)

	local handle = newPart(tool, nil, Vector3.new(0.5, 0.5, 1.2), CFrame.identity, Color3.fromRGB(40, 40, 50), nil, {
		Name = "Handle",
		Transparency = 1,
	})
	handle.CFrame = CFrame.new()
	local builder = Builders[weapon.Id] or Builders.Batte
	builder(tool, handle)
	-- traînée colorée allumée pendant les coups (voir AnimView)
	local base = Instance.new("Attachment")
	base.Name = "TrailBase"
	base.Position = Vector3.new(0, 0, 0.2)
	base.Parent = handle
	local tip = Instance.new("Attachment")
	tip.Name = "TrailTip"
	tip.Position = Vector3.new(0, 0, weapon.Length or 3)
	tip.Parent = handle
	local trail = Instance.new("Trail")
	trail.Name = "SwingTrail"
	trail.Attachment0 = base
	trail.Attachment1 = tip
	trail.Color = ColorSequence.new(Color3.fromRGB(weapon.Color[1], weapon.Color[2], weapon.Color[3]))
	trail.Transparency = NumberSequence.new(0.3, 1)
	trail.Lifetime = 0.22
	trail.LightEmission = 0.6
	trail.Enabled = false
	trail.Parent = handle
	-- La main tient le manche (vers -Z de la poignée). Dans la main d'un personnage
	-- Roblox, l'axe Z de la prise remonte vers l'épaule : on tourne l'arme pour
	-- qu'elle soit dressée (Up) ou pointée devant soi (Forward).
	if weapon.Hold == "Forward" then
		tool.Grip = CFrame.new(0, 0, -0.9) * CFrame.Angles(0, math.pi, 0)
	else
		tool.Grip = CFrame.new(0, 0, -1.2) * CFrame.Angles(math.rad(90), 0, 0)
	end
	return tool
end

return Weapons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Wheel</string>
          <string name="Source"><![CDATA[--[[
	Wheel : la Roue de la Fortune au milieu de la map (partagé serveur + joueurs).
	Les tours s'achètent avec des Robux (Developer Products "Spin1" et "Spin5").

	Règles Roblox sur les objets aléatoires payants, respectées ici :
	  - les chances de chaque case sont affichées en % AVANT l'achat, et font 100 % au total
	  - chaque case donne quelque chose (on ne perd jamais son achat)
	  - les joueurs des pays où c'est interdit ne peuvent pas acheter de tours
	    (PolicyService.ArePaidRandomItemsRestricted, vérifié par le serveur)

	Kind = "Coins" (Minutes de revenus, au moins Min pièces), "Boost" (revenus multipliés
	par Config.WheelBoostMult pendant Seconds), "Ghost" (un fantôme au hasard de cette rareté, avec Mutation possible).
	Chance = pourcentage. Si la base est pleine, un fantôme gagné est payé en pièces.
]]

local Wheel = {}

Wheel.Segments = {
	{ Id = "Coins10", Kind = "Coins", Minutes = 10, Min = 500, Chance = 30, Icon = "🪙", Color = { 255, 200, 60 } },
	{ Id = "Epic", Kind = "Ghost", Rarity = "Epic", Chance = 14, Icon = "👻", Color = { 175, 90, 255 } },
	{ Id = "Coins30", Kind = "Coins", Minutes = 30, Min = 1500, Chance = 18, Icon = "💰", Color = { 90, 210, 110 } },
	{ Id = "Legendary", Kind = "Ghost", Rarity = "Legendary", Chance = 8, Icon = "🌟", Color = { 255, 170, 30 } },
	{ Id = "Boost", Kind = "Boost", Seconds = 900, Chance = 15, Icon = "⚡", Color = { 70, 170, 255 } },
	{ Id = "GoldEpic", Kind = "Ghost", Rarity = "Epic", Mutation = "Gold", Chance = 6, Icon = "✨", Color = { 255, 225, 90 } },
	{ Id = "Coins120", Kind = "Coins", Minutes = 120, Min = 5000, Chance = 7, Icon = "🤑", Color = { 60, 200, 200 } },
	{ Id = "Mythic", Kind = "Ghost", Rarity = "Mythic", Chance = 2, Icon = "💎", Color = { 255, 60, 130 } },
}

Wheel.SpinDuration = 6 -- secondes d'animation
Wheel.Radius = 8

function Wheel.totalChance(): number
	local total = 0
	for _, segment in Wheel.Segments do
		total += segment.Chance
	end
	return total
end

-- roll = nombre entre 0 et 1 -> index de la case gagnante
function Wheel.pick(roll: number): number
	local target = roll * Wheel.totalChance()
	local acc = 0
	for index, segment in Wheel.Segments do
		acc += segment.Chance
		if target < acc then
			return index
		end
	end
	return #Wheel.Segments
end

-- Angle du centre d'une case (0 = en haut, sens inverse des aiguilles)
function Wheel.segmentAngle(index: number): number
	return (index - 1) * (2 * math.pi / #Wheel.Segments)
end

-- Pièces gagnées sur une case "Coins"
function Wheel.coins(segment, incomePerSecond: number): number
	return math.max(segment.Min or 0, math.floor(incomePerSecond * 60 * (segment.Minutes or 0)))
end

---------------------------------------------------------------- Modèle 3D

local function part(model: Model, class: string, size: Vector3, cf: CFrame, color: Color3, extra: { [string]: any }?)
	local p = Instance.new(class) :: BasePart
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	if extra then
		local writable: any = p
		for key, value in extra do
			writable[key] = value
		end
	end
	p.Parent = model
	return p
end

-- Un triangle rectangle plat (dans le plan XY de la roue), fait avec une WedgePart :
-- angle droit en m, la pointe en o, le troisième coin en q. thickness = épaisseur.
local function triangle(model: Model, o: Vector3, m: Vector3, q: Vector3, z: number, thickness: number, color: Color3)
	local height = (o - m).Magnitude
	local width = (q - m).Magnitude
	local yAxis = (o - m).Unit
	local zAxis = (m - q).Unit
	local xAxis = yAxis:Cross(zAxis)
	local center = m + yAxis * (height / 2) - zAxis * (width / 2) + Vector3.new(0, 0, z)
	local cf = CFrame.fromMatrix(center, xAxis, yAxis, zAxis)
	return part(model, "WedgePart", Vector3.new(thickness, height, width), cf, color)
end

--[[
	Construit la roue (sans le support). Le centre est en (0, 0, 0), la face avant
	regarde vers -Z, la case 1 est en haut. On la fait tourner autour de l'axe Z.
	labelMaker(segment, part) peut ajouter un texte sur chaque case.
]]
function Wheel.build(labelMaker: ((any, BasePart) -> ())?): Model
	local model = Instance.new("Model")
	model.Name = "FortuneWheel"
	local root = part(model, "Part", Vector3.one, CFrame.identity, Color3.new(1, 1, 1), { Transparency = 1, Name = "Root" })
	model.PrimaryPart = root

	local r = Wheel.Radius
	local count = #Wheel.Segments
	local half = math.pi / count
	-- le cadre en bois de la roue
	part(model, "Part", Vector3.new(0.8, r * 2 + 1.6, r * 2 + 1.6), CFrame.new(0, 0, 0.5) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(140, 85, 45), {
		Shape = Enum.PartType.Cylinder,
		Material = Enum.Material.Wood,
	})
	for index, segment in Wheel.Segments do
		local c = Wheel.segmentAngle(index)
		local color = Color3.fromRGB(segment.Color[1], segment.Color[2], segment.Color[3])
		local function at(angle: number, radius: number): Vector3
			return Vector3.new(-math.sin(angle) * radius, math.cos(angle) * radius, 0)
		end
		local mid = at(c, r * math.cos(half))
		local p0 = at(c - half, r)
		local p1 = at(c + half, r)
		triangle(model, Vector3.zero, mid, p0, -0.2, 0.3, color)
		triangle(model, Vector3.zero, mid, p1, -0.2, 0.3, color)
		-- un trait blanc entre les cases
		local edge = at(c - half, r / 2)
		part(model, "Part", Vector3.new(0.25, r, 0.35), CFrame.new(edge.X, edge.Y, -0.25) * CFrame.Angles(0, 0, c - half), Color3.fromRGB(255, 255, 255))
		-- support invisible du texte
		local labelPos = at(c, r * 0.64)
		local holder = part(model, "Part", Vector3.one * 0.2, CFrame.new(labelPos.X, labelPos.Y, -0.6), Color3.new(1, 1, 1), {
			Transparency = 1,
			Name = "Label_" .. index,
		})
		holder:SetAttribute("Segment", index)
		if labelMaker then
			labelMaker(segment, holder)
		end
	end
	-- ampoules sur le bord
	for i = 0, count * 2 - 1 do
		local a = i * half
		part(model, "Part", Vector3.one * 0.7, CFrame.new(-math.sin(a) * (r + 0.1), math.cos(a) * (r + 0.1), -0.3), Color3.fromRGB(255, 240, 150), {
			Shape = Enum.PartType.Ball,
			Material = Enum.Material.Neon,
			Name = "Bulb",
		})
	end
	-- moyeu
	part(model, "Part", Vector3.new(0.8, 2.6, 2.6), CFrame.new(0, 0, -0.5) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(255, 200, 40), {
		Shape = Enum.PartType.Cylinder,
		Reflectance = 0.2,
	})
	part(model, "Part", Vector3.one * 1.2, CFrame.new(0, 0, -0.9), Color3.fromRGB(255, 90, 160), { Shape = Enum.PartType.Ball })
	return model
end

return Wheel
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="18">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Main : le point de départ du serveur. Il démarre tous les services dans l'ordre,
	puis s'occupe de l'arrivée et du départ des joueurs.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- On fait apparaître les personnages nous-mêmes, une fois la base attribuée
Players.CharacterAutoLoads = false

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))
Remotes.setup()

local Services = script.Parent:WaitForChild("Services")
local AnnounceService = require(Services:WaitForChild("AnnounceService"))
local BaseService = require(Services:WaitForChild("BaseService"))
local CodeService = require(Services:WaitForChild("CodeService"))
local DataService = require(Services:WaitForChild("DataService"))
local EconomyService = require(Services:WaitForChild("EconomyService"))
local GhostService = require(Services:WaitForChild("GhostService"))
local Guard = require(Services:WaitForChild("Guard"))
local IndexService = require(Services:WaitForChild("IndexService"))
local LeaderboardService = require(Services:WaitForChild("LeaderboardService"))
local MapBuilder = require(Services:WaitForChild("MapBuilder"))
local MissionService = require(Services:WaitForChild("MissionService"))
local MonetizationService = require(Services:WaitForChild("MonetizationService"))
local MonsterService = require(Services:WaitForChild("MonsterService"))
local NightService = require(Services:WaitForChild("NightService"))
local RebirthService = require(Services:WaitForChild("RebirthService"))
local StealService = require(Services:WaitForChild("StealService"))
local WeaponService = require(Services:WaitForChild("WeaponService"))
local WheelService = require(Services:WaitForChild("WheelService"))

-- 1. La map
local map = MapBuilder.build()
BaseService.init(map)
WheelService.init(map)

-- 2. Les services
DataService.start()
BaseService.start()
EconomyService.start()
GhostService.start()
StealService.start()
WeaponService.start()
MonsterService.start()
NightService.start()
WheelService.start()
RebirthService.start()
MonetizationService.start()
CodeService.start()
LeaderboardService.start()
MissionService.start()
EconomyService.giveGhostCallback = GhostService.giveGhost
BaseService.onGhostPlaced = IndexService.discover -- chaque nouveau fantôme entre dans le Fantômédex

-- 3. Les joueurs
local function onPlayerAdded(player: Player)
	local profile = DataService.load(player)
	if not profile then
		return
	end
	if not player.Parent then
		DataService.release(player) -- parti pendant le chargement
		return
	end
	local data = profile.Data
	local lastOnline = data.LastOnline

	local base = BaseService.assign(player)
	if not base then
		DataService.release(player)
		player:Kick("Serveur plein, réessaie ! / Server full, try again!")
		return
	end

	MonetizationService.setup(player) -- Game Passes (x2 pièces, verrou+, armes)
	WeaponService.setup(player) -- la Batte et les armes achetées, à chaque apparition
	WheelService.setup(player) -- tours de Roue de la Fortune
	RebirthService.setup(player) -- aura des rebirths
	EconomyService.setup(player)
	IndexService.setup(player) -- collection (avant le cadeau, pour ne pas afficher 2 messages)
	MissionService.setup(player) -- missions du jour

	-- Premier lancement : un fantôme offert tout de suite
	if not data.StarterGiven then
		data.StarterGiven = true
		GhostService.giveGhost(player, Config.StarterGhost)
		AnnounceService.notify(player, "StarterGift", nil, "good")
		AnnounceService.effect("Gift", {}, player)
	end

	-- Bouclier débutant : personne ne peut voler pendant 2 minutes
	BaseService.giveShield(player, Config.NewPlayerShield)
	AnnounceService.notify(player, "ShieldOn", { time = Format.time(Config.NewPlayerShield) }, "info")

	EconomyService.grantOffline(player, lastOnline)
	EconomyService.sendDailyInfo(player)

	player:SetAttribute("TutorialDone", data.TutorialDone == true)
	player:SetAttribute("Ready", true)
	BaseService.spawnCharacter(player)
end

local function onPlayerRemoving(player: Player)
	StealService.onPlayerRemoving(player)
	WheelService.onPlayerRemoving(player) -- gain de la roue pas encore donné
	EconomyService.onPlayerRemoving(player)
	BaseService.release(player)
	Guard.clear(player)
	DataService.release(player)
end

Remotes.get("TutorialDone").OnServerEvent:Connect(function(player)
	local data = DataService.get(player)
	if data then
		data.TutorialDone = true
		player:SetAttribute("TutorialDone", true)
	end
end)

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="19">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">AnnounceService</string>
          <string name="Source"><![CDATA[--[[
	AnnounceService : envoie des messages aux joueurs.
	On envoie des CLÉS de texte (ex. "AnnSteal") et chaque joueur les traduit
	dans sa langue. Les paramètres "ghost" sont des Id de fantômes, traduits aussi.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local AnnounceService = {}

local notifyRemote = Remotes.get("Notify")
local announceRemote = Remotes.get("Announce")
local effectRemote = Remotes.get("Effect")

-- Petit message pour un seul joueur. kind = "info", "good", "bad"
function AnnounceService.notify(player: Player, key: string, params: { [string]: any }?, kind: string?)
	if player.Parent then
		notifyRemote:FireClient(player, key, params or {}, kind or "info")
	end
end

-- Grande annonce pour tout le serveur. kind = "steal", "mythic", "halloween", "rebirth", "night"...
function AnnounceService.announce(key: string, params: { [string]: any }?, kind: string?)
	announceRemote:FireAllClients(key, params or {}, kind or "info")
end

-- Effet visuel/sonore. Si player est donné, seul ce joueur le voit.
function AnnounceService.effect(kind: string, data: { [string]: any }?, player: Player?)
	if player then
		if player.Parent then
			effectRemote:FireClient(player, kind, data or {})
		end
	else
		effectRemote:FireAllClients(kind, data or {})
	end
end

return AnnounceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">BaseService</string>
          <string name="Source"><![CDATA[--[[
	BaseService : les bases des joueurs.
	  - donne une base libre à chaque joueur qui arrive
	  - gère les socles (quel fantôme est posé où) et l'étage 2 achetable
	  - l'ascenseur entre le rez-de-chaussée et l'étage
	  - gère le verrou (45 s, recharge 2 min, seulement avec le bouton au fond de la base)
	    et le bouclier débutant (45 s aussi)
	  - la barrière du verrou bloque tout le monde sauf le propriétaire (groupes de collision)
	  - fait apparaître le joueur dans sa base

	Le serveur écrit l'état dans des "attributs" (sur les modèles de base et les socles),
	et chaque joueur affiche les fantômes de son côté. Le client ne décide jamais rien.
]]

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local AnnounceService = require(script.Parent.AnnounceService)
local DataService = require(script.Parent.DataService)
local Guard = require(script.Parent.Guard)
local Hooks = require(script.Parent.Hooks)
local MapBuilder = require(script.Parent.MapBuilder)

local BaseService = {}

export type Base = {
	Index: number,
	Model: Model,
	Origin: CFrame,
	Pedestals: { [number]: BasePart },
	Spawn: SpawnLocation,
	Owner: Player?,
	LockedUntil: number,
	LockReadyAt: number,
	Barrier: Instance?,
	StolenOut: { [number]: boolean },
}

local bases: { [number]: Base } = {}
local byPlayer: { [Player]: Base } = {}

-- Ordre d'attribution : d'abord les bases du centre (plus d'action)
local ASSIGN_ORDER = { 3, 9, 4, 10, 2, 8, 5, 11, 1, 7, 6, 12 }

local PEDESTAL_COLOR = Color3.fromRGB(60, 50, 75)

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Groupes de collision : la barrière de la base N ("GateN") ne bloque pas le personnage
-- de son propriétaire ("OwnerN"), mais bloque tous les autres. C'est le serveur qui décide,
-- donc ça marche même si le joueur a un écran lent à charger.
local collisionGroupsReady = false

local function gateGroup(index: number): string
	return "Gate" .. index
end

local function ownerGroup(index: number): string
	return "Owner" .. index
end

local function setupCollisionGroups()
	local ok, err = pcall(function()
		for index in bases do
			for _, name in { gateGroup(index), ownerGroup(index) } do
				if not PhysicsService:IsCollisionGroupRegistered(name) then
					PhysicsService:RegisterCollisionGroup(name)
				end
			end
			PhysicsService:CollisionGroupSetCollidable(gateGroup(index), ownerGroup(index), false)
		end
	end)
	collisionGroupsReady = ok
	if not ok then
		warn("[BaseService] Groupes de collision indisponibles : " .. tostring(err))
	end
end

-- Range toutes les pièces du personnage dans le groupe du propriétaire de la base
local function applyOwnerGroup(player: Player, character: Model)
	local base = byPlayer[player]
	if not collisionGroupsReady or not base then
		return
	end
	local group = ownerGroup(base.Index)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
	-- les accessoires et le fantôme porté arrivent parfois après
	character.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end)
end

function BaseService.init(map: Model)
	local folder = map:WaitForChild("Bases")
	for _, model in folder:GetChildren() do
		if model:IsA("Model") then
			local index = model:GetAttribute("Index")
			local pedestals = {}
			for _, ped in model:WaitForChild("Pedestals"):GetChildren() do
				pedestals[ped:GetAttribute("Slot")] = ped
			end
			bases[index] = {
				Index = index,
				Model = model,
				Origin = model:GetAttribute("Origin") or MapBuilder.baseOrigin(index),
				Pedestals = pedestals,
				Spawn = model:WaitForChild("Spawn") :: SpawnLocation,
				Owner = nil,
				LockedUntil = 0,
				LockReadyAt = 0,
				Barrier = nil,
				StolenOut = {},
			}
		end
	end
	setupCollisionGroups()
end

function BaseService.getBase(player: Player): Base?
	return byPlayer[player]
end

function BaseService.getBaseByIndex(index: number): Base?
	return bases[index]
end

function BaseService.allBases(): { [number]: Base }
	return bases
end

---------------------------------------------------------------- Socles

function BaseService.floorsOf(player: Player): number
	local data = DataService.get(player)
	return math.clamp(if data then data.Floors or 1 else 1, 1, 2)
end

function BaseService.unlockedSlots(player: Player): number
	return math.min(Config.PedestalsPerFloor * BaseService.floorsOf(player), Config.MaxPedestals)
end

-- Affiche ou cache l'étage 2 d'une base (sol, murs, socles, plaques, ascenseur)
local function setFloorVisible(base: Base, visible: boolean)
	local parts = {}
	local floor2 = base.Model:FindFirstChild("Floor2")
	if floor2 then
		for _, d in floor2:GetDescendants() do
			table.insert(parts, d)
		end
	end
	for _, ped in base.Pedestals do
		if ped:GetAttribute("Floor") == 2 then
			table.insert(parts, ped)
			for _, d in ped:GetDescendants() do
				table.insert(parts, d)
			end
		end
	end
	for _, p in parts do
		if p:IsA("BasePart") and p:GetAttribute("BaseTransparency") ~= nil then
			p.Transparency = if visible then p:GetAttribute("BaseTransparency") else 1
			p.CanCollide = visible and p:GetAttribute("BaseCollide") == true
			p.CanTouch = visible and p:GetAttribute("BaseTouch") == true
		end
	end
	base.Model:SetAttribute("Floors", if visible then 2 else 1)
end

-- Met à jour les attributs des socles d'après les données sauvegardées
function BaseService.refreshSlots(player: Player)
	local base = byPlayer[player]
	local data = DataService.get(player)
	if not base or not data then
		return
	end
	setFloorVisible(base, BaseService.floorsOf(player) >= 2)
	local unlocked = BaseService.unlockedSlots(player)
	for slot, ped in base.Pedestals do
		ped:SetAttribute("GhostId", data.Slots[tostring(slot)] or "")
		ped:SetAttribute("Stolen", base.StolenOut[slot] == true)
		ped:SetAttribute("Unlocked", slot <= unlocked)
		ped:SetAttribute("Stored", math.floor(data.Stored and data.Stored[tostring(slot)] or 0))
	end
end

-- Pièces en attente sur un socle (affichées au-dessus de la plaque verte)
function BaseService.showStored(player: Player, slot: number, amount: number)
	local base = byPlayer[player]
	local ped = base and base.Pedestals[slot]
	if ped then
		local shown = math.floor(amount)
		if ped:GetAttribute("Stored") ~= shown then
			ped:SetAttribute("Stored", shown)
		end
	end
end

function BaseService.getGhost(player: Player, slot: number): string?
	local data = DataService.get(player)
	return data and data.Slots[tostring(slot)]
end

function BaseService.findFreeSlot(player: Player): number?
	local base = byPlayer[player]
	local data = DataService.get(player)
	if not base or not data then
		return nil
	end
	for slot = 1, BaseService.unlockedSlots(player) do
		if data.Slots[tostring(slot)] == nil and not base.StolenOut[slot] then
			return slot
		end
	end
	return nil
end

-- Appelé à chaque fois qu'un joueur reçoit un fantôme (branché sur le Fantômédex dans Main)
BaseService.onGhostPlaced = nil :: ((Player, string) -> ())?

-- Pose un fantôme sur un socle libre (ou sur le socle donné). Renvoie le numéro du socle.
function BaseService.placeGhost(player: Player, ghostId: string, slot: number?): number?
	local base = byPlayer[player]
	local data = DataService.get(player)
	if not base or not data then
		return nil
	end
	local target = slot or BaseService.findFreeSlot(player)
	if not target then
		return nil
	end
	data.Slots[tostring(target)] = ghostId
	base.StolenOut[target] = nil
	local ped = base.Pedestals[target]
	ped:SetAttribute("GhostId", ghostId)
	ped:SetAttribute("Stolen", false)
	if BaseService.onGhostPlaced then
		BaseService.onGhostPlaced(player, ghostId)
	end
	return target
end

-- Retire le fantôme d'un socle. Renvoie son Id.
function BaseService.removeGhost(player: Player, slot: number): string?
	local base = byPlayer[player]
	local data = DataService.get(player)
	if not base or not data then
		return nil
	end
	local key = tostring(slot)
	local ghostId = data.Slots[key]
	data.Slots[key] = nil
	base.StolenOut[slot] = nil
	local ped = base.Pedestals[slot]
	if ped then
		ped:SetAttribute("GhostId", "")
		ped:SetAttribute("Stolen", false)
	end
	return ghostId
end

function BaseService.clearAllGhosts(player: Player)
	local data = DataService.get(player)
	if not data then
		return
	end
	data.Slots = {}
	data.Stored = {}
	local base = byPlayer[player]
	if base then
		base.StolenOut = {}
	end
	BaseService.refreshSlots(player)
end

-- "Volé" = en train d'être porté par un voleur (il ne rapporte plus rien)
function BaseService.setStolenOut(player: Player, slot: number, value: boolean)
	local base = byPlayer[player]
	if not base then
		return
	end
	base.StolenOut[slot] = if value then true else nil
	local ped = base.Pedestals[slot]
	if ped then
		ped:SetAttribute("Stolen", value)
	end
end

function BaseService.isStolenOut(player: Player, slot: number): boolean
	local base = byPlayer[player]
	return base ~= nil and base.StolenOut[slot] == true
end

-- Les fantômes qui rapportent (posés et pas en train d'être volés)
function BaseService.activeGhostIds(player: Player): { string }
	local base = byPlayer[player]
	local data = DataService.get(player)
	local list = {}
	if not base or not data then
		return list
	end
	for key, ghostId in data.Slots do
		local slot = tonumber(key)
		if slot and not base.StolenOut[slot] then
			table.insert(list, ghostId)
		end
	end
	return list
end

function BaseService.pedestalPosition(base: Base, slot: number): Vector3
	local ped = base.Pedestals[slot]
	local cf = ped and ped:GetAttribute("GhostCFrame")
	if typeof(cf) == "CFrame" then
		return cf.Position
	end
	return base.Origin.Position
end

-- Est-ce que cette position est à l'intérieur de la base ?
function BaseService.isInside(base: Base, position: Vector3): boolean
	local localPos = base.Origin:PointToObjectSpace(position)
	return math.abs(localPos.X) < MapBuilder.BASE_WIDTH / 2
		and math.abs(localPos.Z) < MapBuilder.BASE_DEPTH / 2
		and localPos.Y > -5
		and localPos.Y < MapBuilder.FLOOR2_Y + MapBuilder.FLOOR2_WALL + 6
end

function BaseService.baseAt(position: Vector3): Base?
	for _, base in bases do
		if BaseService.isInside(base, position) then
			return base
		end
	end
	return nil
end

---------------------------------------------------------------- Verrou

function BaseService.isLocked(base: Base): boolean
	return now() < base.LockedUntil
end

-- Une barrière à barreaux rouges et blancs ferme l'entrée de la base
local function makeBarrierPart(model: Model, size: Vector3, cf: CFrame, color: Color3, neon: boolean, name: string): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.Parent = model
	return p
end

local RED = Color3.fromRGB(230, 40, 50)
local WHITE = Color3.fromRGB(250, 250, 250)

local function setBarrier(base: Base, on: boolean)
	if on and not base.Barrier then
		local front = base.Origin * CFrame.new(0, 0, -MapBuilder.BASE_DEPTH / 2)
		local barrier = Instance.new("Model")
		barrier.Name = "Barrier"
		-- le "mur" invisible qui bloque vraiment (les barreaux sont décoratifs)
		local wallSize = Vector3.new(10, MapBuilder.WALL_HEIGHT, 1)
		local collider = makeBarrierPart(barrier, wallSize, front * CFrame.new(0, MapBuilder.WALL_HEIGHT / 2, 0), WHITE, false, "Collider")
		collider.Transparency = 1
		collider.CanCollide = true
		if collisionGroupsReady then
			collider.CollisionGroup = gateGroup(base.Index)
		end
		barrier.PrimaryPart = collider
		for i = 0, 6 do
			local red = i % 2 == 0
			local barCf = front * CFrame.new(-4.5 + i * 1.5, 5.5, 0) * CFrame.Angles(0, 0, math.rad(90))
			local bar = makeBarrierPart(barrier, Vector3.new(11, 0.5, 0.5), barCf, if red then RED else WHITE, red, "Bar")
			bar.Shape = Enum.PartType.Cylinder
		end
		for _, y in { 2.5, 8.5 } do
			for i = 0, 4 do
				local red = i % 2 == 0
				makeBarrierPart(barrier, Vector3.new(2, 0.7, 0.7), front * CFrame.new(-4 + i * 2, y, 0), if red then RED else WHITE, red, "Rail")
			end
		end
		barrier.Parent = base.Model
		base.Barrier = barrier
	elseif not on and base.Barrier then
		base.Barrier:Destroy()
		base.Barrier = nil
	end
end

local function applyLock(base: Base, duration: number, isShield: boolean)
	local t = now()
	base.LockedUntil = t + duration
	base.LockReadyAt = if isShield then base.LockedUntil else base.LockedUntil + Config.LockCooldown
	base.Model:SetAttribute("LockedUntil", base.LockedUntil)
	base.Model:SetAttribute("LockReadyAt", base.LockReadyAt)
	base.Model:SetAttribute("Shield", isShield)
	setBarrier(base, true)
end

local function unlock(base: Base)
	base.LockedUntil = 0
	base.Model:SetAttribute("LockedUntil", 0)
	base.Model:SetAttribute("Shield", false)
	setBarrier(base, false)
end

-- Distance max au bouton du verrou (le bouton s'active à 9 studs, + marge pour la latence)
local LOCK_BUTTON_RANGE = 14

-- Le joueur demande à verrouiller sa base. Renvoie (ok, cléDeMessage, paramètres)
function BaseService.lock(player: Player): (boolean, string?, { [string]: any }?)
	local base = byPlayer[player]
	if not base then
		return false, "NotAllowed"
	end
	-- on verrouille seulement avec le bouton au fond de SA base
	local root = Guard.root(player)
	local button = base.Model:FindFirstChild("LockButton") :: BasePart?
	if not root or not button or (root.Position - button.Position).Magnitude > LOCK_BUTTON_RANGE then
		return false, "LockGoToButton"
	end
	local t = now()
	if BaseService.isLocked(base) then
		return false, "LockOn"
	end
	if t < base.LockReadyAt then
		return false, "LockNotReady", { time = Format.time(base.LockReadyAt - t) }
	end
	applyLock(base, Config.LockDuration, false)
	return true, "LockOn"
end

function BaseService.giveShield(player: Player, duration: number)
	local base = byPlayer[player]
	if base then
		applyLock(base, duration, true)
	end
end

-- Renvoie hors de la base les intrus quand elle est verrouillée
local function pushIntruders(base: Base)
	for _, other in Players:GetPlayers() do
		if other ~= base.Owner then
			local character = other.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and BaseService.isInside(base, root.Position) then
				local outside = base.Origin * CFrame.new(math.random(-4, 4), 3, -MapBuilder.BASE_DEPTH / 2 - 6)
				character:PivotTo(outside)
			end
		end
	end
end

---------------------------------------------------------------- Joueurs

function BaseService.teleportHome(player: Player)
	local base = byPlayer[player]
	local character = player.Character
	if base and character then
		character:PivotTo(base.Spawn.CFrame * CFrame.new(0, 3.5, 0))
	end
end

function BaseService.spawnCharacter(player: Player)
	if not player.Parent then
		return
	end
	local ok, err = pcall(function()
		player:LoadCharacter()
	end)
	if not ok then
		warn("[BaseService] LoadCharacter a échoué : " .. tostring(err))
	end
end

local function onCharacterAdded(player: Player, character: Model)
	applyOwnerGroup(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.WalkSpeed = Config.NormalWalkSpeed
	humanoid.Died:Connect(function()
		task.delay(Config.RespawnDelay, function()
			if player.Parent and player.Character == character then
				BaseService.spawnCharacter(player)
			end
		end)
	end)
	-- Sécurité : si le joueur n'est pas apparu dans sa base, on l'y amène
	task.delay(0.3, function()
		local base = byPlayer[player]
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if base and root and not BaseService.isInside(base, root.Position) then
			BaseService.teleportHome(player)
		end
	end)
end

function BaseService.assign(player: Player): Base?
	local chosen: Base? = nil
	for _, index in ASSIGN_ORDER do
		local base = bases[index]
		if base and not base.Owner then
			chosen = base
			break
		end
	end
	if not chosen then
		warn("[BaseService] Plus de base libre pour " .. player.Name)
		return nil
	end
	local base = chosen :: Base
	base.Owner = player
	base.StolenOut = {}
	byPlayer[player] = base
	base.Model:SetAttribute("OwnerUserId", player.UserId)
	base.Model:SetAttribute("OwnerName", player.DisplayName)
	player:SetAttribute("BaseIndex", base.Index)
	player.RespawnLocation = base.Spawn
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	BaseService.refreshSlots(player)
	return base
end

function BaseService.release(player: Player)
	local base = byPlayer[player]
	if not base then
		return
	end
	byPlayer[player] = nil
	base.Owner = nil
	base.StolenOut = {}
	unlock(base)
	base.LockReadyAt = 0
	base.Model:SetAttribute("LockReadyAt", 0)
	base.Model:SetAttribute("OwnerUserId", 0)
	base.Model:SetAttribute("OwnerName", "")
	for _, ped in base.Pedestals do
		ped:SetAttribute("GhostId", "")
		ped:SetAttribute("Stolen", false)
		ped:SetAttribute("Unlocked", false)
		ped:SetAttribute("Stored", 0)
		ped.Color = PEDESTAL_COLOR
	end
	setFloorVisible(base, false)
end

-- Ascenseur : la plaque violette du fond monte à l'étage, celle de l'étage redescend
local elevatorCooldown: { [Player]: number } = {}

local function useElevator(base: Base, hit: BasePart, up: boolean)
	local character = hit.Parent
	local player = character and Players:GetPlayerFromCharacter(character)
	if not player or not base.Owner or base.Model:GetAttribute("Floors") ~= 2 then
		return
	end
	if (elevatorCooldown[player] or 0) > os.clock() or not Guard.root(player) then
		return
	end
	elevatorCooldown[player] = os.clock() + 1
	local y = if up then MapBuilder.FLOOR2_Y + 3 else 3
	character:PivotTo(base.Origin * CFrame.new(0, y, 6))
	AnnounceService.effect("Elevator", { Position = base.Origin.Position }, player)
end

-- Débloque l'étage 2 d'un joueur (appelé par EconomyService après le paiement)
function BaseService.unlockFloor(player: Player)
	local data = DataService.get(player)
	if data then
		data.Floors = 2
		BaseService.refreshSlots(player)
	end
end

function BaseService.start()
	for _, base in bases do
		local upPad = base.Model:FindFirstChild("UpPad") :: BasePart?
		local floor2 = base.Model:FindFirstChild("Floor2")
		local downPad = floor2 and floor2:FindFirstChild("DownPad") :: BasePart?
		if upPad then
			upPad.Touched:Connect(function(hit)
				useElevator(base, hit, true)
			end)
		end
		if downPad then
			downPad.Touched:Connect(function(hit)
				useElevator(base, hit, false)
			end)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		elevatorCooldown[player] = nil
	end)

	-- Le joueur appuie sur "Verrouiller"
	Remotes.get("RequestLock").OnServerEvent:Connect(function(player)
		if not Guard.rate(player, "Lock", 0.5) then
			return
		end
		local ok, key, params = BaseService.lock(player)
		if ok then
			Hooks.fire("Lock", player, 1)
			AnnounceService.notify(player, "LockOn", nil, "good")
			AnnounceService.effect("Lock", { Position = BaseService.getBase(player).Origin.Position }, nil)
		elseif key then
			AnnounceService.notify(player, key, params, "bad")
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			local t = now()
			for _, base in bases do
				if base.LockedUntil > 0 then
					if t >= base.LockedUntil then
						unlock(base)
					elseif base.Owner then
						pushIntruders(base)
					end
				end
			end
		end
	end)
end

return BaseService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">CodeService</string>
          <string name="Source"><![CDATA[--[[
	CodeService : les codes promo (liste dans Config.Codes).
	Le joueur tape un code dans la Boutique, le serveur vérifie :
	  - que le code existe et n'a pas expiré
	  - que ce joueur ne l'a pas déjà utilisé (noté dans sa sauvegarde)
	Anti-triche : une tentative par seconde, et 20 essais ratés maximum par partie.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local GhostData = require(Shared:WaitForChild("GhostData"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local AnnounceService = require(script.Parent.AnnounceService)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local GhostService = require(script.Parent.GhostService)
local Guard = require(script.Parent.Guard)

local CodeService = {}

local MAX_FAILURES = 20
local failures: { [Player]: number } = {}

-- "  bouh 2026 " -> "BOUH2026"
function CodeService.normalize(code: string): string
	local cleaned = string.gsub(string.upper(code), "%s", "")
	return cleaned
end

local function redeem(player: Player, raw: any)
	if typeof(raw) ~= "string" or #raw == 0 or #raw > 30 then
		return
	end
	if not Guard.rate(player, "Code", 1) then
		return
	end
	if (failures[player] or 0) >= MAX_FAILURES then
		AnnounceService.notify(player, "CodeInvalid", nil, "bad")
		return
	end
	local data = DataService.get(player)
	if not data then
		return
	end
	local key = CodeService.normalize(raw)
	local def = Config.Codes[key]
	if not def then
		failures[player] = (failures[player] or 0) + 1
		AnnounceService.notify(player, "CodeInvalid", nil, "bad")
		return
	end
	if def.Expires and def.Expires > 0 and os.time() > def.Expires then
		AnnounceService.notify(player, "CodeExpired", nil, "bad")
		return
	end
	if data.RedeemedCodes[key] then
		AnnounceService.notify(player, "CodeUsed", nil, "bad")
		return
	end
	data.RedeemedCodes[key] = true

	local coins = def.Coins or 0
	if def.Minutes then
		coins += math.max(def.Min or 0, math.floor(EconomyService.incomePerSecond(player) * 60 * def.Minutes))
	end
	local ghostId = nil
	if def.Ghost and GhostData.get(def.Ghost) then
		if GhostService.giveGhost(player, def.Ghost) then
			ghostId = def.Ghost
		else
			coins += GhostData.priceOf(def.Ghost) -- base pleine : on donne sa valeur
		end
	end
	if coins > 0 then
		EconomyService.add(player, coins, true)
	end

	if ghostId then
		AnnounceService.notify(player, "CodeOkGhost", { ghost = ghostId }, "good")
	else
		AnnounceService.notify(player, "CodeOk", { coins = Format.short(coins) }, "good")
	end
	AnnounceService.effect("Gift", {}, player)
end

function CodeService.start()
	Remotes.get("RedeemCode").OnServerEvent:Connect(redeem)
	Players.PlayerRemoving:Connect(function(player)
		failures[player] = nil
	end)
end

return CodeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService : charge et sauvegarde les données des joueurs (DataStoreService).

	Sécurités :
	  - 5 essais en cas d'erreur Roblox, avec une attente qui augmente
	  - "verrou de session" : si le joueur change vite de serveur, le nouveau serveur
	    attend que l'ancien ait fini de sauvegarder (évite d'écraser des données)
	  - si le chargement échoue en jeu publié, le joueur est renvoyé (kick) plutôt que
	    de jouer avec des données vides qui écraseraient sa vraie sauvegarde
	  - sauvegarde auto toutes les 2 min, à la déconnexion et à l'arrêt du serveur
	  - dans Studio sans accès aux API : on joue quand même, mais rien n'est sauvegardé
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local DataService = {}

export type Profile = {
	Data: { [string]: any },
	CanSave: boolean,
	Key: string,
	IsNew: boolean,
	Released: boolean,
}

local IS_STUDIO = RunService:IsStudio()
local profiles: { [Player]: Profile } = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore indisponible : " .. tostring(result))
	end
end

-- Les données d'un nouveau joueur
local function template()
	return {
		Version = 1,
		Coins = Config.StartCoins,
		Slots = {}, -- ["1"] = "DrapMou" : le fantôme posé sur le socle 1
		Stored = {}, -- ["1"] = 12.5 : pièces qui attendent sur le socle 1
		Floors = 1, -- 2 quand l'étage est acheté
		Rebirths = 0,
		TotalEarned = 0,
		TotalSteals = 0,
		LastOnline = 0,
		DailyDay = 0, -- dernier jour (UTC) où le cadeau a été récupéré
		DailyStreak = 0,
		StarterGiven = false,
		TutorialDone = false,
		Receipts = {}, -- achats Robux déjà traités (anti double crédit)
		Discovered = {}, -- Fantômédex : ["DrapMou"] = true
		IndexRewards = {}, -- séries déjà récompensées : ["Common"] = true
		IndexComplete = false, -- bonus permanent du Fantômédex complet
		RedeemedCodes = {}, -- codes promo déjà utilisés : ["BOUH2026"] = true
		Missions = {}, -- missions du jour : { Day, List, BonusDone }
		Spins = 0, -- tours de Roue de la Fortune achetés et pas encore utilisés
		BoostUntil = 0, -- fin du bonus "x2 revenus" de la roue (temps Unix)
	}
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- Ajoute les champs manquants (utile quand on ajoute une nouveauté au jeu)
local function reconcile(data: { [string]: any }, tmpl: { [string]: any })
	for key, value in tmpl do
		if data[key] == nil then
			data[key] = deepCopy(value)
		end
	end
end

local function makeProfile(player: Player, data, canSave: boolean): Profile
	reconcile(data, template())
	local profile: Profile = {
		Data = data,
		CanSave = canSave,
		Key = "Player_" .. player.UserId,
		IsNew = data.LastOnline == 0,
		Released = false,
	}
	profiles[player] = profile
	return profile
end

local function studioFallback(player: Player, reason: any): Profile
	warn(
		"[DataService] Mode test : la sauvegarde est désactivée ("
			.. tostring(reason)
			.. "). Pour l'activer dans Studio : Accueil > Paramètres du jeu > Sécurité > "
			.. "'Enable Studio Access to API Services'."
	)
	return makeProfile(player, template(), false)
end

-- Charge les données d'un joueur. Renvoie nil si le joueur a été renvoyé ou est parti.
function DataService.load(player: Player): Profile?
	if not store then
		if IS_STUDIO then
			return studioFallback(player, "pas de DataStore")
		end
		player:Kick("Les sauvegardes Roblox ne répondent pas, réessaie dans un instant. / Roblox saves are down, please retry soon.")
		return nil
	end

	local ds = store :: DataStore
	local key = "Player_" .. player.UserId
	local attempts = 0
	local waitedForLock = 0

	while player.Parent do
		attempts += 1
		local lockedElsewhere = false
		local loaded = nil
		local ok, err = pcall(function()
			ds:UpdateAsync(key, function(old)
				lockedElsewhere = false
				loaded = nil
				if type(old) == "table" and type(old.Lock) == "table" and old.Lock.Job ~= game.JobId then
					local age = os.time() - (old.Lock.Time or 0)
					if age < Config.SessionLockTimeout and waitedForLock < Config.SessionLockMaxWait then
						lockedElsewhere = true
						return nil -- on n'écrit rien, on réessaiera
					end
				end
				local data = if type(old) == "table" then old else template()
				data.Lock = { Job = game.JobId, Time = os.time() }
				loaded = data
				return data
			end)
		end)

		if ok and loaded and not lockedElsewhere then
			return makeProfile(player, loaded, true)
		elseif ok and lockedElsewhere then
			-- L'ancien serveur n'a pas encore fini de sauvegarder : on patiente
			waitedForLock += 5
			task.wait(5)
		else
			warn(string.format("[DataService] Échec de chargement pour %s (essai %d) : %s", player.Name, attempts, tostring(err)))
			if IS_STUDIO then
				return studioFallback(player, err)
			end
			if attempts >= 5 then
				player:Kick("Impossible de charger ta sauvegarde, réessaie. / Could not load your save, please rejoin.")
				return nil
			end
			task.wait(2 ^ attempts)
		end
	end
	return nil
end

local function writeOnce(profile: Profile, release: boolean): (boolean, any)
	local snapshot = deepCopy(profile.Data)
	snapshot.LastOnline = os.time()
	snapshot.Lock = if release then nil else { Job = game.JobId, Time = os.time() }
	local ds = store :: DataStore
	return pcall(function()
		ds:UpdateAsync(profile.Key, function(old)
			if profile.Released and not release then
				return nil -- le joueur est déjà parti : une vieille sauvegarde auto ne doit rien écrire
			end
			if type(old) == "table" and type(old.Lock) == "table" and old.Lock.Job ~= game.JobId then
				return nil -- un autre serveur a repris ce joueur : on n'écrase pas
			end
			return snapshot
		end)
	end)
end

-- Sauvegarde un joueur. release = true quand il quitte le jeu.
function DataService.save(player: Player, release: boolean?): boolean
	local profile = profiles[player]
	if not profile then
		return true
	end
	if release then
		profile.Released = true
	end
	if not profile.CanSave or not store then
		return true
	end
	for attempt = 1, 3 do
		local ok, err = writeOnce(profile, release == true)
		if ok then
			return true
		end
		warn(string.format("[DataService] Échec de sauvegarde pour %s (essai %d) : %s", player.Name, attempt, tostring(err)))
		task.wait(attempt)
	end
	return false
end

-- Appelé quand le joueur quitte : dernière sauvegarde puis on oublie son profil
function DataService.release(player: Player)
	DataService.save(player, true)
	profiles[player] = nil
end

function DataService.getProfile(player: Player): Profile?
	return profiles[player]
end

-- Les données du joueur (nil si pas encore chargées)
function DataService.get(player: Player): { [string]: any }?
	local profile = profiles[player]
	return profile and profile.Data
end

function DataService.canSave(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.CanSave
end

function DataService.start()
	-- Sauvegarde automatique
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			local list = {}
			for player, profile in profiles do
				if profile.CanSave and not profile.Released then
					table.insert(list, player)
				end
			end
			for _, player in list do
				task.spawn(DataService.save, player, false)
				task.wait(1) -- on étale les sauvegardes
			end
		end
	end)

	-- Arrêt du serveur : on sauvegarde tout le monde avant de fermer
	game:BindToClose(function()
		if not store then
			return
		end
		local pending = 0
		for player, profile in profiles do
			if profile.CanSave and not profile.Released then
				pending += 1
				task.spawn(function()
					DataService.save(player, true)
					pending -= 1
				end)
			end
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[--[[
	EconomyService : l'argent du jeu. SEUL le serveur modifie les pièces.
	  - chaque seconde : chaque fantôme remplit SON socle (revenu x multiplicateur) ;
	    le propriétaire passe sur la plaque verte devant le socle pour récupérer les pièces
	  - un petit revenu de base (1/s) arrive directement, pour ne jamais être bloqué
	  - achat de l'étage 2
	  - multiplicateur = rebirths x Game Pass x2 x bonus amis
	  - gains hors ligne (plafonnés) et cadeau du jour
	  - affichage : attributs du joueur + classement (leaderstats)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local GhostData = require(Shared:WaitForChild("GhostData"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local AnnounceService = require(script.Parent.AnnounceService)
local BaseService = require(script.Parent.BaseService)
local DataService = require(script.Parent.DataService)
local Guard = require(script.Parent.Guard)
local Hooks = require(script.Parent.Hooks)

local EconomyService = {}

local friendBonus: { [Player]: number } = {}
local friendCache: { [string]: boolean } = {}

-- Total des pièces qui attendent sur les socles (affiché dans le HUD)
local function updateStoredTotal(player: Player, data)
	local total = 0
	for _, amount in data.Stored do
		total += amount
	end
	player:SetAttribute("Stored", math.floor(total))
end

---------------------------------------------------------------- Calculs

-- Week-end x2 : du vendredi 17h UTC au dimanche 23h UTC
function EconomyService.isWeekendBoost(t: number?): boolean
	if not Config.WeekendBoost.Enabled then
		return false
	end
	local date = os.date("!*t", t or os.time())
	-- wday : 1 = dimanche, 6 = vendredi, 7 = samedi
	return (date.wday == 6 and date.hour >= 17) or date.wday == 7 or (date.wday == 1 and date.hour < 23)
end

-- Multiplicateur de rebirth seul (x1, x1.5, x2...)
function EconomyService.rebirthMultiplier(rebirths: number): number
	return 1 + rebirths * Config.RebirthIncomeBonus
end

function EconomyService.multiplier(player: Player): number
	local data = DataService.get(player)
	if not data then
		return 1
	end
	local m = EconomyService.rebirthMultiplier(data.Rebirths)
	if player:GetAttribute("DoubleCoins") then
		m *= 2
	end
	m *= 1 + (friendBonus[player] or 0)
	if data.IndexComplete then
		m *= 1 + Config.IndexCompleteBonus
	end
	if ReplicatedStorage:GetAttribute("WeekendBoost") then
		m *= Config.WeekendBoost.Mult
	end
	-- Roue de la Fortune : revenus x2 pendant un moment
	if (data.BoostUntil or 0) > os.time() then
		m *= Config.WheelBoostMult
	end
	return m
end

-- Revenu par seconde AVANT multiplicateur
function EconomyService.baseIncome(player: Player): number
	local total = Config.BaseIncome
	for _, ghostKey in BaseService.activeGhostIds(player) do
		total += GhostData.incomeOf(ghostKey) -- variante Dorée / Arc-en-ciel comprise
	end
	return total
end

function EconomyService.incomePerSecond(player: Player): number
	return EconomyService.baseIncome(player) * EconomyService.multiplier(player)
end

---------------------------------------------------------------- Affichage

local function ensureLeaderstats(player: Player)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		return stats
	end
	stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local coins = Instance.new("StringValue")
	coins.Name = "Coins"
	coins.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player
	return stats
end

-- Met à jour ce que le joueur voit (pièces, revenu, multiplicateur)
function EconomyService.refresh(player: Player)
	local data = DataService.get(player)
	if not data then
		return
	end
	local income = EconomyService.incomePerSecond(player)
	player:SetAttribute("Coins", math.floor(data.Coins))
	player:SetAttribute("Income", math.floor(income * 10) / 10)
	player:SetAttribute("Multiplier", math.floor(EconomyService.multiplier(player) * 100) / 100)
	player:SetAttribute("Rebirths", data.Rebirths)
	player:SetAttribute("FriendBonus", friendBonus[player] or 0)
	player:SetAttribute("BoostUntil", data.BoostUntil or 0)
	if data.Stored then
		updateStoredTotal(player, data)
	end
	local stats = ensureLeaderstats(player)
	stats.Coins.Value = Format.short(data.Coins)
	stats.Rebirths.Value = data.Rebirths
end

---------------------------------------------------------------- Pièces

function EconomyService.add(player: Player, amount: number, countAsEarned: boolean?)
	local data = DataService.get(player)
	if not data or amount ~= amount or amount <= 0 then
		return
	end
	data.Coins += amount
	if countAsEarned then
		data.TotalEarned += amount
		Hooks.fire("Earn", player, amount)
	end
	EconomyService.refresh(player)
end

-- Retire des pièces si le joueur en a assez. Renvoie true si c'est fait.
function EconomyService.trySpend(player: Player, amount: number): boolean
	local data = DataService.get(player)
	if not data or amount < 0 or data.Coins < amount then
		return false
	end
	data.Coins -= amount
	EconomyService.refresh(player)
	return true
end

-- Retire un pourcentage des pièces (attrapé par le monstre). Renvoie le montant retiré.
function EconomyService.takePercent(player: Player, percent: number): number
	local data = DataService.get(player)
	if not data then
		return 0
	end
	local amount = math.floor(data.Coins * percent)
	if amount > 0 then
		data.Coins -= amount
		EconomyService.refresh(player)
	end
	return amount
end

---------------------------------------------------------------- Amis

local function areFriends(a: Player, b: Player): boolean
	if a.UserId <= 0 or b.UserId <= 0 then
		return false -- joueurs de test dans Studio
	end
	local key = if a.UserId < b.UserId then a.UserId .. "_" .. b.UserId else b.UserId .. "_" .. a.UserId
	if friendCache[key] == nil then
		local ok, result = pcall(function()
			return a:IsFriendsWith(b.UserId)
		end)
		friendCache[key] = ok and result == true
	end
	return friendCache[key]
end

-- +10 % par ami présent dans le serveur (max +50 %)
function EconomyService.recomputeFriends()
	local players = Players:GetPlayers()
	for _, player in players do
		local count = 0
		for _, other in players do
			if other ~= player and areFriends(player, other) then
				count += 1
			end
		end
		local bonus = math.min(count * Config.FriendBonus, Config.FriendBonusMax)
		friendBonus[player] = bonus
		EconomyService.refresh(player)
	end
end

---------------------------------------------------------------- Hors ligne & cadeau du jour

---------------------------------------------------------------- Récolte sur les socles

-- Le propriétaire passe sur la plaque verte : il récupère les pièces du socle
function EconomyService.collect(player: Player, slot: number): number
	local data = DataService.get(player)
	if not data then
		return 0
	end
	local key = tostring(slot)
	local stored = data.Stored[key] or 0
	local amount = math.floor(stored)
	if amount < 1 then
		return 0
	end
	data.Stored[key] = stored - amount
	BaseService.showStored(player, slot, data.Stored[key])
	EconomyService.add(player, amount, true)
	updateStoredTotal(player, data)
	player:SetAttribute("HasCollected", true)
	return amount
end

-- Chaque fantôme remplit son socle (appelé chaque seconde)
local function produce(player: Player, data, seconds: number, multiplier: number)
	local base = BaseService.getBase(player)
	if not base then
		return
	end
	for key, ghostKey in data.Slots do
		local slot = tonumber(key)
		if slot and not BaseService.isStolenOut(player, slot) then
			local amount = GhostData.incomeOf(ghostKey) * multiplier * seconds
			data.Stored[key] = (data.Stored[key] or 0) + amount
			BaseService.showStored(player, slot, data.Stored[key])
		end
	end
	updateStoredTotal(player, data)
end

-- Revenus produits pendant l'absence (50 %, 3 h max), posés sur les socles.
-- À appeler après la pose des fantômes.
function EconomyService.grantOffline(player: Player, lastOnline: number)
	if lastOnline <= 0 then
		return
	end
	local away = math.min(os.time() - lastOnline, Config.OfflineCapSeconds)
	if away < Config.OfflineMinSeconds then
		return
	end
	-- sans le bonus amis ni le week-end (on ne sait pas ce qui s'est passé)
	local data = DataService.get(player)
	if not data then
		return
	end
	local multiplier = EconomyService.rebirthMultiplier(data.Rebirths)
	if player:GetAttribute("DoubleCoins") then
		multiplier *= 2
	end
	if data.IndexComplete then
		multiplier *= 1 + Config.IndexCompleteBonus
	end
	local before = player:GetAttribute("Stored") or 0
	produce(player, data, away * Config.OfflineRate, multiplier)
	local amount = (player:GetAttribute("Stored") or 0) - before
	if amount > 0 then
		AnnounceService.notify(player, "OfflineEarned", { coins = Format.short(amount) }, "good")
	end
end

-- Achat de l'étage 2
local function buyFloor(player: Player)
	if not Guard.rate(player, "BuyFloor", 1) then
		return
	end
	local data = DataService.get(player)
	if not data or not BaseService.getBase(player) then
		return
	end
	if (data.Floors or 1) >= 2 then
		return
	end
	if not EconomyService.trySpend(player, Config.FloorPrice) then
		AnnounceService.notify(player, "NotEnoughCoins", nil, "bad")
		return
	end
	BaseService.unlockFloor(player)
	AnnounceService.notify(player, "FloorBought", nil, "good")
	AnnounceService.effect("Rebirth", { Position = BaseService.getBase(player).Origin.Position, PlayerId = player.UserId })
end

local function today(): number
	return os.time() // 86400
end

-- Infos du cadeau du jour pour l'affichage
function EconomyService.dailyInfo(player: Player)
	local data = DataService.get(player)
	if not data then
		return nil
	end
	local day = today()
	local canClaim = data.DailyDay < day
	-- si on a raté un jour, la série recommence au jour 1
	local streak = data.DailyStreak
	if data.DailyDay < day - 1 then
		streak = 0
	end
	local nextDay = if canClaim then (streak % #Config.DailyRewards) + 1 else ((streak - 1) % #Config.DailyRewards) + 1
	return {
		CanClaim = canClaim,
		Day = nextDay,
		NextAt = (day + 1) * 86400, -- minuit UTC
		Rewards = Config.DailyRewards,
	}
end

function EconomyService.sendDailyInfo(player: Player)
	local info = EconomyService.dailyInfo(player)
	if info then
		player:SetAttribute("DailyReady", info.CanClaim)
		Remotes.get("DailyInfo"):FireClient(player, info)
	end
end

-- giveGhost est fourni par GhostService (pour le fantôme Épique du jour 7)
EconomyService.giveGhostCallback = nil :: ((Player, string) -> number?)?

function EconomyService.claimDaily(player: Player)
	local data = DataService.get(player)
	local info = EconomyService.dailyInfo(player)
	if not data or not info or not info.CanClaim then
		return
	end
	local reward = Config.DailyRewards[info.Day]
	data.DailyDay = today()
	data.DailyStreak = (if info.Day == 1 then 0 else data.DailyStreak) + 1
	local coins = math.max(reward.Min, math.floor(EconomyService.incomePerSecond(player) * 60 * reward.Minutes))
	EconomyService.add(player, coins, true)

	local ghostId = nil
	if reward.RandomGhostRarity and EconomyService.giveGhostCallback then
		local list = GhostData.ByRarity[reward.RandomGhostRarity]
		local ghost = list[math.random(1, #list)]
		local slot = EconomyService.giveGhostCallback(player, ghost.Id)
		if slot then
			ghostId = ghost.Id
		else
			EconomyService.add(player, ghost.Price, true) -- base pleine : on donne sa valeur
		end
	end

	if ghostId then
		AnnounceService.notify(player, "DailyGotGhost", { day = info.Day, coins = Format.short(coins), ghost = ghostId }, "good")
	else
		AnnounceService.notify(player, "DailyGot", { day = info.Day, coins = Format.short(coins) }, "good")
	end
	AnnounceService.effect("Gift", {}, player)
	EconomyService.sendDailyInfo(player)
end

---------------------------------------------------------------- Démarrage

function EconomyService.setup(player: Player)
	ensureLeaderstats(player)
	EconomyService.refresh(player)
	task.spawn(EconomyService.recomputeFriends)
end

function EconomyService.onPlayerRemoving(player: Player)
	friendBonus[player] = nil
	task.defer(EconomyService.recomputeFriends)
end

function EconomyService.start()
	Remotes.get("ClaimDaily").OnServerEvent:Connect(function(player)
		if Guard.rate(player, "Daily", 1) then
			EconomyService.claimDaily(player)
		end
	end)
	Remotes.get("BuyFloor").OnServerEvent:Connect(buyFloor)

	-- Plaques vertes : seul le propriétaire de la base récupère les pièces
	local padCooldown: { [BasePart]: number } = {}
	for _, base in BaseService.allBases() do
		for slot, ped in base.Pedestals do
			local pad = ped:FindFirstChild("CollectPad") :: BasePart?
			if pad then
				pad.Touched:Connect(function(hit)
					local owner = base.Owner
					if not owner or (padCooldown[pad] or 0) > os.clock() then
						return
					end
					local character = hit.Parent
					if not character or Players:GetPlayerFromCharacter(character) ~= owner then
						return
					end
					padCooldown[pad] = os.clock() + 0.3
					local amount = EconomyService.collect(owner, slot)
					if amount > 0 then
						AnnounceService.effect("Collect", { Position = pad.Position, Amount = amount }, owner)
					end
				end)
			end
		end
	end

	-- Le revenu tombe toutes les secondes
	task.spawn(function()
		while true do
			task.wait(1)
			local boost = EconomyService.isWeekendBoost()
			if ReplicatedStorage:GetAttribute("WeekendBoost") ~= boost then
				ReplicatedStorage:SetAttribute("WeekendBoost", boost)
			end
			for _, player in Players:GetPlayers() do
				local data = DataService.get(player)
				if data and BaseService.getBase(player) then
					local multiplier = EconomyService.multiplier(player)
					EconomyService.add(player, Config.BaseIncome * multiplier, true)
					produce(player, data, 1, multiplier)
				end
			end
		end
	end)
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">GhostService</string>
          <string name="Source"><![CDATA[--[[
	GhostService : les fantômes qui défilent sur le chemin hanté.

	Le serveur ne déplace AUCUN objet 3D : il note juste "tel fantôme est parti à telle
	heure". Chaque joueur calcule la position et affiche le fantôme lui-même (sans saccades et
	léger). Quand un joueur veut acheter, le serveur recalcule la position et vérifie
	la distance, l'argent et la place libre.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local GhostData = require(Shared:WaitForChild("GhostData"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local AnnounceService = require(script.Parent.AnnounceService)
local BaseService = require(script.Parent.BaseService)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local Guard = require(script.Parent.Guard)
local Hooks = require(script.Parent.Hooks)

local GhostService = {}

type Entry = { Uid: string, GhostId: string, SpawnTime: number, Holder: Instance }

local entries: { [string]: Entry } = {}
local folder: Folder
local counter = 0
local rng = Random.new()

local PATH_LENGTH = Config.PathEndX - Config.PathStartX
local TRAVEL_TIME = PATH_LENGTH / Config.PathSpeed

local function now(): number
	return workspace:GetServerTimeNow()
end

function GhostService.isEventActive(): boolean
	if Config.ForceHalloween then
		return true
	end
	local t = os.time()
	return t >= Config.HalloweenStart and t < Config.HalloweenEnd
end

function GhostService.isNight(): boolean
	return ReplicatedStorage:GetAttribute("NightActive") == true
end

function GhostService.positionOf(entry: Entry, at: number): Vector3
	local x = Config.PathStartX + (at - entry.SpawnTime) * Config.PathSpeed
	return Vector3.new(x, Config.PathY, Config.PathZ)
end

local function count(): number
	local n = 0
	for _ in entries do
		n += 1
	end
	return n
end

local function removeEntry(uid: string)
	local entry = entries[uid]
	if entry then
		entries[uid] = nil
		entry.Holder:Destroy()
	end
end

-- Fait apparaître un fantôme au début du chemin (au hasard si ghostId est nil)
function GhostService.spawn(ghostId: string?)
	local ghostKey: string
	if ghostId then
		if not GhostData.get(ghostId) then
			return
		end
		ghostKey = ghostId
	else
		local rarity = Rarities.roll(rng:NextNumber(), GhostService.isNight(), GhostService.isEventActive())
		local ghost = GhostData.pick(rarity, rng:NextNumber())
		-- parfois une variante Dorée (x3) ou Arc-en-ciel (x5)
		local mutation = GhostData.rollMutation(rng:NextNumber(), GhostService.isNight(), GhostService.mutationBoost)
		ghostKey = GhostData.key(ghost.Id, mutation)
	end
	local ghost = GhostData.get(ghostKey)
	local _, mutation = GhostData.split(ghostKey)
	counter += 1
	local uid = tostring(counter)
	local holder = Instance.new("Configuration")
	holder.Name = uid
	holder:SetAttribute("GhostId", ghostKey)
	holder:SetAttribute("SpawnTime", now())
	holder.Parent = folder
	entries[uid] = { Uid = uid, GhostId = ghostKey, SpawnTime = now(), Holder = holder }

	-- Annonce à tout le serveur pour les apparitions très rares
	if mutation == "Rainbow" then
		AnnounceService.announce("AnnRainbowSpawn", { ghost = ghostKey }, "rainbow")
	elseif ghost.Rarity == "Mythic" then
		AnnounceService.announce("AnnMythicSpawn", { ghost = ghostKey }, "mythic")
	elseif ghost.Rarity == "Halloween" then
		AnnounceService.announce("AnnHalloweenSpawn", { ghost = ghostKey }, "halloween")
	end
end

-- Multiplicateur de chance des variantes (la Super Nuit l'augmente)
GhostService.mutationBoost = 1

-- Donne un fantôme directement dans la base (cadeau). Renvoie le socle ou nil si plein.
function GhostService.giveGhost(player: Player, ghostId: string): number?
	local slot = BaseService.placeGhost(player, ghostId)
	if slot then
		local base = BaseService.getBase(player)
		if base then
			AnnounceService.effect("Placed", { Position = BaseService.pedestalPosition(base, slot), GhostId = ghostId })
		end
		EconomyService.refresh(player)
	end
	return slot
end

local function onBuy(player: Player, uid: any)
	if typeof(uid) ~= "string" or #uid > 12 then
		return
	end
	if not Guard.rate(player, "Buy", 0.25) then
		return
	end
	local data = DataService.get(player)
	local base = BaseService.getBase(player)
	if not data or not base then
		return
	end
	local entry = entries[uid]
	if not entry then
		AnnounceService.notify(player, "AlreadyGone", nil, "bad")
		return
	end
	local ghost = GhostData.get(entry.GhostId)
	local root = Guard.root(player)
	if not ghost or not root then
		return
	end
	-- marge de 6 studs pour la latence réseau
	if (root.Position - GhostService.positionOf(entry, now())).Magnitude > Config.BuyRange + 6 then
		AnnounceService.notify(player, "TooFar", nil, "bad")
		return
	end
	if not BaseService.findFreeSlot(player) then
		local message = if BaseService.floorsOf(player) < 2 then "NoFreePedestalFloor" else "NoFreePedestal"
		AnnounceService.notify(player, message, nil, "bad")
		return
	end
	local ghostKey = entry.GhostId
	local price = GhostData.priceOf(ghostKey)
	if not EconomyService.trySpend(player, price) then
		AnnounceService.notify(player, "NotEnoughCoins", nil, "bad")
		return
	end

	removeEntry(uid)
	local slot = GhostService.giveGhost(player, ghostKey)
	if not slot then
		EconomyService.add(player, price) -- ne devrait pas arriver : on rembourse
		return
	end
	AnnounceService.notify(player, "Bought", { ghost = ghostKey }, "good")
	AnnounceService.effect("Bought", { GhostId = ghostKey }, player)
	player:SetAttribute("HasBought", true)
	Hooks.fire("Buy", player, ghostKey)
	local _, mutation = GhostData.split(ghostKey)
	if mutation == "Rainbow" then
		AnnounceService.announce("AnnBigBuy", { player = player.DisplayName, ghost = ghostKey }, "rainbow")
	elseif Rarities.rank(ghost.Rarity) >= Rarities.rank("Legendary") then
		AnnounceService.announce("AnnBigBuy", { player = player.DisplayName, ghost = ghostKey }, string.lower(ghost.Rarity))
	end
end

local function onSell(player: Player, slot: any)
	if not Guard.isInt(slot, 1, Config.MaxPedestals) then
		return
	end
	if not Guard.rate(player, "Sell", 0.3) then
		return
	end
	local base = BaseService.getBase(player)
	local ghostId = BaseService.getGhost(player, slot)
	if not base or not ghostId or BaseService.isStolenOut(player, slot) then
		return
	end
	local root = Guard.root(player)
	if not root or (root.Position - BaseService.pedestalPosition(base, slot)).Magnitude > 16 then
		AnnounceService.notify(player, "TooFar", nil, "bad")
		return
	end
	EconomyService.collect(player, slot) -- on récupère d'abord les pièces du socle
	BaseService.removeGhost(player, slot)
	local value = math.floor(GhostData.priceOf(ghostId) * Config.SellRatio)
	EconomyService.add(player, value)
	AnnounceService.notify(player, "Sold", { coins = Format.short(value) }, "good")
	Hooks.fire("Sell", player, 1)
	AnnounceService.effect("Sold", { Position = BaseService.pedestalPosition(base, slot) })
end

function GhostService.start()
	folder = Instance.new("Folder")
	folder.Name = "PathGhosts"
	folder.Parent = ReplicatedStorage

	Remotes.get("BuyGhost").OnServerEvent:Connect(onBuy)
	Remotes.get("SellGhost").OnServerEvent:Connect(onSell)

	-- Boucle d'apparition
	task.spawn(function()
		-- quelques fantômes déjà en route au démarrage, pour ne pas avoir un chemin vide
		for i = 1, 5 do
			GhostService.spawn()
			local entry = entries[tostring(counter)]
			if entry then
				entry.SpawnTime -= i * (TRAVEL_TIME / 6)
				entry.Holder:SetAttribute("SpawnTime", entry.SpawnTime)
			end
		end
		while true do
			local interval = Config.PathSpawnInterval
			if GhostService.isNight() then
				interval /= 1.5 -- plus de fantômes la nuit
			end
			task.wait(interval)
			local t = now()
			for uid, entry in entries do
				if t - entry.SpawnTime > TRAVEL_TIME then
					removeEntry(uid)
				end
			end
			if count() < Config.MaxGhostsOnPath then
				GhostService.spawn()
			end
		end
	end)
end

return GhostService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Guard</string>
          <string name="Source"><![CDATA[--[[
	Guard : petites vérifications anti-triche utilisées par tous les services.
	- rate()  : empêche un joueur d'envoyer une demande trop souvent
	- isInt() : vérifie qu'une valeur envoyée par le client est un entier valide
	- root()  : renvoie le HumanoidRootPart d'un joueur vivant (ou nil)
]]

local Guard = {}

local lastCall: { [Player]: { [string]: number } } = {}

-- true si le joueur a le droit d'agir (pas plus d'une fois toutes les "interval" secondes)
function Guard.rate(player: Player, key: string, interval: number): boolean
	local now = os.clock()
	local calls = lastCall[player]
	if not calls then
		calls = {}
		lastCall[player] = calls
	end
	local last = calls[key]
	if last and now - last < interval then
		return false
	end
	calls[key] = now
	return true
end

function Guard.clear(player: Player)
	lastCall[player] = nil
end

function Guard.isInt(value: any, min: number, max: number): boolean
	return typeof(value) == "number" and value == value and value % 1 == 0 and value >= min and value <= max
end

function Guard.root(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Guard.humanoid(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

return Guard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Hooks</string>
          <string name="Source"><![CDATA[--[[
	Hooks : un petit "panneau d'affichage" d'événements entre services.
	Un service annonce qu'il s'est passé quelque chose (Hooks.fire("Steal", joueur)),
	et ceux que ça intéresse l'écoutent (Hooks.on("Steal", ...)), sans dépendre les uns
	des autres. Utilisé par les missions du jour.

	Événements : Buy (joueur, fantôme), Sell, Steal, Bonk, Lock, Earn (joueur, pièces),
	NightOutside (joueur, secondes passées dehors pendant la nuit)
]]

local Hooks = {}

local listeners: { [string]: { (...any) -> () } } = {}

function Hooks.on(name: string, callback: (...any) -> ())
	listeners[name] = listeners[name] or {}
	table.insert(listeners[name], callback)
end

function Hooks.fire(name: string, ...: any)
	for _, callback in listeners[name] or {} do
		task.spawn(callback, ...)
	end
end

return Hooks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">IndexService</string>
          <string name="Source"><![CDATA[--[[
	IndexService : le Fantômédex, la collection des 32 fantômes.
	  - un fantôme est "découvert" dès qu'il arrive dans ta base (achat, vol, cadeau, code)
	  - série complète (tous les fantômes d'une rareté) : des pièces en récompense
	  - tous les fantômes permanents trouvés : +10 % de revenus pour toujours
	La collection n'est jamais effacée, même par un rebirth.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local GhostData = require(Shared:WaitForChild("GhostData"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local AnnounceService = require(script.Parent.AnnounceService)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

local IndexService = {}

-- Envoie au joueur l'état de sa collection
function IndexService.sync(player: Player)
	local data = DataService.get(player)
	if not data then
		return
	end
	local found = {}
	for ghostId in data.Discovered do
		table.insert(found, ghostId)
	end
	Remotes.get("IndexInfo"):FireClient(player, {
		Discovered = found,
		Rewarded = data.IndexRewards,
		Complete = data.IndexComplete == true,
	})
end

local function isRarityComplete(data, rarity: string): boolean
	for _, ghost in GhostData.ByRarity[rarity] or {} do
		if not data.Discovered[ghost.Id] then
			return false
		end
	end
	return true
end

-- Vérifie les séries complètes et le Fantômédex complet
local function checkRewards(player: Player, data)
	for _, rarity in Rarities.Order do
		if not data.IndexRewards[rarity] and isRarityComplete(data, rarity) then
			data.IndexRewards[rarity] = true
			local coins = Config.IndexRewards[rarity] or 0
			EconomyService.add(player, coins, true)
			AnnounceService.notify(player, "IndexRarityDone", { rarity = rarity, coins = Format.short(coins) }, "good")
			AnnounceService.effect("Gift", {}, player)
		end
	end
	if not data.IndexComplete then
		for _, rarity in Rarities.Order do
			if not Rarities.Info[rarity].EventOnly and not data.IndexRewards[rarity] then
				return
			end
		end
		data.IndexComplete = true
		EconomyService.refresh(player)
		AnnounceService.notify(player, "IndexCompleteDone", { percent = math.floor(Config.IndexCompleteBonus * 100) }, "good")
		AnnounceService.announce("AnnIndexComplete", { player = player.DisplayName }, "legendary")
	end
end

-- Un fantôme arrive dans la base du joueur
function IndexService.discover(player: Player, ghostKey: string, silent: boolean?)
	local data = DataService.get(player)
	local ghostId = GhostData.split(ghostKey) -- la collection compte le fantôme, pas sa variante
	if not data or not GhostData.get(ghostId) or data.Discovered[ghostId] then
		return
	end
	data.Discovered[ghostId] = true
	if not silent then
		AnnounceService.notify(player, "IndexNew", { ghost = ghostId }, "info")
	end
	checkRewards(player, data)
	IndexService.sync(player)
end

-- À l'arrivée du joueur : on ajoute à la collection ce qu'il possède déjà (sans message)
function IndexService.setup(player: Player)
	local data = DataService.get(player)
	if not data then
		return
	end
	data.Discovered[Config.StarterGhost] = true
	for _, ghostKey in data.Slots do
		local ghostId = GhostData.split(ghostKey)
		if GhostData.get(ghostId) then
			data.Discovered[ghostId] = true
		end
	end
	checkRewards(player, data)
	IndexService.sync(player)
end

return IndexService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--[[
	LeaderboardService : le tableau des "plus grands voleurs de la semaine".
	  - chaque vol réussi ajoute +1 au voleur dans un classement Roblox partagé par
	    tous les serveurs (OrderedDataStore), remis à zéro chaque lundi 00h UTC
	  - toutes les minutes : on envoie les nouveaux vols et on relit le top 10
	  - le top 10 est publié dans un attribut de ReplicatedStorage, et chaque joueur
	    l'affiche sur le grand écran au-dessus du chemin
	Sans accès aux API (Studio), le tableau montre les vols de la partie en cours.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LeaderboardService = {}

local REFRESH = 60
local WEEK = 7 * 86400
local MONDAY_OFFSET = 4 * 86400 -- le 1er janvier 1970 était un jeudi

local pending: { [number]: number } = {} -- vols pas encore envoyés
local session: { [number]: number } = {} -- vols de cette partie (secours sans API)
local names: { [number]: string } = {}

function LeaderboardService.weekNumber(t: number?): number
	return ((t or os.time()) - MONDAY_OFFSET) // WEEK
end

function LeaderboardService.weekEndsAt(t: number?): number
	return (LeaderboardService.weekNumber(t) + 1) * WEEK + MONDAY_OFFSET
end

local function orderedStore(): OrderedDataStore?
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore("WeeklySteals_" .. LeaderboardService.weekNumber())
	end)
	return if ok then result else nil
end

function LeaderboardService.recordSteal(player: Player)
	local id = player.UserId
	names[id] = player.DisplayName
	pending[id] = (pending[id] or 0) + 1
	session[id] = (session[id] or 0) + 1
end

local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, result = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local name = if ok and result then result else "?"
	names[userId] = name
	return name
end

local function publish(list)
	ReplicatedStorage:SetAttribute("LeaderboardData", HttpService:JSONEncode(list))
	ReplicatedStorage:SetAttribute("LeaderboardResetAt", LeaderboardService.weekEndsAt())
end

-- Classement de secours : les vols de cette partie
local function sessionTop()
	local list = {}
	for userId, count in session do
		table.insert(list, { Name = nameOf(userId), Value = count, UserId = userId })
	end
	table.sort(list, function(a, b)
		return a.Value > b.Value
	end)
	while #list > 10 do
		table.remove(list)
	end
	return list
end

function LeaderboardService.refresh()
	local store = orderedStore()
	-- 1. on envoie les nouveaux vols
	if store then
		local ods = store :: OrderedDataStore
		for userId, count in pending do
			local ok = pcall(function()
				ods:IncrementAsync(tostring(userId), count)
			end)
			if ok then
				pending[userId] = nil
			end
		end
	end
	-- 2. on relit le top 10
	local list = nil
	if store then
		local ods = store :: OrderedDataStore
		local ok, page = pcall(function()
			return ods:GetSortedAsync(false, 10):GetCurrentPage()
		end)
		if ok and page then
			list = {}
			for _, entry in page do
				local userId = tonumber(entry.key) or 0
				table.insert(list, { Name = nameOf(userId), Value = entry.value, UserId = userId })
			end
		end
	end
	publish(list or sessionTop())
end

function LeaderboardService.start()
	publish({})
	task.spawn(function()
		task.wait(5)
		while true do
			LeaderboardService.refresh()
			task.wait(REFRESH)
		end
	end)
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--[[
	MapBuilder : construit toute la map avec du code au démarrage du serveur.
	  - le sol, le chemin hanté au centre, les 2 portails
	  - au milieu : la Roue de la Fortune (côté nord) et la Boutique (côté sud)
	  - 12 bases (6 de chaque côté du chemin) avec 10 socles par étage
	  - la déco Halloween (citrouilles, arbres morts, tombes, lanternes)
	  - l'ambiance (lumière, brume)

	Astuce : si tu veux modifier la map à la main dans Studio, lance le jeu, copie le
	dossier Workspace > Map, arrête le jeu et colle-le dans Workspace. Ce script
	verra qu'une map existe déjà et ne la reconstruira pas (garde bien les noms).
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local MapBuilder = {}

MapBuilder.BASE_WIDTH = 36
MapBuilder.BASE_DEPTH = 40
MapBuilder.BASE_Z = 37
MapBuilder.WALL_HEIGHT = 12
MapBuilder.FLOOR2_Y = 14 -- hauteur du sol de l'étage 2
MapBuilder.FLOOR2_WALL = 10
MapBuilder.BASE_XS = { -120, -76, -32, 32, 76, 120 } -- un espace au milieu pour la roue et la boutique
MapBuilder.FLOOR_Y = 0.6
MapBuilder.PEDESTAL_HEIGHT = 2
MapBuilder.PER_FLOOR = 10

-- Couleur de chaque base
MapBuilder.BASE_COLORS = {
	Color3.fromRGB(170, 110, 255),
	Color3.fromRGB(255, 150, 50),
	Color3.fromRGB(90, 220, 120),
	Color3.fromRGB(70, 200, 255),
	Color3.fromRGB(255, 110, 180),
	Color3.fromRGB(255, 220, 70),
	Color3.fromRGB(255, 90, 90),
	Color3.fromRGB(90, 120, 255),
	Color3.fromRGB(170, 240, 70),
	Color3.fromRGB(60, 220, 200),
	Color3.fromRGB(230, 90, 255),
	Color3.fromRGB(255, 180, 140),
}

local ROT_UP = CFrame.Angles(0, 0, math.rad(90))

-- Positions des socles dans une base : 5 à gauche, 5 à droite, une allée au milieu.
-- L'avant de la base (côté chemin) est en -Z. Socles 1-10 au rez-de-chaussée, 11-20 à l'étage.
-- Side = -1 (gauche) ou 1 (droite) : le fantôme regarde vers l'allée.
MapBuilder.PEDESTAL_SPOTS = {}
MapBuilder.ROW_Z = { -8, -2, 4, 10, 16 }
for floor = 1, 2 do
	for sideIndex, side in { -1, 1 } do
		for row, z in MapBuilder.ROW_Z do
			local slot = (floor - 1) * MapBuilder.PER_FLOOR + (sideIndex - 1) * 5 + row
			MapBuilder.PEDESTAL_SPOTS[slot] = { X = side * 13, Z = z, Side = side, Floor = floor }
		end
	end
end

local function part(props: { [string]: any }): BasePart
	local className = props.ClassName or "Part"
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local writable: any = p
	if props.Shape then
		writable.Shape = props.Shape -- la forme d'abord, la taille ensuite
	end
	for key, value in props do
		if key ~= "ClassName" and key ~= "Parent" and key ~= "Shape" then
			writable[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

-- Pièces de l'étage 2 : cachées tant que le joueur ne l'a pas acheté.
-- On retient leur apparence normale pour pouvoir les réafficher.
local function hideUntilBought(p: BasePart)
	p:SetAttribute("BaseTransparency", p.Transparency)
	p:SetAttribute("BaseCollide", p.CanCollide)
	p:SetAttribute("BaseTouch", p.CanTouch)
	p.Transparency = 1
	p.CanCollide = false
	p.CanTouch = false
	p:SetAttribute("Floor", 2)
end

-- Le repère d'une base : origine au centre du sol, -Z = vers le chemin
function MapBuilder.baseOrigin(index: number): CFrame
	local col = (index - 1) % 6 + 1
	local x = MapBuilder.BASE_XS[col]
	if index <= 6 then
		return CFrame.new(x, MapBuilder.FLOOR_Y, MapBuilder.BASE_Z)
	end
	return CFrame.new(x, MapBuilder.FLOOR_Y, -MapBuilder.BASE_Z) * CFrame.Angles(0, math.pi, 0)
end

local function wallSegment(parent: Instance, origin: CFrame, center: Vector3, size: Vector3, color: Color3, baseY: number?, glassOnly: boolean?)
	-- bas plein (3 studs) + haut en "verre fantôme" pour voir les fantômes à l'intérieur
	local y0 = baseY or 0
	local lowH = if glassOnly then 0 else 3
	local highH = (if glassOnly then MapBuilder.FLOOR2_WALL else MapBuilder.WALL_HEIGHT) - lowH
	local made = {}
	if lowH > 0 then
		table.insert(made, part({
			Name = "Wall",
			Size = Vector3.new(size.X, lowH, size.Z),
			CFrame = origin * CFrame.new(center.X, y0 + lowH / 2, center.Z),
			Color = color:Lerp(Color3.new(0, 0, 0), 0.35),
			Material = Enum.Material.Brick,
			Parent = parent,
		}))
	end
	table.insert(made, part({
		Name = "Glass",
		Size = Vector3.new(size.X, highH, size.Z),
		CFrame = origin * CFrame.new(center.X, y0 + lowH + highH / 2, center.Z),
		Color = color,
		Material = Enum.Material.Glass,
		Transparency = 0.75,
		CastShadow = false,
		Parent = parent,
	}))
	return made
end

-- Un socle + sa plaque de récolte (devant, côté allée)
local function buildPedestal(parent: Instance, origin: CFrame, index: number, slot: number, color: Color3)
	local spot = MapBuilder.PEDESTAL_SPOTS[slot]
	local floorY = if spot.Floor == 2 then MapBuilder.FLOOR2_Y else 0
	-- le fantôme regarde vers l'allée (vers +X à gauche, vers -X à droite)
	local facing = CFrame.Angles(0, spot.Side * math.pi / 2, 0)
	local top = origin * CFrame.new(spot.X, floorY + MapBuilder.PEDESTAL_HEIGHT, spot.Z) * facing
	local ped = part({
		Name = "P" .. slot,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(MapBuilder.PEDESTAL_HEIGHT, 5, 5),
		CFrame = origin * CFrame.new(spot.X, floorY + MapBuilder.PEDESTAL_HEIGHT / 2, spot.Z) * ROT_UP,
		Color = Color3.fromRGB(60, 50, 75),
		Material = Enum.Material.Slate,
		Parent = parent,
	})
	local rim = part({
		Name = "Rim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.15, 5.3, 5.3),
		CFrame = origin * CFrame.new(spot.X, floorY + MapBuilder.PEDESTAL_HEIGHT, spot.Z) * ROT_UP,
		Color = color,
		Material = Enum.Material.Neon,
		CanCollide = false,
		CastShadow = false,
		Parent = ped,
	})
	local pad = part({
		Name = "CollectPad",
		Size = Vector3.new(3.4, 0.3, 4.4),
		CFrame = origin * CFrame.new(spot.X - spot.Side * 4.8, floorY + 0.15, spot.Z),
		Color = Color3.fromRGB(80, 230, 120),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanTouch = true,
		CastShadow = false,
		Parent = ped,
	})
	ped:SetAttribute("Slot", slot)
	ped:SetAttribute("BaseIndex", index)
	ped:SetAttribute("GhostCFrame", top)
	ped:SetAttribute("GhostId", "")
	ped:SetAttribute("Stolen", false)
	ped:SetAttribute("Unlocked", false)
	ped:SetAttribute("Stored", 0)
	ped:SetAttribute("Floor", spot.Floor)
	if spot.Floor == 2 then
		hideUntilBought(ped)
		hideUntilBought(rim)
		hideUntilBought(pad)
	end
	return ped
end

function MapBuilder.buildBase(index: number, parent: Instance): Model
	local origin = MapBuilder.baseOrigin(index)
	local color = MapBuilder.BASE_COLORS[index]
	local w, d = MapBuilder.BASE_WIDTH, MapBuilder.BASE_DEPTH

	local model = Instance.new("Model")
	model.Name = "Base_" .. index

	local floor = part({
		Name = "Floor",
		Size = Vector3.new(w, 0.6, d),
		CFrame = origin * CFrame.new(0, -0.3, 0),
		Color = Color3.fromRGB(70, 55, 80),
		Material = Enum.Material.WoodPlanks,
		Parent = model,
	})
	model.PrimaryPart = floor

	-- Allée centrale (on y court entre les deux rangées de socles)
	part({
		Name = "Aisle",
		Size = Vector3.new(9, 0.05, d - 2),
		CFrame = origin * CFrame.new(0, 0.03, 0),
		Color = color:Lerp(Color3.new(0, 0, 0), 0.55),
		Material = Enum.Material.Fabric,
		CanCollide = false,
		CastShadow = false,
		Parent = model,
	})

	-- Murs du rez-de-chaussée (avec une entrée de 10 studs à l'avant)
	local walls = Instance.new("Folder")
	walls.Name = "Walls"
	walls.Parent = model
	wallSegment(walls, origin, Vector3.new(0, 0, d / 2), Vector3.new(w, 0, 1), color)
	wallSegment(walls, origin, Vector3.new(-w / 2, 0, 0), Vector3.new(1, 0, d), color)
	wallSegment(walls, origin, Vector3.new(w / 2, 0, 0), Vector3.new(1, 0, d), color)
	wallSegment(walls, origin, Vector3.new(-11.5, 0, -d / 2), Vector3.new(13, 0, 1), color)
	wallSegment(walls, origin, Vector3.new(11.5, 0, -d / 2), Vector3.new(13, 0, 1), color)

	-- Portique d'entrée + panneau avec le nom du propriétaire
	for _, x in { -5.5, 5.5 } do
		part({
			Name = "Post",
			Size = Vector3.new(1.2, 17, 1.2),
			CFrame = origin * CFrame.new(x, 8.5, -d / 2),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			Parent = model,
		})
	end
	part({
		Name = "Sign",
		Size = Vector3.new(14, 3.2, 0.8),
		CFrame = origin * CFrame.new(0, 16.4, -d / 2 - 0.6),
		Color = Color3.fromRGB(35, 25, 45),
		Material = Enum.Material.SmoothPlastic,
		Parent = model,
	})

	-- Tapis d'entrée (zone de dépôt des fantômes volés)
	part({
		Name = "Mat",
		Size = Vector3.new(9, 0.1, 5),
		CFrame = origin * CFrame.new(0, 0.06, -d / 2 + 4),
		Color = color,
		Material = Enum.Material.Fabric,
		CanCollide = false,
		CastShadow = false,
		Parent = model,
	})

	-- Point d'apparition du propriétaire
	local spawn = part({
		ClassName = "SpawnLocation",
		Name = "Spawn",
		Size = Vector3.new(6, 0.2, 6),
		CFrame = origin * CFrame.new(0, 0.1, -d / 2 + 9),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
		Neutral = true,
		Duration = 0,
		Enabled = true,
		Parent = model,
	})
	spawn:SetAttribute("BaseSpawn", true)

	-- Au fond : le poste de verrouillage (gros bouton + petite barrière rouge et blanche)
	local lockButton = part({
		Name = "LockButton",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 4, 4),
		CFrame = origin * CFrame.new(-3.2, 0.4, d / 2 - 4) * ROT_UP,
		Color = Color3.fromRGB(255, 70, 90),
		Material = Enum.Material.Neon,
		CastShadow = false,
		Parent = model,
	})
	lockButton:SetAttribute("BaseIndex", index)
	local lockStation = Instance.new("Folder")
	lockStation.Name = "LockStation"
	lockStation.Parent = model
	for _, x in { -6, -0.4 } do
		part({
			Name = "BarrierPost",
			Size = Vector3.new(0.6, 3.2, 0.6),
			CFrame = origin * CFrame.new(x, 1.6, d / 2 - 1.8),
			Color = Color3.fromRGB(240, 240, 240),
			Parent = lockStation,
		})
	end
	for i = 0, 3 do
		part({
			Name = "BarrierStripe",
			Size = Vector3.new(1.4, 0.6, 0.4),
			CFrame = origin * CFrame.new(-5.3 + i * 1.4, 2.7, d / 2 - 1.8),
			Color = if i % 2 == 0 then Color3.fromRGB(230, 40, 50) else Color3.fromRGB(250, 250, 250),
			Material = if i % 2 == 0 then Enum.Material.Neon else Enum.Material.SmoothPlastic,
			CastShadow = false,
			Parent = lockStation,
		})
	end

	-- Ascenseur vers l'étage 2 (au fond, à droite du bouton de verrou)
	part({
		Name = "UpPad",
		Size = Vector3.new(5, 0.3, 5),
		CFrame = origin * CFrame.new(3.2, 0.15, d / 2 - 4),
		Color = Color3.fromRGB(150, 90, 255),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanTouch = true,
		CastShadow = false,
		Parent = model,
	})

	-- Étage 2 (caché tant qu'il n'est pas acheté)
	local floor2 = Instance.new("Folder")
	floor2.Name = "Floor2"
	floor2.Parent = model
	local y2 = MapBuilder.FLOOR2_Y
	local platform = part({
		Name = "Floor2Platform",
		Size = Vector3.new(w, 1, d),
		CFrame = origin * CFrame.new(0, y2 - 0.5, 0),
		Color = Color3.fromRGB(70, 55, 80),
		Material = Enum.Material.WoodPlanks,
		Parent = floor2,
	})
	hideUntilBought(platform)
	local upperWalls = {}
	for _, info in {
		{ Vector3.new(0, 0, d / 2), Vector3.new(w, 0, 1) },
		{ Vector3.new(0, 0, -d / 2), Vector3.new(w, 0, 1) },
		{ Vector3.new(-w / 2, 0, 0), Vector3.new(1, 0, d) },
		{ Vector3.new(w / 2, 0, 0), Vector3.new(1, 0, d) },
	} do
		for _, p in wallSegment(floor2, origin, info[1], info[2], color, y2, true) do
			table.insert(upperWalls, p)
		end
	end
	for _, p in upperWalls do
		hideUntilBought(p)
	end
	local downPad = part({
		Name = "DownPad",
		Size = Vector3.new(5, 0.3, 5),
		CFrame = origin * CFrame.new(3.2, y2 + 0.15, d / 2 - 4),
		Color = Color3.fromRGB(150, 90, 255),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanTouch = true,
		CastShadow = false,
		Parent = floor2,
	})
	hideUntilBought(downPad)

	-- Socles (1-10 en bas, 11-20 à l'étage)
	local pedestals = Instance.new("Folder")
	pedestals.Name = "Pedestals"
	pedestals.Parent = model
	for slot = 1, MapBuilder.PER_FLOOR * 2 do
		buildPedestal(pedestals, origin, index, slot, color)
	end

	model:SetAttribute("Index", index)
	model:SetAttribute("Origin", origin)
	model:SetAttribute("Color", color)
	model:SetAttribute("OwnerUserId", 0)
	model:SetAttribute("OwnerName", "")
	model:SetAttribute("LockedUntil", 0)
	model:SetAttribute("LockReadyAt", 0)
	model:SetAttribute("Floors", 1)
	model.Parent = parent
	return model
end

local function pumpkin(parent: Instance, pos: Vector3, size: number)
	part({
		Name = "Pumpkin",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * size,
		CFrame = CFrame.new(pos + Vector3.new(0, size * 0.4, 0)),
		Color = Color3.fromRGB(255, 130, 20),
		Material = Enum.Material.SmoothPlastic,
		Parent = parent,
	})
	part({
		Name = "Stem",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(size * 0.3, size * 0.18, size * 0.18),
		CFrame = CFrame.new(pos + Vector3.new(0, size * 0.95, 0)) * ROT_UP,
		Color = Color3.fromRGB(70, 130, 40),
		CastShadow = false,
		Parent = parent,
	})
end

local function deadTree(parent: Instance, pos: Vector3, rng: Random)
	local h = rng:NextNumber(10, 16)
	local bark = Color3.fromRGB(60, 45, 40)
	part({
		Name = "Trunk",
		Size = Vector3.new(1.6, h, 1.6),
		CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0),
		Color = bark,
		Material = Enum.Material.Wood,
		Parent = parent,
	})
	for i = 1, 3 do
		local y = h * (0.5 + i * 0.13)
		local angle = rng:NextNumber(0, math.pi * 2)
		local len = rng:NextNumber(3, 6)
		part({
			Name = "Branch",
			Size = Vector3.new(len, 0.7, 0.7),
			CFrame = CFrame.new(pos + Vector3.new(0, y, 0))
				* CFrame.Angles(0, angle, math.rad(rng:NextNumber(20, 45)))
				* CFrame.new(len / 2, 0, 0),
			Color = bark,
			Material = Enum.Material.Wood,
			CastShadow = false,
			Parent = parent,
		})
	end
end

local function grave(parent: Instance, pos: Vector3, rng: Random)
	part({
		Name = "Grave",
		Size = Vector3.new(3, 4, 0.8),
		CFrame = CFrame.new(pos + Vector3.new(0, 1.8, 0)) * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), math.rad(rng:NextNumber(-8, 8))),
		Color = Color3.fromRGB(120, 120, 135),
		Material = Enum.Material.Slate,
		Parent = parent,
	})
end

local function lantern(parent: Instance, pos: Vector3, withLight: boolean)
	part({
		Name = "LanternPost",
		Size = Vector3.new(0.6, 7, 0.6),
		CFrame = CFrame.new(pos + Vector3.new(0, 3.5, 0)),
		Color = Color3.fromRGB(40, 35, 45),
		Material = Enum.Material.Metal,
		CastShadow = false,
		Parent = parent,
	})
	local head = part({
		Name = "Lantern",
		Size = Vector3.new(1.4, 1.6, 1.4),
		CFrame = CFrame.new(pos + Vector3.new(0, 7.6, 0)),
		Color = Color3.fromRGB(255, 190, 80),
		Material = Enum.Material.Neon,
		CastShadow = false,
		Parent = parent,
	})
	if withLight then
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 170, 80)
		light.Range = 18
		light.Brightness = 1.5
		light.Shadows = false
		light.Parent = head
	end
end

local function portal(parent: Instance, x: number, color: Color3)
	local z = Config.PathZ
	for _, dz in { -7, 7 } do
		part({
			Name = "PortalPillar",
			Size = Vector3.new(2, 14, 2),
			CFrame = CFrame.new(x, 7, z + dz),
			Color = Color3.fromRGB(45, 35, 60),
			Material = Enum.Material.Slate,
			Parent = parent,
		})
	end
	part({
		Name = "PortalTop",
		Size = Vector3.new(2.4, 2, 16),
		CFrame = CFrame.new(x, 14.5, z),
		Color = Color3.fromRGB(45, 35, 60),
		Material = Enum.Material.Slate,
		Parent = parent,
	})
	local swirl = part({
		Name = "PortalSwirl",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 12, 12),
		CFrame = CFrame.new(x, 7, z),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
		CastShadow = false,
		Parent = parent,
	})
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	e.Size = NumberSequence.new(0.6, 0)
	e.Speed = NumberRange.new(2, 4)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rate = 10
	e.Lifetime = NumberRange.new(1, 1.5)
	e.LightEmission = 1
	e.Parent = swirl
end

-- Le support de la Roue de la Fortune. La roue elle-même est dessinée par chaque joueur
-- (pour qu'elle tourne en douceur) autour de la pièce invisible "FortuneWheelAnchor".
MapBuilder.WHEEL_POSITION = Vector3.new(0, 11.5, 28)
local function wheelStand(parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "FortuneWheelStand"
	folder.Parent = parent
	local pos = MapBuilder.WHEEL_POSITION
	local dark = Color3.fromRGB(45, 35, 60)
	local gold = Color3.fromRGB(255, 200, 40)
	-- estrade ronde avec une marche
	part({
		Name = "WheelStage",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.2, 22, 22),
		CFrame = CFrame.new(pos.X, 0.6, pos.Z) * ROT_UP,
		Color = Color3.fromRGB(90, 50, 130),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	part({
		Name = "WheelStageRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.3, 22.6, 22.6),
		CFrame = CFrame.new(pos.X, 0.55, pos.Z) * ROT_UP,
		Color = gold,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Transparency = 0.4,
		Parent = folder,
	})
	-- deux pieds en A derrière la roue
	for _, side in { -1, 1 } do
		part({
			Name = "WheelLeg",
			Size = Vector3.new(1.4, pos.Y + 1, 1.4),
			CFrame = CFrame.new(pos.X + side * 4, pos.Y / 2 + 0.6, pos.Z + 1.6) * CFrame.Angles(0, 0, math.rad(side * -18)),
			Color = dark,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end
	part({
		Name = "WheelAxle",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.4, 1.8, 1.8),
		CFrame = CFrame.new(pos.X, pos.Y, pos.Z + 1.2) * CFrame.Angles(0, math.rad(90), 0),
		Color = gold,
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	-- la flèche rouge en haut qui montre la case gagnante
	part({
		ClassName = "WedgePart",
		Name = "WheelPointer",
		Size = Vector3.new(0.6, 2.2, 1.6),
		CFrame = CFrame.new(pos.X, pos.Y + 9.4, pos.Z - 0.9) * CFrame.Angles(math.rad(180), math.rad(90), 0),
		Color = gold,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = folder,
	})
	local anchor = part({
		Name = "FortuneWheelAnchor",
		Size = Vector3.one,
		CFrame = CFrame.new(pos),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = folder,
	})
	anchor:SetAttribute("SpinId", 0)
	-- l'endroit où on se met pour jouer (le bouton "Tourner" apparaît ici)
	part({
		Name = "WheelSpot",
		Size = Vector3.new(6, 0.3, 4),
		CFrame = CFrame.new(pos.X, 1.35, pos.Z - 7),
		Color = gold,
		Material = Enum.Material.Neon,
		Transparency = 0.3,
		CanCollide = false,
		Parent = folder,
	})
end

-- La Boutique : un stand avec un chaudron (on y achète armes, tours de roue, monstres...)
MapBuilder.SHOP_POSITION = Vector3.new(0, 0, -28)
local function shopStand(parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "ShopStand"
	folder.Parent = parent
	local pos = MapBuilder.SHOP_POSITION
	local wood = Color3.fromRGB(110, 70, 45)
	-- comptoir
	part({
		Name = "ShopCounter",
		Size = Vector3.new(14, 3.4, 3),
		CFrame = CFrame.new(pos.X, 1.7, pos.Z + 2),
		Color = wood,
		Material = Enum.Material.WoodPlanks,
		Parent = folder,
	})
	-- poteaux et toit rayé violet et orange
	for _, x in { -6.5, 6.5 } do
		part({
			Name = "ShopPost",
			Size = Vector3.new(0.9, 10, 0.9),
			CFrame = CFrame.new(pos.X + x, 5, pos.Z + 3.2),
			Color = wood,
			Material = Enum.Material.Wood,
			Parent = folder,
		})
	end
	for i = 0, 6 do
		part({
			Name = "ShopAwning",
			Size = Vector3.new(2, 0.4, 6),
			CFrame = CFrame.new(pos.X - 6 + i * 2, 10.4, pos.Z + 1.6) * CFrame.Angles(math.rad(-15), 0, 0),
			Color = if i % 2 == 0 then Color3.fromRGB(150, 70, 230) else Color3.fromRGB(255, 140, 40),
			Material = Enum.Material.Fabric,
			Parent = folder,
		})
	end
	-- le chaudron des monstres qui bouillonne
	part({
		Name = "Cauldron",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 4.6,
		CFrame = CFrame.new(pos.X + 9.5, 2.1, pos.Z + 1),
		Color = Color3.fromRGB(35, 30, 40),
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	local brew = part({
		Name = "CauldronBrew",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 3.8, 3.8),
		CFrame = CFrame.new(pos.X + 9.5, 3.6, pos.Z + 1) * ROT_UP,
		Color = Color3.fromRGB(120, 255, 90),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Color = ColorSequence.new(Color3.fromRGB(150, 255, 120))
	bubbles.Size = NumberSequence.new(0.6, 0)
	bubbles.Speed = NumberRange.new(2, 4)
	bubbles.Rate = 6
	bubbles.Lifetime = NumberRange.new(0.8, 1.2)
	bubbles.LightEmission = 0.6
	bubbles.Parent = brew
	-- le point où apparaît le bouton "Boutique"
	part({
		Name = "ShopSpot",
		Size = Vector3.new(14, 0.3, 4),
		CFrame = CFrame.new(pos.X, 0.15, pos.Z + 6),
		Color = Color3.fromRGB(255, 200, 40),
		Material = Enum.Material.Neon,
		Transparency = 0.5,
		CanCollide = false,
		Parent = folder,
	})
end

function MapBuilder.setupLighting()
	Lighting.ClockTime = 18.3
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(70, 60, 95)
	Lighting.OutdoorAmbient = Color3.fromRGB(120, 105, 150)
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.3
	Lighting.GlobalShadows = true

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(200, 170, 225)
	atmosphere.Decay = Color3.fromRGB(110, 90, 145)
	atmosphere.Glare = 0
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting

	local cc = Lighting:FindFirstChild("SAG_ColorCorrection") :: ColorCorrectionEffect?
	if not cc then
		local newCc = Instance.new("ColorCorrectionEffect")
		newCc.Name = "SAG_ColorCorrection"
		newCc.Parent = Lighting
		cc = newCc
	end
	local colorCorrection = cc :: ColorCorrectionEffect
	colorCorrection.Saturation = 0.15
	colorCorrection.Contrast = 0.05
	colorCorrection.TintColor = Color3.new(1, 1, 1)
end

function MapBuilder.build(): Model
	MapBuilder.setupLighting()

	local existing = workspace:FindFirstChild("Map")
	if existing and existing:FindFirstChild("Bases") then
		return existing :: Model
	end

	local map = Instance.new("Model")
	map.Name = "Map"
	local rng = Random.new(31102026)

	-- Sol
	part({
		Name = "Ground",
		Size = Vector3.new(380, 2, 180),
		CFrame = CFrame.new(0, -1, 0),
		Color = Color3.fromRGB(62, 82, 58),
		Material = Enum.Material.Grass,
		Parent = map,
	})

	-- Chemin hanté
	local pathLength = Config.PathEndX - Config.PathStartX + 20
	part({
		Name = "Path",
		Size = Vector3.new(pathLength, 0.3, 14),
		CFrame = CFrame.new((Config.PathStartX + Config.PathEndX) / 2, 0.15, Config.PathZ),
		Color = Color3.fromRGB(95, 85, 115),
		Material = Enum.Material.Cobblestone,
		Parent = map,
	})
	part({
		Name = "PathGlow",
		Size = Vector3.new(pathLength, 0.05, 1),
		CFrame = CFrame.new((Config.PathStartX + Config.PathEndX) / 2, 0.32, Config.PathZ),
		Color = Color3.fromRGB(160, 90, 255),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CastShadow = false,
		Parent = map,
	})

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = map

	-- Petites bougies le long du chemin
	for x = Config.PathStartX + 10, Config.PathEndX - 10, 20 do
		for _, z in { -7.6, 7.6 } do
			part({
				Name = "Candle",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1.4, 0.8, 0.8),
				CFrame = CFrame.new(x, 0.7, Config.PathZ + z) * ROT_UP,
				Color = Color3.fromRGB(245, 235, 210),
				CastShadow = false,
				Parent = decor,
			})
			part({
				Name = "CandleFlame",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 0.5,
				CFrame = CFrame.new(x, 1.6, Config.PathZ + z),
				Color = Color3.fromRGB(255, 170, 60),
				Material = Enum.Material.Neon,
				CanCollide = false,
				CastShadow = false,
				Parent = decor,
			})
		end
	end

	-- Grand écran du classement, suspendu au-dessus du milieu du chemin
	for _, z in { -8.6, 8.6 } do
		part({
			Name = "BoardPost",
			Size = Vector3.new(1.4, 32, 1.4),
			CFrame = CFrame.new(0, 16, Config.PathZ + z),
			Color = Color3.fromRGB(45, 35, 60),
			Material = Enum.Material.Metal,
			Parent = decor,
		})
	end
	part({
		Name = "Leaderboard",
		Size = Vector3.new(30, 15, 1),
		CFrame = CFrame.new(0, 27, Config.PathZ),
		Color = Color3.fromRGB(25, 15, 40),
		Material = Enum.Material.SmoothPlastic,
		CastShadow = false,
		Parent = map,
	})

	wheelStand(map)
	shopStand(map)

	portal(decor, Config.PathStartX - 5, Color3.fromRGB(150, 80, 255))
	portal(decor, Config.PathEndX + 5, Color3.fromRGB(80, 255, 170))

	-- Lanternes (seulement quelques vraies lumières : c'est meilleur pour les mobiles)
	for i, x in { -132, -88, -44, 0, 44, 88, 132 } do
		lantern(decor, Vector3.new(x, 0, 11), i % 2 == 1)
		lantern(decor, Vector3.new(x, 0, -11), i % 2 == 0)
	end

	-- Citrouilles, arbres morts et tombes autour de la map
	for _ = 1, 26 do
		local x = rng:NextNumber(-180, 180)
		local z = (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(62, 86)
		pumpkin(decor, Vector3.new(x, 0, z), rng:NextNumber(2, 5))
	end
	for _ = 1, 10 do
		local x = rng:NextNumber(-175, 175)
		local z = (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(64, 86)
		deadTree(decor, Vector3.new(x, 0, z), rng)
	end
	for _, x in { -168, -162, -172, 162, 168, 172 } do
		for _, z in { -20, -12, 12, 20 } do
			grave(decor, Vector3.new(x + rng:NextNumber(-2, 2), 0, z + rng:NextNumber(-2, 2)), rng)
		end
	end

	-- Murs invisibles autour de la map
	for _, info in {
		{ Vector3.new(0, 30, 91), Vector3.new(384, 60, 2) },
		{ Vector3.new(0, 30, -91), Vector3.new(384, 60, 2) },
		{ Vector3.new(191, 30, 0), Vector3.new(2, 60, 184) },
		{ Vector3.new(-191, 30, 0), Vector3.new(2, 60, 184) },
	} do
		part({
			Name = "Boundary",
			Size = info[2],
			CFrame = CFrame.new(info[1]),
			Transparency = 1,
			CastShadow = false,
			Parent = map,
		})
	end

	-- Point d'apparition neutre (au cas où)
	part({
		ClassName = "SpawnLocation",
		Name = "LobbySpawn",
		Size = Vector3.new(6, 0.2, 6),
		CFrame = CFrame.new(0, 0.4, Config.PathZ),
		Transparency = 1,
		CanCollide = false,
		Neutral = true,
		Duration = 0,
		Parent = map,
	})

	-- Les 12 bases
	local bases = Instance.new("Folder")
	bases.Name = "Bases"
	bases.Parent = map
	for index = 1, Config.BaseCount do
		MapBuilder.buildBase(index, bases)
	end

	map.Parent = workspace
	return map
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">MissionService</string>
          <string name="Source"><![CDATA[--[[
	MissionService : les missions du jour.
	  - 3 missions par joueur et par jour (facile, moyenne, difficile), qui changent à minuit UTC
	  - le serveur compte les progrès grâce aux événements de Hooks (achat, vol, vente...)
	  - mission réussie : pièces tout de suite ; les 3 réussies : un bonus en plus
	Les progrès sont sauvegardés avec le reste des données du joueur.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local GhostData = require(Shared:WaitForChild("GhostData"))
local Missions = require(Shared:WaitForChild("Missions"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local AnnounceService = require(script.Parent.AnnounceService)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local Hooks = require(script.Parent.Hooks)

local MissionService = {}

local dirty: { [Player]: boolean } = {}

local function today(): number
	return Missions.today(os.time())
end

function MissionService.sync(player: Player)
	local data = DataService.get(player)
	if not data or not data.Missions then
		return
	end
	dirty[player] = nil
	Remotes.get("MissionsInfo"):FireClient(player, {
		Day = data.Missions.Day,
		List = data.Missions.List,
		BonusDone = data.Missions.BonusDone,
		ResetAt = (data.Missions.Day + 1) * 86400,
	})
end

-- Donne de nouvelles missions si on a changé de jour. Renvoie true si c'est le cas.
function MissionService.ensure(player: Player): boolean
	local data = DataService.get(player)
	if not data then
		return false
	end
	local day = today()
	if type(data.Missions) == "table" and data.Missions.Day == day then
		return false
	end
	data.Missions = {
		Day = day,
		List = Missions.generate(day, player.UserId, EconomyService.incomePerSecond(player)),
		BonusDone = false,
	}
	return true
end

-- Est-ce que cet événement fait avancer cette mission ?
local function matches(mission, kind: string, info: any): boolean
	if mission.Id == kind then
		return true
	end
	if kind == "Buy" and (mission.Id == "BuyRare" or mission.Id == "BuyEpic") then
		local ghost = type(info) == "string" and GhostData.get(info)
		local minRarity = Missions.Defs[mission.Id].MinRarity
		return ghost ~= nil and ghost ~= false and Rarities.rank(ghost.Rarity) >= Rarities.rank(minRarity)
	end
	return false
end

local function progress(player: Player, kind: string, amount: number, info: any)
	local data = DataService.get(player)
	if not data then
		return
	end
	if MissionService.ensure(player) then
		dirty[player] = true
	end
	local completedOne = false
	for _, mission in data.Missions.List do
		if not mission.Done and matches(mission, kind, info) then
			-- "Buy" compte 1 fantôme acheté, sauf pour les missions qui demandent une rareté
			local step = if kind == "Buy" then 1 else amount
			mission.Progress = math.min(mission.Target, mission.Progress + step)
			dirty[player] = true
			if mission.Progress >= mission.Target then
				mission.Done = true
				completedOne = true
				local coins = Missions.reward(mission.Tier, EconomyService.incomePerSecond(player))
				EconomyService.add(player, coins)
				AnnounceService.notify(player, "MissionDone", { coins = Format.short(coins) }, "good")
				AnnounceService.effect("Gift", {}, player)
			end
		end
	end
	if completedOne and not data.Missions.BonusDone then
		local allDone = true
		for _, mission in data.Missions.List do
			if not mission.Done then
				allDone = false
			end
		end
		if allDone then
			data.Missions.BonusDone = true
			local coins = Missions.reward("bonus", EconomyService.incomePerSecond(player))
			EconomyService.add(player, coins)
			AnnounceService.notify(player, "MissionsAllDone", { coins = Format.short(coins) }, "good")
		end
	end
	if completedOne then
		MissionService.sync(player)
	end
end
MissionService.progress = progress

function MissionService.setup(player: Player)
	MissionService.ensure(player)
	MissionService.sync(player)
end

function MissionService.start()
	for _, kind in { "Buy", "Sell", "Steal", "Bonk", "Lock", "Earn", "NightOutside" } do
		Hooks.on(kind, function(player: Player, value: any)
			local amount = if type(value) == "number" then value else 1
			progress(player, kind, amount, value)
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
	end)
	-- Envoie les progrès aux joueurs (toutes les 2 s au plus) et change les missions à minuit
	task.spawn(function()
		local sinceDayCheck = 0
		while true do
			task.wait(2)
			sinceDayCheck += 2
			if sinceDayCheck >= 60 then
				sinceDayCheck = 0
				for _, player in Players:GetPlayers() do
					if MissionService.ensure(player) then
						dirty[player] = true
					end
				end
			end
			for player in dirty do
				if player.Parent then
					MissionService.sync(player)
				else
					dirty[player] = nil
				end
			end
		end
	end)
end

return MissionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--[[
	MonetizationService : tout ce qui s'achète avec des Robux (liste dans Shop.luau).
	  - Game Passes : x2 Pièces et les armes (Marteau Pouet, Balai, Aspira-Fantôme)
	  - Developer Products : pack de pièces, tours de Roue de la Fortune, monstres à lâcher

	Le joueur clique sur "Acheter" : le serveur vérifie, puis ouvre la fenêtre Robux.
	Dans Studio, un article dont l'ID vaut 0 est donné gratuitement (pour tester).
	Les tours de roue sont des "objets aléatoires payants" : ils ne sont jamais proposés
	aux joueurs des pays où c'est interdit (PolicyService).
	Les armes servent seulement à défendre : rien n'aide à voler.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Shop = require(Shared:WaitForChild("Shop"))

local AnnounceService = require(script.Parent.AnnounceService)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local Guard = require(script.Parent.Guard)
local MonsterService = require(script.Parent.MonsterService)
local WeaponService = require(script.Parent.WeaponService)
local WheelService = require(script.Parent.WheelService)

local MonetizationService = {}

local IS_STUDIO = RunService:IsStudio()

-- Pour les tests (le simulateur hors Roblox fait comme Studio si on le lui demande)
MonetizationService.studioMode = IS_STUDIO

function MonetizationService.coinPackAmount(player: Player): number
	local perMinute = EconomyService.incomePerSecond(player) * 60
	return math.max(Config.CoinPackMin, math.floor(perMinute * Config.CoinPackMinutes))
end

-- Les objets aléatoires payants sont-ils interdits pour ce joueur ?
local function checkRandomItems(player: Player)
	if MonetizationService.studioMode then
		player:SetAttribute("RandomItemsRestricted", false)
		return
	end
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	-- en cas de doute (erreur), on bloque : c'est la règle la plus sûre
	local restricted = not ok or type(info) ~= "table" or info.ArePaidRandomItemsRestricted ~= false
	player:SetAttribute("RandomItemsRestricted", restricted)
end

---------------------------------------------------------------- Donner les articles

local function grantPass(player: Player, item)
	player:SetAttribute(item.Attribute, true)
	if item.Weapon then
		WeaponService.onPassOwned(player)
	end
	EconomyService.refresh(player)
end

-- Donne un Developer Product. Renvoie true si c'est fait.
local function grantProduct(player: Player, item): boolean
	if item.Key == "CoinPack" then
		EconomyService.add(player, MonetizationService.coinPackAmount(player))
		return true
	elseif item.Spins then
		WheelService.addSpins(player, item.Spins)
		return true
	elseif item.Monster then
		return MonsterService.summon(player, item.Monster)
	end
	return false
end

local function thanks(player: Player)
	AnnounceService.notify(player, "ShopThanks", nil, "good")
	AnnounceService.effect("Gift", {}, player)
end

---------------------------------------------------------------- Achats

local function onShopBuy(player: Player, key: any)
	if not Guard.rate(player, "ShopBuy", 0.5) then
		return
	end
	local item = Shop.get(key)
	if not item then
		return
	end
	if item.Random and player:GetAttribute("RandomItemsRestricted") then
		AnnounceService.notify(player, "ShopRestricted", nil, "bad")
		return
	end
	if item.Kind == "Pass" and player:GetAttribute(item.Attribute) then
		AnnounceService.notify(player, "ShopOwned", nil, "info")
		return
	end
	local id = Shop.idOf(item, Config)
	if id == 0 then
		if MonetizationService.studioMode then
			-- mode test de Studio : gratuit
			if item.Kind == "Pass" then
				grantPass(player, item)
			else
				grantProduct(player, item)
			end
			AnnounceService.notify(player, "ShopStudioFree", nil, "info")
			AnnounceService.effect("Gift", {}, player)
		else
			AnnounceService.notify(player, "ShopSoon", nil, "info")
		end
		return
	end
	local ok, err = pcall(function()
		if item.Kind == "Pass" then
			MarketplaceService:PromptGamePassPurchase(player, id)
		else
			MarketplaceService:PromptProductPurchase(player, id)
		end
	end)
	if not ok then
		warn("[Monetization] Fenêtre d'achat impossible : " .. tostring(err))
	end
end

-- Achat d'un Developer Product : Roblox rappelle cette fonction jusqu'à ce qu'on
-- réponde "PurchaseGranted". On note chaque achat pour ne jamais créditer deux fois.
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and DataService.get(player)
	if not player or not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.Receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local item = Shop.fromId("Product", receipt.ProductId, Config)
	if not item then
		warn("[Monetization] Produit inconnu : " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not grantProduct(player, item) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > 50 do
		table.remove(data.Receipts, 1)
	end
	thanks(player)
	-- on sauvegarde tout de suite ; si ça échoue, Roblox réessaiera plus tard
	if DataService.save(player, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- Vérifie les Game Passes et les règles du pays à l'arrivée du joueur
function MonetizationService.setup(player: Player)
	checkRandomItems(player)
	for _, item in Shop.Items do
		if item.Kind == "Pass" then
			local passId = Shop.idOf(item, Config)
			if passId ~= 0 then
				local ok, owns = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
				end)
				if ok and owns then
					player:SetAttribute(item.Attribute, true)
				end
			end
		end
	end
end

function MonetizationService.start()
	MarketplaceService.ProcessReceipt = processReceipt
	Remotes.get("ShopBuy").OnServerEvent:Connect(onShopBuy)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local item = Shop.fromId("Pass", passId, Config)
		if item then
			grantPass(player, item)
			thanks(player)
		end
	end)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">MonsterService</string>
          <string name="Source"><![CDATA[--[[
	MonsterService : les monstres qui poursuivent les joueurs.
	  - Gloutrouille pendant la Nuit Hantée (lancé par NightService)
	  - les monstres lâchés avec des Robux : un seul à la fois, les suivants attendent
	    leur tour ; celui qui l'a lâché n'est jamais poursuivi ; pas de pièces perdues

	Les monstres n'entrent jamais dans les bases. Le serveur calcule leur position
	(anti-triche) et la publie sur une pièce invisible "<Id>Anchor" dans le Workspace.
	Chaque joueur dessine le vrai monstre et le fait glisser vers cette position.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Monsters = require(Shared:WaitForChild("Monsters"))

local AnnounceService = require(script.Parent.AnnounceService)
local BaseService = require(script.Parent.BaseService)
local EconomyService = require(script.Parent.EconomyService)
local Guard = require(script.Parent.Guard)
local StealService = require(script.Parent.StealService)

local MonsterService = {}

local TICK = 1 / 15
local CATCH_IMMUNITY = 6 -- secondes de répit après avoir été attrapé

export type Monster = {
	Id: string,
	Anchor: BasePart,
	Speed: number,
	CatchRange: number,
	Hover: number,
	Penalty: number,
	Summoner: Player?,
	EndsAt: number?,
	PatrolDir: number,
	OnEnd: (() -> ())?,
}

local active: { Monster } = {}
local immuneUntil: { [Player]: number } = {}
local queue: { { Id: string, Player: Player, Name: string } } = {}
local paidMonster: Monster? = nil

local function now(): number
	return workspace:GetServerTimeNow()
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Un point est-il interdit aux monstres ? (dans une base, avec une marge)
local function blocked(position: Vector3): boolean
	for _, base in BaseService.allBases() do
		local localPos = base.Origin:PointToObjectSpace(position)
		if math.abs(localPos.X) < 20 and math.abs(localPos.Z) < 18 then
			return true
		end
	end
	return false
end

-- La proie : le joueur le plus proche hors de sa base (les voleurs attirent plus)
local function pickTarget(monster: Monster, from: Vector3): (Player?, BasePart?)
	local t = os.clock()
	local best, bestRoot, bestScore = nil, nil, math.huge
	for _, player in Players:GetPlayers() do
		local root = Guard.root(player)
		if root and player ~= monster.Summoner and (immuneUntil[player] or 0) < t and not BaseService.baseAt(root.Position) then
			local score = (flat(root.Position) - flat(from)).Magnitude
			if player:GetAttribute("CarryGhost") then
				score *= 0.6
			end
			if score < bestScore then
				best, bestRoot, bestScore = player, root, score
			end
		end
	end
	return best, bestRoot
end

local function catch(monster: Monster, player: Player, root: BasePart)
	immuneUntil[player] = os.clock() + CATCH_IMMUNITY
	AnnounceService.effect("MonsterCatch", { Position = root.Position, PlayerId = player.UserId, Monster = monster.Id })
	if StealService.isCarrying(player) then
		StealService.failCarry(player, "Monster")
	end
	if monster.Penalty > 0 then
		local lost = EconomyService.takePercent(player, monster.Penalty)
		AnnounceService.notify(player, "MonsterCaughtYou", { coins = Format.short(lost) }, "bad")
	else
		AnnounceService.notify(player, "MonsterCaughtYouFree", { monster = monster.Id }, "bad")
	end
	AnnounceService.announce("AnnCaught", { player = player.DisplayName, monster = monster.Id }, "night")
	BaseService.teleportHome(player)
end

-- Un pas de déplacement d'un monstre
local function step(monster: Monster, dt: number)
	local part = monster.Anchor
	local pos = part.Position
	local target, root = pickTarget(monster, pos)
	local goal: Vector3
	if target and root then
		goal = Vector3.new(root.Position.X, monster.Hover, root.Position.Z)
		part:SetAttribute("TargetUserId", target.UserId)
	else
		-- personne dehors : il patrouille sur le chemin
		part:SetAttribute("TargetUserId", 0)
		if pos.X > Config.PathEndX - 20 then
			monster.PatrolDir = -1
		elseif pos.X < Config.PathStartX + 20 then
			monster.PatrolDir = 1
		end
		goal = Vector3.new(pos.X + monster.PatrolDir * 30, monster.Hover, Config.PathZ)
	end

	local offset = flat(goal - pos)
	local distance = offset.Magnitude
	if distance > 0.1 then
		local stepLength = math.min(distance, monster.Speed * dt)
		local dir = offset.Unit
		local candidate = pos + dir * stepLength
		-- il ne rentre jamais dans les bases : il glisse le long des murs
		if blocked(candidate) then
			local sideX = if dir.X >= 0 then 1 else -1
			local sideZ = if dir.Z >= 0 then 1 else -1
			local alongX = pos + Vector3.new(sideX, 0, 0) * stepLength
			local alongZ = pos + Vector3.new(0, 0, sideZ) * stepLength
			if not blocked(alongX) then
				candidate = alongX
			elseif not blocked(alongZ) then
				candidate = alongZ
			else
				candidate = pos
			end
		end
		candidate = Vector3.new(math.clamp(candidate.X, -180, 180), monster.Hover, math.clamp(candidate.Z, -80, 80))
		part.CFrame = CFrame.lookAt(candidate, candidate + dir)
	end

	if target and root then
		local gap = (flat(root.Position) - flat(part.Position)).Magnitude
		if gap <= monster.CatchRange + 3 then
			catch(monster, target, root)
		end
	end
end

--[[
	Fait apparaître un monstre. options :
	  Speed, CatchRange, Scale, Penalty (part des pièces perdues, 0 = rien),
	  Duration (nil = jusqu'à MonsterService.remove), Summoner (joueur jamais poursuivi)
]]
function MonsterService.spawn(id: string, options: { [string]: any }?): Monster
	local def = Monsters.get(id) or Monsters.ById.Gloutrouille
	local opts = options or {}
	local part = Instance.new("Part")
	part.Name = def.Id .. "Anchor"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.one
	-- il sort du portail de départ
	part.CFrame = CFrame.new(Config.PathStartX, def.Hover, Config.PathZ)
	part:SetAttribute("MonsterKind", def.Id)
	part:SetAttribute("Scale", opts.Scale or 1)
	part:SetAttribute("TargetUserId", 0)
	part:SetAttribute("SummonerName", if opts.Summoner then opts.Summoner.DisplayName else "")
	part:SetAttribute("SummonerId", if opts.Summoner then opts.Summoner.UserId else 0)
	local monster: Monster = {
		Id = def.Id,
		Anchor = part,
		Speed = opts.Speed or def.Speed,
		CatchRange = opts.CatchRange or def.CatchRange,
		Hover = def.Hover,
		Penalty = opts.Penalty or 0,
		Summoner = opts.Summoner,
		EndsAt = if opts.Duration then now() + opts.Duration else nil,
		PatrolDir = 1,
		OnEnd = opts.OnEnd,
	}
	if monster.EndsAt then
		part:SetAttribute("EndsAt", monster.EndsAt)
	end
	part.Parent = workspace
	table.insert(active, monster)
	return monster
end

function MonsterService.remove(monster: Monster)
	local index = table.find(active, monster)
	if index then
		table.remove(active, index)
	end
	if monster.Anchor.Parent then
		monster.Anchor:Destroy()
	end
	if monster.OnEnd then
		monster.OnEnd()
	end
end

function MonsterService.activeCount(): number
	return #active
end

---------------------------------------------------------------- Monstres achetés

local function startNextPaid()
	if paidMonster or #queue == 0 then
		return
	end
	local entry = table.remove(queue, 1) :: { Id: string, Player: Player, Name: string }
	local summoner = if entry.Player.Parent then entry.Player else nil
	local def = Monsters.get(entry.Id) or Monsters.ById.Gloutrouille
	AnnounceService.announce("AnnMonsterSummon", { player = entry.Name, monster = def.Id }, "night")
	AnnounceService.effect("MonsterSummon", { Monster = def.Id })
	paidMonster = MonsterService.spawn(def.Id, {
		Duration = def.Duration,
		Summoner = summoner,
		Penalty = 0,
		OnEnd = function()
			paidMonster = nil
			task.defer(startNextPaid)
		end,
	})
end

-- Un joueur a payé pour lâcher un monstre
function MonsterService.summon(player: Player, id: string): boolean
	local def = Monsters.get(id)
	if not def then
		return false
	end
	table.insert(queue, { Id = def.Id, Player = player, Name = player.DisplayName })
	if paidMonster then
		AnnounceService.notify(player, "MonsterQueued", { monster = def.Id, count = #queue }, "info")
	end
	startNextPaid()
	return true
end

function MonsterService.queueLength(): number
	return #queue
end

---------------------------------------------------------------- Boucle

function MonsterService.start()
	Players.PlayerRemoving:Connect(function(player)
		immuneUntil[player] = nil
	end)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(TICK)
			local clock = os.clock()
			local stepDt = math.min(clock - last, 0.2)
			last = clock
			local t = now()
			for _, monster in table.clone(active) do
				if monster.EndsAt and t >= monster.EndsAt then
					MonsterService.remove(monster)
				elseif monster.Anchor.Parent then
					step(monster, stepDt)
				end
			end
		end
	end)
end

return MonsterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">NightService</string>
          <string name="Source"><![CDATA[--[[
	NightService : la Nuit Hantée.
	  - toutes les 10 minutes : 8 min de jour, puis 2 min de nuit
	  - la nuit : plus de fantômes rares sur le chemin, un fantôme spécial garanti,
	    et Gloutrouille (le monstre) poursuit les joueurs qui sont HORS de leur base
	  - attrapé : "BOUH !", retour à la base, -5 % de pièces, et on lâche le fantôme volé
	  - chaque nuit a un thème : Classique, Brouillard (monstre plus rapide), Bonbons (des
	    pièces à ramasser sur le chemin), et le samedi soir la Super Nuit (monstre géant,
	    Mythique garanti, plus de variantes Dorées et Arc-en-ciel)

	Le monstre lui-même (poursuite, capture) est géré par MonsterService.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local GhostData = require(Shared:WaitForChild("GhostData"))

local AnnounceService = require(script.Parent.AnnounceService)
local BaseService = require(script.Parent.BaseService)
local EconomyService = require(script.Parent.EconomyService)
local GhostService = require(script.Parent.GhostService)
local Guard = require(script.Parent.Guard)
local Hooks = require(script.Parent.Hooks)
local MonsterService = require(script.Parent.MonsterService)

local NightService = {}

local TICK = 1 / 15

local theme = "Classic"
local candyFolder: Folder? = nil
local rng = Random.new()
local outsideTime: { [Player]: number } = {}

-- Mission du jour "reste dehors pendant la nuit" : on compte les secondes hors des bases
local function countOutside(dt: number)
	for _, player in Players:GetPlayers() do
		local root = Guard.root(player)
		if root and not BaseService.baseAt(root.Position) then
			outsideTime[player] = (outsideTime[player] or 0) + dt
			if outsideTime[player] >= 1 then
				outsideTime[player] -= 1
				Hooks.fire("NightOutside", player, 1)
			end
		end
	end
end

local function now(): number
	return workspace:GetServerTimeNow()
end

local function setState(active: boolean, endsAt: number, nextAt: number)
	ReplicatedStorage:SetAttribute("NightActive", active)
	ReplicatedStorage:SetAttribute("NightEndsAt", endsAt)
	ReplicatedStorage:SetAttribute("NextNightAt", nextAt)
end

function NightService.isNight(): boolean
	return ReplicatedStorage:GetAttribute("NightActive") == true
end

-- Est-ce l'heure de la Super Nuit ? (samedi 17h-18h UTC par défaut)
function NightService.isSuperTime(t: number?): boolean
	local date = os.date("!*t", t or os.time())
	local super = Config.SuperNight
	return date.wday == super.WeekDay and date.hour >= super.StartHour and date.hour < super.EndHour
end

local function pickTheme(): string
	if NightService.isSuperTime() then
		return "Super"
	end
	local total = 0
	for _, weight in Config.NightThemes do
		total += weight
	end
	local roll = rng:NextNumber() * total
	for _, name in { "Classic", "Fog", "Candy" } do
		roll -= Config.NightThemes[name] or 0
		if roll < 0 then
			return name
		end
	end
	return "Classic"
end

---------------------------------------------------------------- Nuit des Bonbons

local function coinReward(player: Player): number
	return math.max(25, math.floor(EconomyService.incomePerSecond(player) * Config.CandyCoinSeconds))
end

local function spawnCoin()
	local folder = candyFolder
	if not folder then
		return
	end
	-- sur le chemin ou les allées, jamais dans une base
	local position
	for _ = 1, 10 do
		local x = rng:NextNumber(Config.PathStartX + 10, Config.PathEndX - 10)
		local side = if rng:NextNumber() < 0.5 then -1 else 1
		local z = if rng:NextNumber() < 0.6 then rng:NextNumber(-6, 6) else side * rng:NextNumber(9, 13)
		local candidate = Vector3.new(x, 2, Config.PathZ + z)
		if not BaseService.baseAt(candidate) then
			position = candidate
			break
		end
	end
	if not position then
		return
	end
	local coin = Instance.new("Part")
	coin.Name = "CandyCoin"
	coin.Shape = Enum.PartType.Cylinder
	coin.Size = Vector3.new(0.4, 2.2, 2.2)
	coin.CFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(90), 0)
	coin.Anchored = true
	coin.CanCollide = false
	coin.CanQuery = false
	coin.CanTouch = true
	coin.CastShadow = false
	coin.Color = Color3.fromRGB(255, 205, 50)
	coin.Material = Enum.Material.Neon
	coin:SetAttribute("Base", coin.CFrame)
	local taken = false
	coin.Touched:Connect(function(hit)
		if taken then
			return
		end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player or not Guard.root(player) then
			return
		end
		taken = true
		local amount = coinReward(player)
		EconomyService.add(player, amount, true)
		AnnounceService.effect("CoinPickup", { Position = coin.Position, Amount = amount }, player)
		coin:Destroy()
		task.delay(3, spawnCoin) -- une nouvelle pièce apparaît ailleurs
	end)
	coin.Parent = folder
end

local function startCandy()
	local folder = Instance.new("Folder")
	folder.Name = "CandyCoins"
	folder.Parent = workspace
	candyFolder = folder
	for _ = 1, Config.CandyCoinCount do
		spawnCoin()
	end
end

local function stopCandy()
	if candyFolder then
		candyFolder:Destroy()
		candyFolder = nil
	end
end

local START_KEYS = { Classic = "NightStart", Fog = "NightStartFog", Candy = "NightStartCandy", Super = "NightStartSuper" }

local function runNight()
	theme = pickTheme()
	ReplicatedStorage:SetAttribute("NightTheme", theme)
	local endsAt = now() + Config.NightDuration
	setState(true, endsAt, endsAt + Config.DayDuration)
	AnnounceService.announce(START_KEYS[theme], nil, "night")
	AnnounceService.effect("NightStart", { Theme = theme })

	-- un fantôme spécial garanti au début de chaque nuit
	if GhostService.isEventActive() then
		local list = GhostData.ByRarity.Halloween
		GhostService.spawn(list[math.random(1, #list)].Id)
	else
		local list = GhostData.ByRarity.Legendary
		GhostService.spawn(list[math.random(1, #list)].Id)
	end
	if theme == "Super" then
		local list = GhostData.ByRarity.Mythic
		GhostService.spawn(list[math.random(1, #list)].Id)
		GhostService.mutationBoost = Config.SuperMutationBoost
	elseif theme == "Candy" then
		startCandy()
	end

	local monster = MonsterService.spawn("Gloutrouille", {
		Speed = if theme == "Fog" then Config.FogMonsterSpeed else Config.MonsterSpeed,
		CatchRange = if theme == "Super" then Config.MonsterCatchRange + 3 else Config.MonsterCatchRange,
		Scale = if theme == "Super" then Config.SuperMonsterScale else 1,
		Penalty = Config.MonsterCoinPenalty,
	})
	local last = os.clock()
	while now() < endsAt do
		task.wait(TICK)
		local t = os.clock()
		countOutside(math.min(t - last, 0.2))
		last = t
	end
	MonsterService.remove(monster)
	stopCandy()
	GhostService.mutationBoost = 1
end

function NightService.start()
	setState(false, 0, now() + Config.DayDuration)
	task.spawn(function()
		while true do
			local nextAt = ReplicatedStorage:GetAttribute("NextNightAt") or (now() + Config.DayDuration)
			-- jour : on attend, avec une alerte juste avant la nuit
			local warnAt = nextAt - Config.NightWarning
			if now() < warnAt then
				task.wait(warnAt - now())
			end
			AnnounceService.announce("NightSoon", { time = Format.time(Config.NightWarning) }, "night")
			if now() < nextAt then
				task.wait(nextAt - now())
			end
			runNight()
			setState(false, 0, now() + Config.DayDuration)
			AnnounceService.announce("NightEnd", nil, "info")
			AnnounceService.effect("NightEnd", {})
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		outsideTime[player] = nil
	end)
end

return NightService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">RebirthService</string>
          <string name="Source"><![CDATA[--[[
	RebirthService : recommencer à zéro contre un bonus permanent.
	  - coût : 5M, puis x3 à chaque rebirth (15M, 45M...)
	  - on perd les pièces et les fantômes (on garde le fantôme de départ et l'étage 2)
	  - on gagne +50 % de revenus pour toujours et une aura qui se voit
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local AnnounceService = require(script.Parent.AnnounceService)
local BaseService = require(script.Parent.BaseService)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local GhostService = require(script.Parent.GhostService)
local Guard = require(script.Parent.Guard)
local StealService = require(script.Parent.StealService)

local RebirthService = {}

-- Couleurs de l'aura selon le nombre de rebirths
local AURA_COLORS = {
	Color3.fromRGB(120, 255, 200),
	Color3.fromRGB(90, 170, 255),
	Color3.fromRGB(190, 110, 255),
	Color3.fromRGB(255, 200, 50),
	Color3.fromRGB(255, 70, 140),
}

function RebirthService.cost(rebirths: number): number
	return math.floor(Config.RebirthBaseCost * Config.RebirthCostGrowth ^ rebirths)
end

local function applyAura(player: Player)
	local data = DataService.get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not data or not root then
		return
	end
	local old = root:FindFirstChild("RebirthAura")
	if old then
		old:Destroy()
	end
	if data.Rebirths <= 0 then
		return
	end
	local color = AURA_COLORS[math.min(data.Rebirths, #AURA_COLORS)]
	local aura = Instance.new("ParticleEmitter")
	aura.Name = "RebirthAura"
	aura.Color = ColorSequence.new(color)
	aura.LightEmission = 1
	aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	aura.Transparency = NumberSequence.new(0.3, 1)
	aura.Speed = NumberRange.new(1, 2)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.Lifetime = NumberRange.new(0.8, 1.2)
	aura.Rate = 3 + math.min(data.Rebirths, 10) * 2
	aura.Parent = root
end

local function onRebirth(player: Player)
	if not Guard.rate(player, "Rebirth", 2) then
		return
	end
	local data = DataService.get(player)
	local base = BaseService.getBase(player)
	if not data or not base then
		return
	end
	if StealService.isCarrying(player) or StealService.isBeingStolenFrom(player) then
		AnnounceService.notify(player, "RebirthBusy", nil, "bad")
		return
	end
	local price = RebirthService.cost(data.Rebirths)
	if data.Coins < price then
		AnnounceService.notify(player, "RebirthNotEnough", { coins = Format.short(price) }, "bad")
		return
	end

	-- On remet tout à zéro...
	data.Coins = Config.StartCoins
	data.Rebirths += 1
	if not Config.RebirthKeepsFloors then
		data.Floors = 1
	end
	BaseService.clearAllGhosts(player)
	-- ...mais on garde un fantôme pour repartir tout de suite
	GhostService.giveGhost(player, Config.StarterGhost)
	BaseService.refreshSlots(player)
	EconomyService.refresh(player)
	applyAura(player)

	local mult = EconomyService.rebirthMultiplier(data.Rebirths)
	AnnounceService.notify(player, "RebirthDone", { mult = mult }, "good")
	AnnounceService.announce("AnnRebirth", { player = player.DisplayName, count = data.Rebirths }, "rebirth")
	AnnounceService.effect("Rebirth", { Position = base.Origin.Position, PlayerId = player.UserId })
	task.spawn(DataService.save, player, false)
end

function RebirthService.setup(player: Player)
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 10)
		applyAura(player)
	end)
end

function RebirthService.start()
	Remotes.get("Rebirth").OnServerEvent:Connect(onRebirth)
end

return RebirthService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">StealService</string>
          <string name="Source"><![CDATA[--[[
	StealService : voler un fantôme dans la base d'un autre joueur.

	Déroulé :
	  1. Le voleur maintient "Voler" 1,5 s sur un socle (le serveur chronomètre)
	  2. Le serveur vérifie tout (base pas verrouillée, distance, place libre...)
	  3. Le voleur porte le fantôme : ralenti, surligné en rouge pour tout le monde
	  4. Réussite : il entre dans SA base -> le fantôme change de propriétaire + annonce
	     Échec : le propriétaire le touche, un coup d'arme, 45 s écoulées, mort,
	             monstre de la Nuit Hantée -> le fantôme rentre chez lui
	  Pendant le vol, le fantôme reste sauvegardé chez son propriétaire (aucune perte
	  possible si un serveur plante).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local AnnounceService = require(script.Parent.AnnounceService)
local BaseService = require(script.Parent.BaseService)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local Guard = require(script.Parent.Guard)
local Hooks = require(script.Parent.Hooks)
local LeaderboardService = require(script.Parent.LeaderboardService)

local StealService = {}

type Carry = {
	Thief: Player,
	Owner: Player,
	Base: any,
	Slot: number,
	GhostId: string,
	StartedAt: number,
	WindowStart: number,
	WindowPos: Vector3,
	Violations: number,
}

local carries: { [Player]: Carry } = {}
local holdStarts: { [Player]: { BaseIndex: number, Slot: number, Time: number } } = {}
local stunnedUntil: { [Player]: number } = {}

local function setSpeed(player: Player, speed: number)
	local humanoid = Guard.humanoid(player)
	if humanoid then
		humanoid.WalkSpeed = speed
	end
end

local function normalSpeedFor(player: Player): number
	if (stunnedUntil[player] or 0) > os.clock() then
		return 4
	end
	return if carries[player] then Config.CarrierWalkSpeed else Config.NormalWalkSpeed
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function StealService.isCarrying(player: Player): boolean
	return carries[player] ~= nil
end

function StealService.isBeingStolenFrom(player: Player): boolean
	for _, carry in carries do
		if carry.Owner == player then
			return true
		end
	end
	return false
end

local function clearCarry(carry: Carry)
	carries[carry.Thief] = nil
	carry.Thief:SetAttribute("CarryGhost", nil)
	carry.Thief:SetAttribute("CarryOwner", nil)
	carry.Thief:SetAttribute("CarryUntil", nil)
	setSpeed(carry.Thief, normalSpeedFor(carry.Thief))
end

-- Le fantôme rentre chez son propriétaire. reason = "Timeout", "Caught", "Bonk", "Monster", "Died", "Left", "Cheat", "NoSpace"
function StealService.failCarry(thief: Player, reason: string, by: Player?)
	local carry = carries[thief]
	if not carry then
		return
	end
	clearCarry(carry)
	local owner = carry.Owner
	if owner.Parent and BaseService.getBase(owner) == carry.Base then
		BaseService.setStolenOut(owner, carry.Slot, false)
		EconomyService.refresh(owner)
		AnnounceService.notify(owner, "Recovered", { ghost = carry.GhostId }, "good")
		AnnounceService.effect("Recovered", { Position = BaseService.pedestalPosition(carry.Base, carry.Slot) })
	end

	local params = { ghost = carry.GhostId, owner = owner.DisplayName }
	if reason == "Timeout" then
		AnnounceService.notify(thief, "StealFailTimeout", params, "bad")
	elseif reason == "Caught" then
		AnnounceService.notify(thief, "StealFailCaught", params, "bad")
	elseif reason == "Bonk" then
		AnnounceService.notify(thief, "StealFailBonk", params, "bad")
		if by then
			AnnounceService.notify(by, "BonkHit", params, "good")
		end
	elseif reason == "Monster" then
		AnnounceService.notify(thief, "StealFailMonster", params, "bad")
	elseif reason == "NoSpace" then
		AnnounceService.notify(thief, "StealFailNoSpace", params, "bad")
	end
	if thief.Parent then
		AnnounceService.effect("StealFail", {}, thief)
	end
end

-- Le voleur est rentré dans sa base : le fantôme est à lui !
local function deliver(carry: Carry)
	local thief, owner = carry.Thief, carry.Owner
	if BaseService.getGhost(owner, carry.Slot) ~= carry.GhostId then
		clearCarry(carry) -- le fantôme n'existe plus chez le propriétaire : on annule sans rien donner
		return
	end
	local freeSlot = BaseService.findFreeSlot(thief)
	if not freeSlot then
		StealService.failCarry(thief, "NoSpace")
		return
	end
	clearCarry(carry)
	BaseService.removeGhost(owner, carry.Slot)
	BaseService.placeGhost(thief, carry.GhostId, freeSlot)

	local thiefData = DataService.get(thief)
	if thiefData then
		thiefData.TotalSteals += 1
	end
	LeaderboardService.recordSteal(thief)
	Hooks.fire("Steal", thief, 1)
	EconomyService.refresh(thief)
	EconomyService.refresh(owner)

	local thiefBase = BaseService.getBase(thief)
	AnnounceService.announce("AnnSteal", {
		thief = thief.DisplayName,
		owner = owner.DisplayName,
		ghost = carry.GhostId,
	}, "steal")
	AnnounceService.effect("StealSuccess", {
		Position = if thiefBase then BaseService.pedestalPosition(thiefBase, freeSlot) else nil,
		ThiefId = thief.UserId,
		OwnerId = owner.UserId,
		GhostId = carry.GhostId,
	})
end

local function onHoldBegin(player: Player, baseIndex: any, slot: any)
	if not Guard.isInt(baseIndex, 1, Config.BaseCount) or not Guard.isInt(slot, 1, Config.MaxPedestals) then
		return
	end
	-- limite très courte : un joueur peut relâcher et réappuyer vite sans être bloqué
	if not Guard.rate(player, "StealBegin", 0.05) then
		return
	end
	holdStarts[player] = { BaseIndex = baseIndex, Slot = slot, Time = os.clock() }
end

local function onSteal(player: Player, baseIndex: any, slot: any)
	if not Guard.isInt(baseIndex, 1, Config.BaseCount) or not Guard.isInt(slot, 1, Config.MaxPedestals) then
		return
	end
	if not Guard.rate(player, "Steal", 0.3) then
		return
	end
	-- Le maintien a-t-il vraiment duré assez longtemps ? (anti-triche)
	local hold = holdStarts[player]
	holdStarts[player] = nil
	if not hold or hold.BaseIndex ~= baseIndex or hold.Slot ~= slot then
		return
	end
	if os.clock() - hold.Time < Config.StealHoldDuration - 0.4 then
		return
	end

	if carries[player] then
		AnnounceService.notify(player, "AlreadyCarrying", nil, "bad")
		return
	end
	if not BaseService.getBase(player) or not DataService.get(player) then
		return
	end
	local base = BaseService.getBaseByIndex(baseIndex)
	local owner = base and base.Owner
	if not base or not owner or owner == player then
		return
	end
	if BaseService.isLocked(base) then
		AnnounceService.notify(player, "BaseIsLocked", nil, "bad")
		return
	end
	local ghostId = BaseService.getGhost(owner, slot)
	if not ghostId or BaseService.isStolenOut(owner, slot) then
		AnnounceService.notify(player, "AlreadyGone", nil, "bad")
		return
	end
	local root = Guard.root(player)
	if not root then
		return
	end
	if (root.Position - BaseService.pedestalPosition(base, slot)).Magnitude > Config.StealRange + 3 then
		AnnounceService.notify(player, "TooFar", nil, "bad")
		return
	end
	if not BaseService.findFreeSlot(player) then
		AnnounceService.notify(player, "NoFreePedestalThief", nil, "bad")
		return
	end

	-- C'est parti !
	local t = os.clock()
	BaseService.setStolenOut(owner, slot, true)
	carries[player] = {
		Thief = player,
		Owner = owner,
		Base = base,
		Slot = slot,
		GhostId = ghostId,
		StartedAt = t,
		WindowStart = t,
		WindowPos = flat(root.Position),
		Violations = 0,
	}
	player:SetAttribute("CarryGhost", ghostId)
	player:SetAttribute("CarryOwner", owner.UserId)
	player:SetAttribute("CarryUntil", workspace:GetServerTimeNow() + Config.StealTimeout)
	setSpeed(player, normalSpeedFor(player))
	EconomyService.refresh(owner)

	AnnounceService.notify(player, "StealGo", nil, "good")
	AnnounceService.notify(owner, "StealAlert", { thief = player.DisplayName, ghost = ghostId }, "bad")
	AnnounceService.effect("StealStart", {}, player)
	AnnounceService.effect("StealAlert", {}, owner)
end

-- Étourdit un joueur (il marche très lentement pendant "seconds" secondes)
function StealService.stun(player: Player, seconds: number)
	stunnedUntil[player] = os.clock() + seconds
	setSpeed(player, 4)
	task.delay(seconds, function()
		if player.Parent and (stunnedUntil[player] or 0) <= os.clock() then
			setSpeed(player, normalSpeedFor(player))
		end
	end)
end

function StealService.isStunned(player: Player): boolean
	return (stunnedUntil[player] or 0) > os.clock()
end

-- Annule un vol en préparation (le joueur maintenait "Voler" sur un socle)
function StealService.cancelHold(player: Player)
	holdStarts[player] = nil
end

-- Les voleurs en cours (pour les armes)
function StealService.thieves(): { Player }
	local list = {}
	for thief in carries do
		table.insert(list, thief)
	end
	return list
end

-- Vérifie tous les vols en cours (10 fois par seconde)
local function monitor()
	local t = os.clock()
	local list = {}
	for _, carry in carries do
		table.insert(list, carry)
	end
	for _, carry in list do
		local thief = carry.Thief
		local root = Guard.root(thief)
		if not root then
			StealService.failCarry(thief, "Died")
			continue
		end
		if t - carry.StartedAt > Config.StealTimeout then
			StealService.failCarry(thief, "Timeout")
			continue
		end
		-- Anti-triche vitesse : on mesure la distance parcourue chaque seconde
		if t - carry.WindowStart >= 1 then
			local elapsed = t - carry.WindowStart
			local speed = (flat(root.Position) - carry.WindowPos).Magnitude / elapsed
			if speed > Config.CarrierWalkSpeed * 1.35 + 2 then
				carry.Violations += 1
			else
				carry.Violations = 0
			end
			carry.WindowStart = t
			carry.WindowPos = flat(root.Position)
			if carry.Violations >= 2 then
				StealService.failCarry(thief, "Cheat")
				continue
			end
		end
		-- Arrivé dans sa base ?
		local thiefBase = BaseService.getBase(thief)
		if thiefBase and BaseService.isInside(thiefBase, root.Position) then
			deliver(carry)
			continue
		end
		-- Rattrapé par le propriétaire ?
		local ownerRoot = Guard.root(carry.Owner)
		if ownerRoot and (ownerRoot.Position - root.Position).Magnitude <= Config.RecoverRange then
			StealService.failCarry(thief, "Caught")
		end
	end
end

-- Appelé quand un joueur quitte le jeu (AVANT la sauvegarde de ses données)
function StealService.onPlayerRemoving(player: Player)
	holdStarts[player] = nil
	stunnedUntil[player] = nil
	-- Le voleur part : le fantôme rentre chez lui
	if carries[player] then
		StealService.failCarry(player, "Left")
	end
	-- Le propriétaire part pendant qu'on le vole : cadeau pour le voleur !
	for thief, carry in carries do
		if carry.Owner == player then
			local freeSlot = BaseService.findFreeSlot(thief)
			clearCarry(carry)
			if freeSlot and BaseService.getGhost(player, carry.Slot) == carry.GhostId then
				BaseService.removeGhost(player, carry.Slot)
				BaseService.placeGhost(thief, carry.GhostId, freeSlot)
				EconomyService.refresh(thief)
				AnnounceService.notify(thief, "OwnerLeftGift", { owner = player.DisplayName, ghost = carry.GhostId }, "good")
				AnnounceService.effect("Gift", {}, thief)
			end
		end
	end
end

function StealService.start()
	Remotes.get("StealBegin").OnServerEvent:Connect(onHoldBegin)
	Remotes.get("Steal").OnServerEvent:Connect(onSteal)
	Players.PlayerRemoving:Connect(function(player)
		-- sécurité si l'ordre des événements change
		if carries[player] then
			StealService.failCarry(player, "Left")
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.1)
			monitor()
		end
	end)
end

return StealService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">WeaponService</string>
          <string name="Source"><![CDATA[--[[
	WeaponService : les armes pour chasser les voleurs.
	  - chaque joueur reçoit la Batte à chaque apparition, plus les armes qu'il a achetées
	  - le joueur frappe (clic, touche Q ou bouton à l'écran) : le serveur vérifie tout
	    (arme possédée, temps de recharge, distance) et applique l'effet
	  - un voleur touché lâche le fantôme (il rentre chez lui), recule et est étourdi
	  - un intrus touché dans TA base est renvoyé dehors
	  - on ne peut pas frapper en portant un fantôme volé (les armes servent à défendre)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Weapons = require(Shared:WaitForChild("Weapons"))

local AnnounceService = require(script.Parent.AnnounceService)
local BaseService = require(script.Parent.BaseService)
local Guard = require(script.Parent.Guard)
local Hooks = require(script.Parent.Hooks)
local MapBuilder = require(script.Parent.MapBuilder)
local StealService = require(script.Parent.StealService)

local WeaponService = {}

local readyAt: { [Player]: number } = {}

-- Le joueur a-t-il cette arme ? (la Batte est offerte)
function WeaponService.owns(player: Player, weapon): boolean
	return weapon.Free == true or player:GetAttribute("Weapon_" .. weapon.Id) == true
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Met les armes du joueur dans son sac (sans doublon)
function WeaponService.giveTools(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	if not backpack then
		return
	end
	local character = player.Character
	for _, weapon in Weapons.List do
		if WeaponService.owns(player, weapon) then
			local has = false
			for _, container in { backpack, character } do
				if container then
					for _, child in container:GetChildren() do
						if child:IsA("Tool") and child:GetAttribute("WeaponId") == weapon.Id then
							has = true
						end
					end
				end
			end
			if not has then
				Weapons.buildTool(weapon.Id).Parent = backpack
			end
		end
	end
end

-- Pousse un joueur loin de "from" : le serveur l'étourdit, son écran le fait reculer
local function knock(target: Player, from: Vector3, weapon)
	local root = Guard.root(target)
	if not root then
		return
	end
	local away = flat(root.Position - from)
	local direction = if away.Magnitude > 0.1 then away.Unit else Vector3.new(0, 0, 1)
	AnnounceService.effect("Knockback", { Direction = direction, Power = weapon.Knock }, target)
end

-- Renvoie un intrus devant l'entrée de la base
local function pushOut(base, target: Player)
	local character = target.Character
	if character then
		character:PivotTo(base.Origin * CFrame.new(math.random(-4, 4), 3, -MapBuilder.BASE_DEPTH / 2 - 6))
	end
end

local function onSwing(player: Player, weaponId: any)
	if not Guard.rate(player, "Swing", 0.15) then
		return
	end
	local weapon = Weapons.get(weaponId) or Weapons.ById.Batte
	if not WeaponService.owns(player, weapon) then
		return
	end
	local t = os.clock()
	if (readyAt[player] or 0) > t or StealService.isCarrying(player) or StealService.isStunned(player) then
		return
	end
	local root = Guard.root(player)
	if not root then
		return
	end
	readyAt[player] = t + weapon.Cooldown
	-- les cibles possibles : voleurs à portée, intrus dans ma base
	local myBase = BaseService.getBase(player)
	local targets = {}
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local otherRoot = Guard.root(other)
			if otherRoot then
				local dist = (otherRoot.Position - root.Position).Magnitude
				local isThief = StealService.isCarrying(other)
				local isIntruder = myBase ~= nil and BaseService.isInside(myBase, otherRoot.Position)
				if dist <= weapon.Range + 1 and (isThief or isIntruder) then
					table.insert(targets, { Player = other, Dist = dist, Thief = isThief, Root = otherRoot })
				end
			end
		end
	end
	table.sort(targets, function(a, b)
		return a.Dist < b.Dist
	end)
	if not weapon.Sweep and #targets > 1 then
		targets = { targets[1] }
	end
	-- tout le monde voit le geste (et le rayon de l'aspirateur vers la cible)
	AnnounceService.effect("Swing", {
		PlayerId = player.UserId,
		Position = root.Position,
		Weapon = weapon.Id,
		Target = if targets[1] then targets[1].Root.Position else nil,
	})
	for _, target in targets do
		local other = target.Player
		AnnounceService.effect("Bonk", { Position = target.Root.Position, Weapon = weapon.Id, TargetId = other.UserId })
		if target.Thief then
			StealService.failCarry(other, "Bonk", player)
			Hooks.fire("Bonk", player, 1)
		else
			StealService.cancelHold(other)
			if myBase then
				pushOut(myBase, other)
			end
			AnnounceService.notify(other, "PushedOut", { player = player.DisplayName }, "bad")
		end
		StealService.stun(other, weapon.Stun)
		knock(other, root.Position, weapon)
	end
end

-- Un Game Pass d'arme vient d'être acheté (ou est déjà possédé à l'arrivée)
function WeaponService.onPassOwned(player: Player)
	WeaponService.giveTools(player)
end

-- Quand on porte un fantôme volé, on range ses armes (on ne peut pas frapper)
local function stowWhenCarrying(player: Player)
	if player:GetAttribute("CarryGhost") then
		local humanoid = Guard.humanoid(player)
		if humanoid then
			humanoid:UnequipTools()
		end
	end
end

function WeaponService.setup(player: Player)
	player:GetAttributeChangedSignal("CarryGhost"):Connect(function()
		stowWhenCarrying(player)
	end)
	player.CharacterAdded:Connect(function()
		-- le sac est recréé à chaque apparition
		task.defer(WeaponService.giveTools, player)
	end)
	if player.Character then
		WeaponService.giveTools(player)
	end
end

function WeaponService.start()
	Remotes.get("Bonk").OnServerEvent:Connect(onSwing)
	Players.PlayerRemoving:Connect(function(player)
		readyAt[player] = nil
	end)
end

return WeaponService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">WheelService</string>
          <string name="Source"><![CDATA[--[[
	WheelService : la Roue de la Fortune au milieu de la map.
	  - les tours s'achètent avec des Robux (voir MonetizationService) et sont sauvegardés
	  - le joueur demande à tourner : le SERVEUR tire la case gagnante (anti-triche)
	  - tout le serveur voit la roue tourner ; le gain est donné quand elle s'arrête
	  - une seule personne à la fois : la roue est partagée
	Les cases et leurs chances sont dans Wheel.luau.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local GhostData = require(Shared:WaitForChild("GhostData"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Wheel = require(Shared:WaitForChild("Wheel"))

local AnnounceService = require(script.Parent.AnnounceService)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local GhostService = require(script.Parent.GhostService)
local Guard = require(script.Parent.Guard)

local WheelService = {}

local anchor: BasePart? = nil
local busyUntil = 0
local rng = Random.new()
local pending: { [Player]: number } = {} -- case gagnée, pas encore donnée (la roue tourne)

local function now(): number
	return workspace:GetServerTimeNow()
end

local function syncSpins(player: Player)
	local data = DataService.get(player)
	if data then
		player:SetAttribute("Spins", data.Spins or 0)
	end
end

function WheelService.addSpins(player: Player, count: number)
	local data = DataService.get(player)
	if not data then
		return
	end
	data.Spins = (data.Spins or 0) + count
	syncSpins(player)
	AnnounceService.notify(player, "SpinsAdded", { count = count }, "good")
end

-- Donne le gain d'une case
local function grant(player: Player, index: number)
	local segment = Wheel.Segments[index]
	local data = DataService.get(player)
	if not segment or not data then
		return
	end
	if segment.Kind == "Coins" then
		local coins = Wheel.coins(segment, EconomyService.incomePerSecond(player))
		EconomyService.add(player, coins)
		AnnounceService.notify(player, "WheelWinCoins", { coins = Format.short(coins) }, "good")
	elseif segment.Kind == "Boost" then
		local t = os.time()
		data.BoostUntil = math.max(data.BoostUntil or 0, t) + segment.Seconds
		EconomyService.refresh(player)
		AnnounceService.notify(player, "WheelWinBoost", { mult = Config.WheelBoostMult, time = Format.time(segment.Seconds) }, "good")
		-- remet le revenu normal à la fin du boost
		task.delay(data.BoostUntil - t + 1, function()
			if player.Parent then
				EconomyService.refresh(player)
			end
		end)
	elseif segment.Kind == "Ghost" then
		local ghost = GhostData.pick(segment.Rarity, rng:NextNumber())
		local key = GhostData.key(ghost.Id, segment.Mutation)
		if GhostService.giveGhost(player, key) then
			AnnounceService.notify(player, "WheelWinGhost", { ghost = key }, "good")
		else
			-- base pleine : on paie le prix du fantôme en pièces
			local coins = GhostData.priceOf(key)
			EconomyService.add(player, coins)
			AnnounceService.notify(player, "WheelBaseFull", { ghost = key, coins = Format.short(coins) }, "good")
		end
		if segment.Rarity == "Legendary" or segment.Rarity == "Mythic" then
			AnnounceService.announce("AnnWheel", { player = player.DisplayName, ghost = key }, "rebirth")
		end
	end
	AnnounceService.effect("Gift", {}, player)
end

local function onSpin(player: Player)
	if not Guard.rate(player, "SpinWheel", 0.5) then
		return
	end
	local data = DataService.get(player)
	if not data or not anchor then
		return
	end
	if (data.Spins or 0) <= 0 then
		AnnounceService.notify(player, "WheelNoSpins", nil, "bad")
		return
	end
	if pending[player] then
		return
	end
	local t = os.clock()
	if t < busyUntil then
		AnnounceService.notify(player, "WheelBusy", { time = Format.time(busyUntil - t) }, "info")
		return
	end
	data.Spins -= 1
	syncSpins(player)
	local index = Wheel.pick(rng:NextNumber())
	pending[player] = index
	busyUntil = t + Wheel.SpinDuration + 0.5

	local wheel = anchor :: BasePart
	wheel:SetAttribute("SpinSegment", index)
	wheel:SetAttribute("SpinStart", now())
	wheel:SetAttribute("SpinOffset", rng:NextNumber(-0.3, 0.3))
	wheel:SetAttribute("SpinnerName", player.DisplayName)
	wheel:SetAttribute("SpinnerId", player.UserId)
	wheel:SetAttribute("SpinId", (wheel:GetAttribute("SpinId") or 0) + 1)

	task.delay(Wheel.SpinDuration, function()
		if pending[player] == index then
			pending[player] = nil
			if player.Parent then
				grant(player, index)
			end
		end
	end)
end

-- Le joueur part pendant que la roue tourne : on lui donne son gain avant la sauvegarde
function WheelService.onPlayerRemoving(player: Player)
	local index = pending[player]
	pending[player] = nil
	if index then
		grant(player, index)
	end
end

function WheelService.setup(player: Player)
	syncSpins(player)
end

function WheelService.init(map: Instance)
	anchor = map:FindFirstChild("FortuneWheelAnchor", true) :: BasePart?
	if not anchor then
		warn("[WheelService] Roue introuvable dans la map")
	end
end

function WheelService.start()
	Remotes.get("SpinWheel").OnServerEvent:Connect(onSpin)
end

return WheelService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="39">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="40">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="41">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Client : le point de départ côté joueur. Il démarre chaque "contrôleur"
	(interface, affichage des fantômes, effets...) dans le bon ordre.
]]

local Players = game:GetService("Players")

local player = Players.LocalPlayer
local Controllers = script.Parent:WaitForChild("Controllers")

-- On attend que le serveur ait préparé le joueur (données chargées, base attribuée)
if not player:GetAttribute("Ready") then
	player:GetAttributeChangedSignal("Ready"):Wait()
end

-- L'ordre compte : le HUD doit exister avant les modules qui y ajoutent des boutons
local ORDER = {
	"AnimView",
	"Effects",
	"HUD",
	"Announce",
	"PathView",
	"BaseView",
	"CarryView",
	"NightView",
	"MonsterView",
	"WeaponView",
	"LeaderboardView",
	"Panels",
	"CenterView",
	"Tutorial",
}

for _, name in ORDER do
	local module = require(Controllers:WaitForChild(name)) :: any
	if module.start then
		-- pcall : si un module plante, les autres démarrent quand même
		local ok, err = pcall(module.start)
		if not ok then
			warn("[Client] Erreur au démarrage de " .. name .. " : " .. tostring(err))
		end
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">AnimView</string>
            <string name="Source"><![CDATA[--[[
	AnimView : les gestes des personnages avec les objets.

	Coups d'arme : on utilise les animations OFFICIELLES de Roblox, déjà présentes dans
	chaque personnage (le script "Animate" que Roblox met dans tous les avatars). On lui
	envoie le message "toolanim" = "Slash" (coup d'épée classique) ou "Lunge" (coup en
	avant), exactement comme l'épée classique de Roblox. L'animation est jouée par le
	joueur qui frappe et Roblox la montre à tout le monde.

	En plus, pour tout le monde : traînée colorée derrière l'arme, et rayon vert de
	l'Aspira-Fantôme vers le voleur visé.

	Le voleur porte le fantôme bras levés : là, on pivote les épaules par le code
	(pas d'animation officielle pour ça). La position de repos de chaque épaule est
	gardée sur l'épaule elle-même (attribut "RestC0"), pour toujours y revenir.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared:WaitForChild("Weapons"))

local AnimView = {}

local rad = math.rad

---------------------------------------------------------------- Coups d'arme

local function toolOf(character: Model, weaponId: string): Tool?
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("WeaponId") == weaponId then
			return child
		end
	end
	return nil
end

-- Demande au script "Animate" de Roblox de jouer le coup ("Slash" ou "Lunge").
-- À faire sur l'écran du joueur qui frappe : c'est lui qui joue l'animation.
function AnimView.playToolAnim(tool: Tool, animName: string)
	local old = tool:FindFirstChild("toolanim")
	if old then
		old:Destroy()
	end
	local message = Instance.new("StringValue")
	message.Name = "toolanim"
	message.Value = animName
	message.Parent = tool
end

-- Traînée colorée derrière l'arme pendant le coup
local function flashTrail(character: Model, weaponId: string)
	local tool = toolOf(character, weaponId)
	local trail = tool and tool:FindFirstChild("SwingTrail", true) :: Trail?
	if trail then
		trail.Enabled = true
		task.delay(0.35, function()
			trail.Enabled = false
		end)
	end
end

-- Rayon vert de l'aspirateur, de l'arme jusqu'au voleur (ou droit devant)
local function vacuumBeam(character: Model, target: Vector3?)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local weapon = Weapons.ById.AspiraFantome
	local from = root.Position + root.CFrame.LookVector * 2 + Vector3.new(0, 0.6, 0)
	local to = target or (from + root.CFrame.LookVector * weapon.Range)
	local length = (to - from).Magnitude
	if length < 0.5 then
		return
	end
	local beam = Instance.new("Part")
	beam.Name = "VacuumBeam"
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.CastShadow = false
	beam.Material = Enum.Material.Neon
	beam.Color = Color3.fromRGB(weapon.Color[1], weapon.Color[2], weapon.Color[3])
	beam.Transparency = 0.35
	beam.Shape = Enum.PartType.Cylinder
	beam.Size = Vector3.new(length, 1.1, 1.1)
	beam.CFrame = CFrame.lookAt((from + to) / 2, to) * CFrame.Angles(0, rad(90), 0)
	beam.Parent = workspace
	TweenService:Create(beam, TweenInfo.new(0.45), { Transparency = 1, Size = Vector3.new(length, 0.2, 0.2) }):Play()
	Debris:AddItem(beam, 0.5)
end

local function characterOf(userId: any): Model?
	local other = type(userId) == "number" and Players:GetPlayerByUserId(userId)
	return other and other.Character or nil
end

--[[
	Les effets autour d'un coup d'arme (traînée, rayon de l'aspirateur).
	  trail = allume la traînée (mon propre coup l'allume tout de suite, sans attendre)
	  beam = dessine le rayon de l'aspirateur vers target (le voleur visé, ou droit devant)
]]
function AnimView.swing(character: Model?, weaponId: string, target: Vector3?, trail: boolean, beam: boolean)
	if not character then
		return
	end
	if trail then
		flashTrail(character, weaponId)
	end
	if beam and weaponId == "AspiraFantome" then
		vacuumBeam(character, target)
	end
end

function AnimView.swingByUserId(userId: any, weaponId: string, target: Vector3?, trail: boolean, beam: boolean)
	AnimView.swing(characterOf(userId), weaponId, target, trail, beam)
end

---------------------------------------------------------------- Porter le fantôme

local function findMotor(character: Model, names: { string }): Motor6D?
	for _, name in names do
		local found = character:FindFirstChild(name, true)
		if found and found:IsA("Motor6D") then
			return found
		end
	end
	return nil
end

-- Tourne une épaule (dans les axes du torse) ; nil = position de repos
local function pose(motor: Motor6D?, rotation: CFrame?)
	if not motor then
		return
	end
	local rest = motor:GetAttribute("RestC0")
	if rotation then
		if typeof(rest) ~= "CFrame" then
			rest = motor.C0
			motor:SetAttribute("RestC0", rest)
		end
		motor.C0 = CFrame.new(rest.Position) * rotation * rest.Rotation
	elseif typeof(rest) == "CFrame" then
		motor.C0 = rest
		motor:SetAttribute("RestC0", nil)
	end
end

function AnimView.start()
	local raised: { [Player]: boolean } = {}
	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		for _, other in Players:GetPlayers() do
			local character = other.Character
			local carrying = other:GetAttribute("CarryGhost") ~= nil
			if character and (carrying or raised[other]) then
				local right = findMotor(character, { "RightShoulder", "Right Shoulder" })
				local left = findMotor(character, { "LeftShoulder", "Left Shoulder" })
				if carrying then
					local wave = math.sin(now * 6) * 5
					pose(right, CFrame.Angles(rad(160 + wave), 0, rad(-10)))
					pose(left, CFrame.Angles(rad(160 - wave), 0, rad(10)))
					raised[other] = true
				else
					pose(right, nil)
					pose(left, nil)
					raised[other] = nil
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(other)
		raised[other] = nil
	end)
end

return AnimView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Announce</string>
            <string name="Source"><![CDATA[--[[
	Announce : les grandes annonces visibles par tout le serveur
	("Léo a volé Méga Bouh Cosmique à Inès !", apparition d'un Mythique...).
	Une bannière en haut de l'écran + un message dans le chat Roblox.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarities = require(Shared:WaitForChild("Rarities"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Effects = require(script.Parent.Effects)
local Lang = require(script.Parent.Lang)
local UI = require(script.Parent.UI)

local Announce = {}

local KIND_COLORS = {
	steal = Color3.fromRGB(255, 90, 90),
	mythic = Rarities.color("Mythic"),
	halloween = Rarities.color("Halloween"),
	legendary = Rarities.color("Legendary"),
	rainbow = Color3.fromRGB(255, 110, 230),
	rebirth = Color3.fromRGB(120, 255, 200),
	night = Color3.fromRGB(170, 110, 255),
	info = Color3.fromRGB(120, 190, 255),
}

local KIND_ICONS = {
	steal = "🦹",
	mythic = "🌟",
	halloween = "🎃",
	legendary = "✨",
	rainbow = "🌈",
	rebirth = "♻️",
	night = "🌙",
	info = "📣",
}

local gui: ScreenGui
local queue = {}
local showing = false

local function toHex(color: Color3): string
	return string.format("#%02X%02X%02X", math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255))
end

-- Message dans le chat (système de chat standard de Roblox)
local function chatMessage(text: string, color: Color3)
	task.spawn(function()
		local ok = pcall(function()
			local channels = TextChatService:FindFirstChild("TextChannels")
			local general = channels and channels:FindFirstChild("RBXGeneral") :: TextChannel?
			if general then
				general:DisplaySystemMessage(string.format('<font color="%s">%s</font>', toHex(color), text))
			end
		end)
		if not ok then
			-- pas grave : la bannière suffit
			return
		end
	end)
end

local function showNext()
	if showing or #queue == 0 then
		return
	end
	showing = true
	local item = table.remove(queue, 1)
	local color = KIND_COLORS[item.kind] or KIND_COLORS.info

	local banner = UI.new("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.3, 0),
		Size = UDim2.fromOffset(820, 92),
		BackgroundColor3 = UI.Colors.Panel,
		BackgroundTransparency = 0.05,
		Parent = gui,
	}, { UI.corner(22), UI.stroke(color, 5) })
	UI.label({
		Size = UDim2.new(1, -30, 1, -14),
		Position = UDim2.fromOffset(15, 7),
		Text = (KIND_ICONS[item.kind] or "📣") .. " " .. item.text,
		TextColor3 = color,
		MaxTextSize = 44,
		Parent = banner,
	})
	local scaler = UI.new("UIScale", { Scale = 0.2, Parent = banner })
	TweenService:Create(scaler, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Scale = 1 }):Play()

	task.delay(3.4, function()
		TweenService:Create(scaler, TweenInfo.new(0.25), { Scale = 0 }):Play()
		task.wait(0.3)
		banner:Destroy()
		showing = false
		showNext()
	end)
end

function Announce.show(text: string, kind: string?)
	table.insert(queue, { text = text, kind = kind or "info" })
	-- on ne garde pas une file trop longue
	while #queue > 4 do
		table.remove(queue, 1)
	end
	showNext()
end

function Announce.start()
	gui = UI.screen("SAG_Announce", 5)
	Remotes.get("Announce").OnClientEvent:Connect(function(key: string, params, kind: string)
		local text = Lang.t(key, params)
		Announce.show(text, kind)
		chatMessage(text, KIND_COLORS[kind] or KIND_COLORS.info)
		if kind == "mythic" or kind == "halloween" or kind == "rainbow" then
			Effects.sound("Mythic")
		end
	end)
end

return Announce
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">BaseView</string>
            <string name="Source"><![CDATA[--[[
	BaseView : affiche les bases de tout le monde.
	  - le panneau "TA BASE" / "Base de Léo" au-dessus de l'entrée
	  - les fantômes posés sur les socles (construits de notre côté, d'après les attributs)
	  - les boutons : "Voler" chez les autres, "Vendre" chez soi, "Verrouiller" sur le gros bouton
	  - la barrière du verrou : on peut la traverser dans SA base, pas chez les autres
	  - les pièces qui attendent au-dessus de chaque plaque verte
	  - l'ascenseur et l'achat de l'étage 2
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local GhostData = require(Shared:WaitForChild("GhostData"))
local GhostFactory = require(Shared:WaitForChild("GhostFactory"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Effects = require(script.Parent.Effects)
local Labels = require(script.Parent.Labels)
local Lang = require(script.Parent.Lang)
local UI = require(script.Parent.UI)

local BaseView = {}

local player = Players.LocalPlayer

type Slot = {
	Pedestal: BasePart,
	BaseModel: Model,
	BaseIndex: number,
	Slot: number,
	Model: Model?,
	Anchor: CFrame,
	Phase: number,
	Spin: number,
	Steal: ProximityPrompt,
	Sell: ProximityPrompt,
	Alert: BillboardGui?,
	StoredLabel: TextLabel?,
}

local slots: { Slot } = {}
local container: Folder

local function ownerOf(baseModel: Model): number
	return baseModel:GetAttribute("OwnerUserId") or 0
end

local function isMine(baseModel: Model): boolean
	return ownerOf(baseModel) == player.UserId
end

local function isLocked(baseModel: Model): boolean
	return workspace:GetServerTimeNow() < (baseModel:GetAttribute("LockedUntil") or 0)
end

---------------------------------------------------------------- Panneau d'entrée

local function setupSign(baseModel: Model)
	local sign = baseModel:WaitForChild("Sign") :: BasePart
	local surface = UI.new("SurfaceGui", {
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 40,
		LightInfluence = 0,
		AutoLocalize = Lang.autoLocalize,
		Adornee = sign,
		Parent = sign,
	})
	local text = UI.label({
		Size = UDim2.fromScale(0.94, 0.86),
		Position = UDim2.fromScale(0.03, 0.07),
		MaxTextSize = 90,
		Parent = surface,
	})
	-- Cadenas + chrono au-dessus du panneau quand la base est verrouillée
	local lockTag = Labels.simple(sign, "", UI.Colors.Info, Vector3.new(0, 3.2, 0), 8)
	lockTag.MaxDistance = 140

	local function refresh()
		local owner = ownerOf(baseModel)
		if owner == 0 then
			text.Text = Lang.t("FreeBase")
			text.TextColor3 = UI.Colors.Gray
		elseif owner == player.UserId then
			text.Text = "⭐ " .. Lang.t("YourBase") .. " ⭐"
			text.TextColor3 = UI.Colors.Gold
		else
			text.Text = Lang.t("BaseOf", { name = baseModel:GetAttribute("OwnerName") or "?" })
			text.TextColor3 = baseModel:GetAttribute("Color") or UI.Colors.Text
		end
	end
	baseModel:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh)
	baseModel:GetAttributeChangedSignal("OwnerName"):Connect(refresh)
	refresh()

	local label = lockTag:FindFirstChild("Text") :: TextLabel
	RunService.Heartbeat:Connect(function()
		local remaining = (baseModel:GetAttribute("LockedUntil") or 0) - workspace:GetServerTimeNow()
		if remaining > 0 and ownerOf(baseModel) ~= 0 then
			local icon = if baseModel:GetAttribute("Shield") then "🛡️ " else "🔒 "
			label.Text = icon .. Format.time(remaining)
			lockTag.Enabled = true
		else
			lockTag.Enabled = false
		end
	end)
end

---------------------------------------------------------------- Barrière du verrou

local OWNER_BARRIER_TRANSPARENCY = 0.85 -- chez moi, la barrière est presque invisible

local function setupBarrier(baseModel: Model)
	-- chez moi : je traverse la barrière et je la vois à peine (de mon côté seulement).
	-- Le serveur la rend déjà traversable pour moi avec les groupes de collision,
	-- ceci est une 2e sécurité et le côté visuel.
	local function soften(p: Instance)
		if p:IsA("BasePart") then
			p.CanCollide = false
			if p.Transparency < 1 then
				p.Transparency = OWNER_BARRIER_TRANSPARENCY
			end
		end
	end
	local function onChild(child: Instance)
		if child.Name == "Barrier" and isMine(baseModel) then
			soften(child)
			for _, p in child:GetDescendants() do
				soften(p)
			end
			-- les barreaux peuvent arriver un peu après le modèle
			child.DescendantAdded:Connect(soften)
		end
	end
	local function scan()
		for _, child in baseModel:GetChildren() do
			onChild(child)
		end
	end
	baseModel.ChildAdded:Connect(onChild)
	baseModel:GetAttributeChangedSignal("OwnerUserId"):Connect(scan)
	scan()
end

---------------------------------------------------------------- Bouton de verrouillage

local function setupLockButton(baseModel: Model)
	local button = baseModel:WaitForChild("LockButton") :: BasePart
	local attachment = Instance.new("Attachment")
	attachment.Position = button.CFrame:PointToObjectSpace(button.Position + Vector3.new(0, 2.5, 0))
	attachment.Parent = button
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = Lang.t("Lock")
	prompt.ObjectText = "🔒"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.AutoLocalize = Lang.autoLocalize
	prompt.Parent = attachment
	prompt.Triggered:Connect(function()
		Effects.sound("Click")
		Remotes.get("RequestLock"):FireServer()
	end)
	local function refresh()
		prompt.Enabled = isMine(baseModel)
	end
	baseModel:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh)
	refresh()
	-- panneau au-dessus du poste de verrouillage, au fond de la base
	local tag = Labels.simple(button, "🚧 " .. Lang.t("LockStation"), UI.Colors.Bad, Vector3.new(0, 5, 0), 6)
	tag.MaxDistance = 50
end

---------------------------------------------------------------- Ascenseur et étage 2

local function setupElevator(baseModel: Model)
	local upPad = baseModel:WaitForChild("UpPad") :: BasePart
	local tag = Labels.simple(upPad, "", UI.Colors.Purple, Vector3.new(0, 4, 0), 8)
	tag.MaxDistance = 50
	local text = tag:FindFirstChild("Text") :: TextLabel
	local floor2 = baseModel:WaitForChild("Floor2")
	local downPad = floor2:WaitForChild("DownPad") :: BasePart
	local downTag = Labels.simple(downPad, "⬇️ " .. Lang.t("FloorDown"), UI.Colors.Purple, Vector3.new(0, 4, 0), 8)
	downTag.MaxDistance = 40

	-- Acheter l'étage (seulement pour le propriétaire, tant qu'il n'est pas acheté)
	local attachment = Instance.new("Attachment")
	attachment.Position = upPad.CFrame:PointToObjectSpace(upPad.Position + Vector3.new(0, 2.5, 0))
	attachment.Parent = upPad
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = Lang.t("FloorBuy")
	prompt.ObjectText = "🪙 " .. Format.short(Config.FloorPrice)
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.AutoLocalize = Lang.autoLocalize
	prompt.Parent = attachment
	prompt.Triggered:Connect(function()
		Effects.sound("Click")
		Remotes.get("BuyFloor"):FireServer()
	end)

	local function refresh()
		local bought = baseModel:GetAttribute("Floors") == 2
		local owned = ownerOf(baseModel) ~= 0
		prompt.Enabled = isMine(baseModel) and not bought
		downTag.Enabled = bought
		tag.Enabled = owned
		if bought then
			text.Text = "⬆️ " .. Lang.t("FloorUp")
		else
			text.Text = "🔒 " .. Lang.t("FloorLocked", { coins = "🪙 " .. Format.short(Config.FloorPrice) })
		end
	end
	baseModel:GetAttributeChangedSignal("Floors"):Connect(refresh)
	baseModel:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh)
	refresh()
end

---------------------------------------------------------------- Socles

local function destroyGhost(slot: Slot)
	if slot.Model then
		slot.Model:Destroy()
		slot.Model = nil
	end
end

local function renderSlot(slot: Slot)
	local ped = slot.Pedestal
	local ghostId = ped:GetAttribute("GhostId") or ""
	local stolen = ped:GetAttribute("Stolen") == true
	local unlocked = ped:GetAttribute("Unlocked") == true
	local mine = isMine(slot.BaseModel)

	-- Fantôme sur le socle
	local currentId = slot.Model and slot.Model:GetAttribute("GhostId")
	if ghostId == "" or stolen then
		destroyGhost(slot)
	elseif currentId ~= ghostId then
		destroyGhost(slot)
		local model = GhostFactory.build(ghostId)
		local bottom = model:GetAttribute("Bottom") or 2
		slot.Anchor = (ped:GetAttribute("GhostCFrame") :: CFrame) * CFrame.new(0, bottom + 0.4, 0)
		slot.Spin = model:GetAttribute("Spin") or 1
		model:PivotTo(slot.Anchor)
		Labels.ghost(model.PrimaryPart :: BasePart, ghostId, "pedestal", model:GetAttribute("Top") or 2)
		model.Parent = container
		slot.Model = model
	end

	-- "!" rouge quand le fantôme est en train d'être volé
	if stolen and not slot.Alert then
		slot.Alert = Labels.simple(ped, "❗", UI.Colors.Bad, Vector3.new(0, 5, 0), 3)
	elseif not stolen and slot.Alert then
		slot.Alert:Destroy()
		slot.Alert = nil
	end

	-- Pièces qui attendent sur ce socle (au-dessus de la plaque verte)
	if slot.StoredLabel then
		local stored = ped:GetAttribute("Stored") or 0
		local label = slot.StoredLabel
		label.Text = "🪙 " .. Format.short(stored)
		label.TextColor3 = if mine then UI.Colors.Gold else UI.Colors.Text
		local storedGui = label.Parent :: BillboardGui
		storedGui.Enabled = stored >= 1 and unlocked
	end

	-- Texte du bouton "Vendre"
	local ghost = if ghostId ~= "" then GhostData.get(ghostId) else nil
	if ghost then
		slot.Sell.ActionText = Lang.t("SellFor", { coins = "🪙 " .. Format.short(math.floor(GhostData.priceOf(ghostId) * Config.SellRatio)) })
		slot.Sell.ObjectText = Lang.ghostName(ghostId)
		slot.Steal.ObjectText = Lang.ghostName(ghostId)
	end
end

-- Qui voit quel bouton ? (recalculé régulièrement, le serveur revérifie tout)
local function updatePrompts()
	local carrying = player:GetAttribute("CarryGhost") ~= nil
	for _, slot in slots do
		local ped = slot.Pedestal
		local hasGhost = (ped:GetAttribute("GhostId") or "") ~= "" and ped:GetAttribute("Stolen") ~= true
		local owner = ownerOf(slot.BaseModel)
		local mine = owner == player.UserId
		local stealOk = hasGhost and owner ~= 0 and not mine and not carrying and not isLocked(slot.BaseModel)
		if slot.Steal.Enabled ~= stealOk then
			slot.Steal.Enabled = stealOk
		end
		local sellOk = hasGhost and mine
		if slot.Sell.Enabled ~= sellOk then
			slot.Sell.Enabled = sellOk
		end
	end
end

local function makePrompt(parent: Instance, action: string, hold: number, range: number): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = range
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.AutoLocalize = Lang.autoLocalize
	prompt.Parent = parent
	return prompt
end

local function setupPedestal(baseModel: Model, ped: BasePart)
	local index = baseModel:GetAttribute("Index")
	local slotNumber = ped:GetAttribute("Slot")
	local top = ped:GetAttribute("GhostCFrame") :: CFrame

	local attachment = Instance.new("Attachment")
	attachment.Position = ped.CFrame:PointToObjectSpace(top.Position + Vector3.new(0, 2.5, 0))
	attachment.Parent = ped

	local steal = makePrompt(attachment, Lang.t("Steal"), Config.StealHoldDuration, Config.StealRange)
	local sell = makePrompt(attachment, Lang.t("Sell"), 1, 10)

	steal.PromptButtonHoldBegan:Connect(function()
		Remotes.get("StealBegin"):FireServer(index, slotNumber)
	end)
	steal.Triggered:Connect(function()
		Remotes.get("Steal"):FireServer(index, slotNumber)
	end)
	sell.Triggered:Connect(function()
		Remotes.get("SellGhost"):FireServer(slotNumber)
	end)

	local slot: Slot = {
		Pedestal = ped,
		BaseModel = baseModel,
		BaseIndex = index,
		Slot = slotNumber,
		Model = nil,
		Anchor = top,
		Phase = math.random() * math.pi * 2,
		Spin = 1,
		Steal = steal,
		Sell = sell,
		Alert = nil,
		StoredLabel = nil,
	}
	local pad = ped:FindFirstChild("CollectPad") :: BasePart?
	if pad then
		local storedTag = Labels.simple(pad, "", UI.Colors.Gold, Vector3.new(0, 2.2, 0), 5)
		storedTag.MaxDistance = 40
		storedTag.Enabled = false
		slot.StoredLabel = storedTag:FindFirstChild("Text") :: TextLabel
	end
	table.insert(slots, slot)

	local function refresh()
		renderSlot(slot)
	end
	ped:GetAttributeChangedSignal("GhostId"):Connect(refresh)
	ped:GetAttributeChangedSignal("Stolen"):Connect(refresh)
	ped:GetAttributeChangedSignal("Unlocked"):Connect(refresh)
	ped:GetAttributeChangedSignal("Stored"):Connect(refresh)
	baseModel:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh)
	refresh()
end

local function setupBase(baseModel: Model)
	task.spawn(setupSign, baseModel)
	task.spawn(setupLockButton, baseModel)
	task.spawn(setupElevator, baseModel)
	setupBarrier(baseModel)
	local pedestals = baseModel:WaitForChild("Pedestals")
	for _, ped in pedestals:GetChildren() do
		if ped:IsA("BasePart") then
			setupPedestal(baseModel, ped)
		end
	end
end

function BaseView.start()
	container = Instance.new("Folder")
	container.Name = "ClientBaseGhosts"
	container.Parent = workspace

	local map = workspace:WaitForChild("Map")
	local basesFolder = map:WaitForChild("Bases")
	for _, baseModel in basesFolder:GetChildren() do
		task.spawn(setupBase, baseModel)
	end

	-- Animation douce des fantômes proches (les lointains restent immobiles : économie de batterie)
	RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local camPos = camera.CFrame.Position
		local t = os.clock()
		for _, slot in slots do
			local model = slot.Model
			if model and (slot.Anchor.Position - camPos).Magnitude < 75 then
				local bob = math.sin(t * 2 + slot.Phase) * 0.3
				local turn = if slot.Spin > 1 then t * slot.Spin else math.sin(t * 0.8 + slot.Phase) * 0.35
				model:PivotTo(slot.Anchor * CFrame.new(0, bob, 0) * CFrame.Angles(0, turn, 0))
			end
		end
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.2 then
			accumulator = 0
			updatePrompts()
		end
	end)
end

return BaseView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">CarryView</string>
            <string name="Source"><![CDATA[--[[
	CarryView : affiche les voleurs.
	  - le fantôme volé flotte au-dessus de la tête du voleur
	  - le voleur est surligné en rouge, visible à travers les murs, avec "VOLEUR !"
	  - si c'est MOI qui vole : une ligne verte me guide jusqu'à ma base
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GhostFactory = require(Shared:WaitForChild("GhostFactory"))

local Lang = require(script.Parent.Lang)
local UI = require(script.Parent.UI)

local CarryView = {}

local player = Players.LocalPlayer

type Visual = {
	Player: Player,
	GhostId: string,
	Model: Model,
	Bottom: number,
	Highlight: Highlight?,
	Tag: BillboardGui?,
	Beam: Beam?,
	Attachments: { Attachment },
}

local visuals: { [Player]: Visual } = {}
local container: Folder

local function clear(target: Player)
	local visual = visuals[target]
	if not visual then
		return
	end
	visuals[target] = nil
	visual.Model:Destroy()
	if visual.Highlight then
		visual.Highlight:Destroy()
	end
	if visual.Tag then
		visual.Tag:Destroy()
	end
	if visual.Beam then
		visual.Beam:Destroy()
	end
	for _, attachment in visual.Attachments do
		attachment:Destroy()
	end
end

-- Ligne de guidage du voleur (moi) vers le tapis de ma base
local function addGuide(visual: Visual, character: Model)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local index = player:GetAttribute("BaseIndex")
	local map = workspace:FindFirstChild("Map")
	local basesFolder = map and map:FindFirstChild("Bases")
	local baseModel = basesFolder and index and basesFolder:FindFirstChild("Base_" .. index)
	local mat = baseModel and baseModel:FindFirstChild("Mat") :: BasePart?
	if not root or not mat then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, 1, 0)
	a1.Parent = mat
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(Color3.fromRGB(90, 255, 140))
	beam.Width0 = 1
	beam.Width1 = 2.5
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Transparency = NumberSequence.new(0.2)
	beam.Segments = 20
	beam.CurveSize0 = 8
	beam.Parent = root
	visual.Beam = beam
	visual.Attachments = { a0, a1 }
end

local function show(target: Player)
	clear(target)
	local ghostId = target:GetAttribute("CarryGhost")
	local character = target.Character
	if not ghostId or not character then
		return
	end
	local model = GhostFactory.build(ghostId)
	model:ScaleTo(0.8)
	model.Parent = container

	local visual: Visual = {
		Player = target,
		GhostId = ghostId,
		Model = model,
		Bottom = (model:GetAttribute("Bottom") or 2) * 0.8,
		Highlight = nil,
		Tag = nil,
		Beam = nil,
		Attachments = {},
	}

	local highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.fromRGB(255, 50, 60)
	highlight.FillTransparency = 0.55
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Adornee = character
	highlight.Parent = character
	visual.Highlight = highlight

	local head = character:FindFirstChild("Head") :: BasePart?
	if head and target ~= player then
		local tag = UI.new("BillboardGui", {
			Size = UDim2.fromOffset(200, 50),
			StudsOffsetWorldSpace = Vector3.new(0, 3, 0),
			AlwaysOnTop = true,
			LightInfluence = 0,
			MaxDistance = 1000,
			AutoLocalize = Lang.autoLocalize,
			Adornee = head,
			Parent = head,
		})
		UI.label({
			Size = UDim2.fromScale(1, 1),
			Text = "🚨 " .. Lang.t("ThiefLabel") .. " 🚨",
			TextColor3 = UI.Colors.Bad,
			MaxTextSize = 34,
			Parent = tag,
		})
		visual.Tag = tag
	end

	if target == player then
		addGuide(visual, character)
	end
	visuals[target] = visual
end

local function watch(target: Player)
	target:GetAttributeChangedSignal("CarryGhost"):Connect(function()
		show(target)
	end)
	target.CharacterAdded:Connect(function()
		clear(target)
	end)
	if target:GetAttribute("CarryGhost") then
		show(target)
	end
end

function CarryView.start()
	container = Instance.new("Folder")
	container.Name = "ClientCarried"
	container.Parent = workspace

	for _, target in Players:GetPlayers() do
		watch(target)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(clear)

	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for target, visual in visuals do
			local character = target.Character
			local head = character and character:FindFirstChild("Head") :: BasePart?
			if head then
				local wobble = math.sin(t * 6) * 0.15
				local pos = head.Position + Vector3.new(0, 1.2 + visual.Bottom + wobble, 0)
				visual.Model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, t * 1.5, math.sin(t * 4) * 0.15))
			end
		end
	end)
end

return CarryView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">CenterView</string>
            <string name="Source"><![CDATA[--[[
	CenterView : le milieu de la map côté joueur.
	  - la Roue de la Fortune : on la dessine, et on la fait tourner pour tout le monde
	    quand quelqu'un joue (le serveur a déjà choisi la case, on l'anime seulement)
	  - les boutons "Roue de la Fortune", "Boutique" et "Chaudron des monstres"
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Wheel = require(Shared:WaitForChild("Wheel"))

local Effects = require(script.Parent.Effects)
local Lang = require(script.Parent.Lang)
local Panels = require(script.Parent.Panels)
local UI = require(script.Parent.UI)

local CenterView = {}

local player = Players.LocalPlayer
local TWO_PI = 2 * math.pi

local wheelModel: Model? = nil
local anchor: BasePart? = nil
local angle = 0 -- angle actuel de la roue
local spin: { From: number, To: number, Start: number, Mine: boolean, Done: boolean }? = nil
local statusLabel: TextLabel? = nil

-- Petit texte sur chaque case
local function labelMaker(segment, holder: BasePart)
	local gui = UI.new("BillboardGui", {
		Name = "SegmentLabel",
		Size = UDim2.new(4.4, 0, 2.2, 0),
		LightInfluence = 0,
		MaxDistance = 120,
		AutoLocalize = Lang.autoLocalize,
		Adornee = holder,
		Parent = holder,
	})
	UI.label({
		Size = UDim2.fromScale(1, 1),
		Text = segment.Icon .. "\n" .. Lang.t("WheelShort_" .. segment.Id),
		MaxTextSize = 30,
		Parent = gui,
	})
end

local function place()
	if wheelModel and anchor then
		wheelModel:PivotTo(anchor.CFrame * CFrame.Angles(0, 0, angle))
	end
end

-- Angle final pour que la case "index" s'arrête sous la flèche (en haut)
local function finalAngle(index: number, offset: number): number
	return -Wheel.segmentAngle(index) + offset
end

local function onSpin()
	local wheelAnchor = anchor
	if not wheelAnchor then
		return
	end
	local index = wheelAnchor:GetAttribute("SpinSegment")
	local start = wheelAnchor:GetAttribute("SpinStart") or 0
	if type(index) ~= "number" then
		return
	end
	local target = finalAngle(index, wheelAnchor:GetAttribute("SpinOffset") or 0)
	local elapsed = workspace:GetServerTimeNow() - start
	if elapsed >= Wheel.SpinDuration then
		-- tour déjà fini (on vient d'arriver) : on se met directement sur la case
		angle = target
		place()
		return
	end
	-- 5 tours complets puis on ralentit jusqu'à la case
	local delta = (target - angle) % TWO_PI
	spin = {
		From = angle,
		To = angle + delta + 5 * TWO_PI,
		Start = start,
		Mine = wheelAnchor:GetAttribute("SpinnerId") == player.UserId,
		Done = false,
	}
	if statusLabel then
		statusLabel.Text = "🎡 " .. Lang.t("WheelSpinning", { player = wheelAnchor:GetAttribute("SpinnerName") or "?" })
	end
end

local function addPrompt(part: BasePart?, action: string, object: string, onTrigger: () -> ())
	if not part then
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, 3, 0)
	attachment.Parent = part
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.AutoLocalize = Lang.autoLocalize
	prompt.Parent = attachment
	prompt.Triggered:Connect(function()
		Effects.sound("Click")
		onTrigger()
	end)
end

local function bigSign(part: BasePart?, text: string, color: Color3, height: number)
	if not part then
		return nil
	end
	local gui = UI.new("BillboardGui", {
		Size = UDim2.fromOffset(340, 60),
		StudsOffsetWorldSpace = Vector3.new(0, height, 0),
		LightInfluence = 0,
		MaxDistance = 220,
		AutoLocalize = Lang.autoLocalize,
		Adornee = part,
		Parent = part,
	})
	return UI.label({
		Size = UDim2.fromScale(1, 1),
		Text = text,
		TextColor3 = color,
		MaxTextSize = 40,
		Parent = gui,
	})
end

function CenterView.start()
	local map = workspace:WaitForChild("Map")
	anchor = map:FindFirstChild("FortuneWheelAnchor", true) :: BasePart?
	if anchor then
		local model = Wheel.build(labelMaker)
		model.Parent = workspace
		wheelModel = model
		statusLabel = bigSign(anchor, "🎡 " .. Lang.t("WheelTitle"), UI.Colors.Gold, Wheel.Radius + 3)
		anchor:GetAttributeChangedSignal("SpinId"):Connect(onSpin)
		onSpin()
		place()
	end

	local stand = map:FindFirstChild("FortuneWheelStand")
	addPrompt(stand and stand:FindFirstChild("WheelSpot") :: BasePart?, Lang.t("WheelTitle"), "🎡", function()
		Panels.openShop("Wheel")
	end)
	local shop = map:FindFirstChild("ShopStand")
	local shopSpot = shop and shop:FindFirstChild("ShopSpot") :: BasePart?
	addPrompt(shopSpot, Lang.t("Shop"), "🛒", function()
		Panels.openShop("Weapons")
	end)
	bigSign(shop and shop:FindFirstChild("ShopCounter") :: BasePart?, "🛒 " .. string.upper(Lang.t("Shop")), UI.Colors.Orange, 11)
	local cauldron = shop and shop:FindFirstChild("Cauldron") :: BasePart?
	addPrompt(cauldron, Lang.t("MonstersTitle"), "👹", function()
		Panels.openShop("Monsters")
	end)

	local lastTick = 0
	RunService.RenderStepped:Connect(function()
		local current = spin
		if not current or current.Done then
			return
		end
		local p = math.clamp((workspace:GetServerTimeNow() - current.Start) / Wheel.SpinDuration, 0, 1)
		local eased = 1 - (1 - p) ^ 3
		local previous = angle
		angle = current.From + (current.To - current.From) * eased
		place()
		-- petit "tic" à chaque case qui passe
		local segmentSize = TWO_PI / #Wheel.Segments
		if math.floor(angle / segmentSize) ~= math.floor(previous / segmentSize) and os.clock() - lastTick > 0.05 then
			lastTick = os.clock()
			if current.Mine then
				Effects.sound("WheelTick")
			end
		end
		if p >= 1 then
			current.Done = true
			angle = current.To % TWO_PI
			if current.Mine then
				Effects.sound("WheelWin")
				if anchor then
					Effects.confetti(anchor.Position, 60)
				end
			end
			if statusLabel then
				statusLabel.Text = "🎡 " .. Lang.t("WheelTitle")
			end
		end
	end)
end

return CenterView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--[[
	Effects : les sons et les effets visuels (confettis, fumée, étoiles, secousses).
	Le serveur envoie "Effect" avec un type, et on joue l'effet ici.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Monsters = require(Shared:WaitForChild("Monsters"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Sounds = require(Shared:WaitForChild("Sounds"))
local Weapons = require(Shared:WaitForChild("Weapons"))

local AnimView = require(script.Parent.AnimView)

local Effects = {}

local player = Players.LocalPlayer

local CONFETTI_COLORS = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 160)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 230, 255)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(140, 255, 100)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 110, 255)),
})

local function playOnce(def, pitch: number)
	local sound = Instance.new("Sound")
	sound.SoundId = def.Id
	sound.Volume = def.Volume or 0.5
	sound.PlaybackSpeed = pitch
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 4)
end

-- Joue un son de la liste Sounds (ex. Effects.sound("Buy"))
function Effects.sound(name: string)
	local def = Sounds[name]
	if not def or def.Id == "" then
		return
	end
	if def.Jingle then
		task.spawn(function()
			for _, pitch in def.Jingle do
				playOnce(def, pitch)
				task.wait(0.09)
			end
		end)
	else
		playOnce(def, def.Pitch or 1)
	end
end

-- Musique en boucle (nuit, jour). Renvoie l'objet Sound pour pouvoir l'arrêter.
function Effects.music(name: string): Sound?
	local def = Sounds[name]
	if not def or def.Id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.SoundId = def.Id
	sound.Volume = def.Volume or 0.3
	sound.Looped = true
	sound.Parent = SoundService
	sound:Play()
	return sound
end

local function emitAt(position: Vector3, setup: (ParticleEmitter) -> (), count: number, lifetime: number?)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.CFrame = CFrame.new(position)
	holder.Parent = workspace
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	setup(emitter)
	emitter.Parent = holder
	emitter:Emit(count)
	Debris:AddItem(holder, lifetime or 3)
end

function Effects.confetti(position: Vector3, amount: number?)
	emitAt(position, function(e)
		e.Color = CONFETTI_COLORS
		e.Size = NumberSequence.new(0.35)
		e.Speed = NumberRange.new(18, 30)
		e.SpreadAngle = Vector2.new(60, 60)
		e.EmissionDirection = Enum.NormalId.Top
		e.Acceleration = Vector3.new(0, -35, 0)
		e.Drag = 1.5
		e.Lifetime = NumberRange.new(1.5, 2.2)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-300, 300)
		e.LightEmission = 0.4
	end, amount or 80)
end

function Effects.poof(position: Vector3, color: Color3?)
	emitAt(position, function(e)
		e.Color = ColorSequence.new(color or Color3.fromRGB(230, 220, 255))
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 0) })
		e.Transparency = NumberSequence.new(0.2, 1)
		e.Speed = NumberRange.new(4, 9)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Lifetime = NumberRange.new(0.5, 0.8)
	end, 25, 2)
end

function Effects.stars(position: Vector3)
	emitAt(position, function(e)
		e.Color = ColorSequence.new(Color3.fromRGB(255, 240, 80))
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
		e.Speed = NumberRange.new(8, 12)
		e.SpreadAngle = Vector2.new(180, 30)
		e.EmissionDirection = Enum.NormalId.Top
		e.Acceleration = Vector3.new(0, -10, 0)
		e.Lifetime = NumberRange.new(0.6, 0.9)
		e.LightEmission = 1
	end, 18, 2)
end

function Effects.coins(position: Vector3)
	emitAt(position, function(e)
		e.Color = ColorSequence.new(Color3.fromRGB(255, 210, 50))
		e.Size = NumberSequence.new(0.5)
		e.Speed = NumberRange.new(10, 16)
		e.SpreadAngle = Vector2.new(40, 40)
		e.EmissionDirection = Enum.NormalId.Top
		e.Acceleration = Vector3.new(0, -40, 0)
		e.Lifetime = NumberRange.new(0.8, 1.1)
		e.LightEmission = 0.6
	end, 20, 2)
end

-- Un "+1.2K" doré qui monte et disparaît (récolte des pièces)
function Effects.floatingText(position: Vector3, text: string)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.CFrame = CFrame.new(position)
	holder.Parent = workspace
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 60)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Adornee = holder
	gui.Parent = holder
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = Color3.fromRGB(255, 210, 60)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	TweenService:Create(gui, TweenInfo.new(1.1, Enum.EasingStyle.Quad), { StudsOffsetWorldSpace = Vector3.new(0, 6, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(1.1), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(holder, 1.2)
end

-- Petite secousse de caméra
function Effects.shake(strength: number?, duration: number?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local s = strength or 0.6
	local steps = math.floor((duration or 0.4) / 0.05)
	task.spawn(function()
		for _ = 1, steps do
			humanoid.CameraOffset = Vector3.new((math.random() - 0.5) * s, (math.random() - 0.5) * s, 0)
			task.wait(0.05)
		end
		TweenService:Create(humanoid, TweenInfo.new(0.1), { CameraOffset = Vector3.zero }):Play()
	end)
end

local function isNear(position: Vector3?, range: number): boolean
	if not position then
		return false
	end
	local camera = workspace.CurrentCamera
	return camera ~= nil and (camera.CFrame.Position - position).Magnitude <= range
end

-- Ce que fait chaque type d'effet envoyé par le serveur
local handlers: { [string]: (data: { [string]: any }) -> () } = {
	Placed = function(data)
		if data.Position then
			Effects.poof(data.Position + Vector3.new(0, 3, 0))
		end
	end,
	Bought = function()
		Effects.sound("Buy")
	end,
	Sold = function(data)
		if data.Position then
			Effects.coins(data.Position + Vector3.new(0, 2, 0))
			if isNear(data.Position, 40) then
				Effects.sound("Sell")
			end
		end
	end,
	Lock = function(data)
		if isNear(data.Position, 80) then
			Effects.sound("Lock")
		end
	end,
	StealStart = function()
		Effects.sound("StealStart")
	end,
	StealAlert = function()
		Effects.sound("StealAlert")
		Effects.shake(0.5, 0.5)
	end,
	StealSuccess = function(data)
		if data.Position then
			Effects.confetti(data.Position + Vector3.new(0, 3, 0), 120)
		end
		if data.ThiefId == player.UserId then
			Effects.sound("StealSuccess")
			Effects.shake(0.4, 0.3)
		elseif data.OwnerId == player.UserId then
			Effects.sound("StealFail")
		else
			Effects.sound("Buy")
		end
	end,
	StealFail = function()
		Effects.sound("StealFail")
	end,
	Recovered = function(data)
		if data.Position then
			Effects.poof(data.Position + Vector3.new(0, 3, 0), Color3.fromRGB(150, 255, 170))
		end
	end,
	Bonk = function(data)
		if data.Position then
			Effects.stars(data.Position + Vector3.new(0, 3, 0))
			if isNear(data.Position, 90) then
				local weapon = Weapons.get(data.Weapon)
				Effects.sound(if weapon then weapon.Sound else "Bonk")
			end
		end
	end,
	Swing = function(data)
		local mine = data.PlayerId == player.UserId
		-- mon propre coup est déjà animé et a déjà fait son bruit (tout de suite, sans attendre)
		if not mine and data.Position and isNear(data.Position, 50) then
			Effects.sound("Swing")
		end
		local target = if typeof(data.Target) == "Vector3" then data.Target else nil
		AnimView.swingByUserId(data.PlayerId, data.Weapon, target, not mine, true)
	end,
	-- J'ai pris un coup : je recule (c'est mon écran qui bouge mon personnage)
	Knockback = function(data)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and typeof(data.Direction) == "Vector3" then
			local power = math.clamp(tonumber(data.Power) or 40, 0, 120)
			root.AssemblyLinearVelocity = data.Direction * power + Vector3.new(0, 28, 0)
			Effects.shake(0.8, 0.3)
		end
	end,
	MonsterSummon = function()
		Effects.sound("MonsterSummon")
		Effects.shake(0.6, 0.5)
	end,
	Gift = function()
		Effects.sound("Gift")
	end,
	MonsterCatch = function(data)
		if data.Position then
			local monster = Monsters.get(data.Monster)
			local color = if monster then Color3.fromRGB(monster.Color[1], monster.Color[2], monster.Color[3]) else Color3.fromRGB(255, 140, 30)
			Effects.poof(data.Position, color)
		end
		if data.PlayerId == player.UserId then
			Effects.sound("MonsterCatch")
			Effects.shake(1.2, 0.6)
		end
	end,
	NightStart = function(data)
		Effects.sound("NightStart")
		if data.Theme == "Super" then
			Effects.shake(1.6, 1.2)
		else
			Effects.shake(0.8, 0.8)
		end
	end,
	Collect = function(data)
		if data.Position then
			Effects.coins(data.Position)
			Effects.floatingText(data.Position, "+" .. Format.short(data.Amount or 0))
		end
		Effects.sound("Sell")
	end,
	Elevator = function()
		Effects.sound("StealStart")
	end,
	CoinPickup = function(data)
		if data.Position then
			Effects.coins(data.Position)
		end
		Effects.sound("Sell")
	end,
	NightEnd = function()
		Effects.sound("NightEnd")
	end,
	Rebirth = function(data)
		if data.Position then
			Effects.confetti(data.Position + Vector3.new(0, 4, 0), 160)
		end
		if data.PlayerId == player.UserId then
			Effects.sound("Rebirth")
		end
	end,
}

function Effects.start()
	Remotes.get("Effect").OnClientEvent:Connect(function(kind: string, data: { [string]: any })
		local handler = handlers[kind]
		if handler then
			handler(data or {})
		end
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--[[
	HUD : l'interface principale, pensée d'abord pour le mobile.
	  - en haut : tes pièces et ton revenu par seconde
	  - à droite : gros boutons Verrou et Marteau Pouet
	  - au centre : petits messages (notifications) et chrono quand tu portes un fantôme
	Le HUD ne fait qu'AFFICHER et DEMANDER : toutes les décisions sont prises par le serveur.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Effects = require(script.Parent.Effects)
local Lang = require(script.Parent.Lang)
local UI = require(script.Parent.UI)

local HUD = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local toastList: Frame
local toastCount = 0

-- Colonnes de boutons (d'autres modules y ajoutent les leurs)
HUD.rightColumn = nil :: Frame?
HUD.leftColumn = nil :: Frame?
HUD.infoRow = nil :: Frame?
HUD.gui = nil :: ScreenGui?

local function myBase(): Model?
	local index = player:GetAttribute("BaseIndex")
	local map = workspace:FindFirstChild("Map")
	local bases = map and map:FindFirstChild("Bases")
	return bases and index and bases:FindFirstChild("Base_" .. index) :: Model?
end
HUD.myBase = myBase

---------------------------------------------------------------- Notifications

function HUD.toast(text: string, kind: string?)
	if not toastList then
		return
	end
	local color = if kind == "good" then UI.Colors.Good elseif kind == "bad" then UI.Colors.Bad else UI.Colors.Info
	toastCount += 1
	local frame = UI.new("Frame", {
		Name = "Toast",
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = UI.Colors.Panel,
		BackgroundTransparency = 0.08,
		LayoutOrder = toastCount,
		Parent = toastList,
	}, { UI.corner(12), UI.stroke(color, 3) })
	UI.label({
		Size = UDim2.new(1, -18, 1, -8),
		Position = UDim2.fromOffset(9, 4),
		Text = text,
		MaxTextSize = 26,
		Parent = frame,
	})
	UI.pop(frame)
	if kind == "bad" then
		Effects.sound("Error")
	end
	-- 3 messages maximum à l'écran
	local toasts = {}
	for _, child in toastList:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 1, #toasts - 3 do
		toasts[i]:Destroy()
	end
	task.delay(3.2, function()
		if frame.Parent then
			TweenService:Create(frame, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			for _, d in frame:GetDescendants() do
				if d:IsA("TextLabel") then
					TweenService:Create(d, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
				elseif d:IsA("UIStroke") then
					TweenService:Create(d, TweenInfo.new(0.3), { Transparency = 1 }):Play()
				end
			end
			task.wait(0.35)
			frame:Destroy()
		end
	end)
end

---------------------------------------------------------------- Construction

local coinLabel: TextLabel
local incomeLabel: TextLabel
local friendLabel: TextLabel
local lockPill: Frame
local lockText: TextLabel
local carryBanner: TextLabel
local shownCoins = 0

-- Petite pastille d'info (ex. minuteur de nuit) dans la ligne sous les pièces
function HUD.pill(color: Color3, order: number): Frame
	local pill = UI.new("Frame", {
		Name = "Pill",
		Size = UDim2.fromOffset(190, 34),
		BackgroundColor3 = UI.Colors.Panel,
		BackgroundTransparency = 0.1,
		LayoutOrder = order,
		Visible = false,
		Parent = HUD.infoRow,
	}, { UI.corner(17), UI.stroke(color, 2) })
	UI.label({
		Name = "Text",
		Size = UDim2.new(1, -12, 1, -6),
		Position = UDim2.fromOffset(6, 3),
		TextColor3 = color,
		MaxTextSize = 22,
		Parent = pill,
	})
	return pill
end

local function buildTopBar()
	local panel = UI.new("Frame", {
		Name = "Coins",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(300, 82),
		BackgroundColor3 = UI.Colors.Panel,
		BackgroundTransparency = 0.05,
		Parent = gui,
	}, { UI.corner(20), UI.stroke(UI.Colors.Gold, 3) })
	UI.label({
		Size = UDim2.fromOffset(60, 60),
		Position = UDim2.fromOffset(10, 4),
		Text = "🪙",
		MaxTextSize = 50,
		Parent = panel,
	})
	coinLabel = UI.label({
		Size = UDim2.new(1, -82, 0, 50),
		Position = UDim2.fromOffset(72, 2),
		Text = "0",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = UI.Colors.Gold,
		MaxTextSize = 46,
		Parent = panel,
	})
	incomeLabel = UI.label({
		Size = UDim2.new(1, -82, 0, 26),
		Position = UDim2.fromOffset(72, 52),
		Text = "+0/s",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = UI.Colors.Good,
		MaxTextSize = 24,
		Parent = panel,
	})
	-- Ligne d'infos sous les pièces (minuteur de nuit, bonus amis)
	HUD.infoRow = UI.new("Frame", {
		Name = "InfoRow",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 94),
		Size = UDim2.fromOffset(420, 34),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}),
	})
	local friendPill = HUD.pill(UI.Colors.Info, 2)
	friendLabel = friendPill:FindFirstChild("Text") :: TextLabel

	toastList = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 136),
		Size = UDim2.fromOffset(540, 160),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})

	carryBanner = UI.label({
		Name = "CarryBanner",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.82, 0),
		Size = UDim2.fromOffset(620, 54),
		Text = "",
		TextColor3 = UI.Colors.Gold,
		MaxTextSize = 44,
		Visible = false,
		Parent = gui,
	})
end

local function buildColumns()
	HUD.rightColumn = UI.new("Frame", {
		Name = "Right",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.42, 0),
		Size = UDim2.fromOffset(112, 360),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 12),
			VerticalAlignment = Enum.VerticalAlignment.Center,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})
	HUD.leftColumn = UI.new("Frame", {
		Name = "Left",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.47, 0),
		Size = UDim2.fromOffset(92, 430),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
			VerticalAlignment = Enum.VerticalAlignment.Center,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})
end

---------------------------------------------------------------- Mise à jour

local function updateCoins()
	local coins = player:GetAttribute("Coins") or 0
	local income = player:GetAttribute("Income") or 0
	if coins > shownCoins + math.max(income * 3, 50) then
		UI.pop(coinLabel)
	end
	shownCoins = coins
	coinLabel.Text = Format.short(coins)
	incomeLabel.Text = Lang.t("Income", { coins = Format.short(income) })
	local friends = player:GetAttribute("FriendBonus") or 0
	local pill = friendLabel.Parent :: Frame
	pill.Visible = friends > 0
	friendLabel.Text = "👥 " .. Lang.t("FriendsBonus", { percent = math.floor(friends * 100 + 0.5) })
end

-- Pastille d'état du verrou (on verrouille avec le bouton au fond de sa base, pas ici)
local function updateLock(now: number)
	local base = myBase()
	if not base then
		lockPill.Visible = false
		return
	end
	lockPill.Visible = true
	local lockedUntil = base:GetAttribute("LockedUntil") or 0
	local readyAt = base:GetAttribute("LockReadyAt") or 0
	if now < lockedUntil then
		local key = if base:GetAttribute("Shield") then "ShieldPill" else "LockPillOn"
		local icon = if base:GetAttribute("Shield") then "🛡️ " else "🔒 "
		lockText.Text = icon .. Lang.t(key, { time = Format.time(lockedUntil - now) })
	elseif now < readyAt then
		lockText.Text = "⏳ " .. Lang.t("LockPillCooldown", { time = Format.time(readyAt - now) })
	else
		lockText.Text = "🔒 " .. Lang.t("LockPillReady")
	end
end

local function updateCarry(now: number)
	local ghostId = player:GetAttribute("CarryGhost")
	if ghostId then
		local untilTime = player:GetAttribute("CarryUntil") or now
		carryBanner.Visible = true
		carryBanner.Text = "🏃 " .. Lang.t("StealGo") .. "  " .. Format.time(untilTime - now)
	else
		carryBanner.Visible = false
	end
end

function HUD.start()
	gui = UI.screen("SAG_HUD", 1)
	HUD.gui = gui
	buildTopBar()
	buildColumns()

	-- Pastille d'état du verrou
	lockPill = HUD.pill(UI.Colors.Info, -1)
	lockPill.Name = "LockPill"
	lockText = lockPill:FindFirstChild("Text") :: TextLabel

	-- Pastille "pièces à récupérer" (sur les plaques vertes de ta base)
	local storedPill = HUD.pill(UI.Colors.Good, 0)
	local storedText = storedPill:FindFirstChild("Text") :: TextLabel
	local function updateStored()
		local stored = player:GetAttribute("Stored") or 0
		storedPill.Visible = stored >= 1
		storedText.Text = "💰 " .. Lang.t("StoredPill", { coins = Format.short(stored) })
	end
	player:GetAttributeChangedSignal("Stored"):Connect(updateStored)
	updateStored()

	-- Pastille "Revenus x2" gagnée à la Roue de la Fortune
	local boostPill = HUD.pill(UI.Colors.Info, 2)
	boostPill.Name = "BoostPill"
	local boostText = boostPill:FindFirstChild("Text") :: TextLabel
	RunService.Heartbeat:Connect(function()
		local remaining = (player:GetAttribute("BoostUntil") or 0) - os.time()
		boostPill.Visible = remaining > 0
		if remaining > 0 then
			boostText.Text = "⚡ " .. Lang.t("BoostPill", { time = Format.time(remaining) })
		end
	end)

	-- Pastille "Week-end x2"
	local weekendPill = HUD.pill(UI.Colors.Gold, 3)
	local weekendText = weekendPill:FindFirstChild("Text") :: TextLabel
	weekendText.Text = "🎉 " .. Lang.t("WeekendBoost")
	local function updateWeekend()
		weekendPill.Visible = ReplicatedStorage:GetAttribute("WeekendBoost") == true
	end
	ReplicatedStorage:GetAttributeChangedSignal("WeekendBoost"):Connect(updateWeekend)
	updateWeekend()

	player:GetAttributeChangedSignal("Coins"):Connect(updateCoins)
	player:GetAttributeChangedSignal("Income"):Connect(updateCoins)
	player:GetAttributeChangedSignal("FriendBonus"):Connect(updateCoins)
	updateCoins()


	Remotes.get("Notify").OnClientEvent:Connect(function(key: string, params, kind: string)
		HUD.toast(Lang.t(key, params), kind)
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.1 then
			return
		end
		accumulator = 0
		local now = workspace:GetServerTimeNow()
		updateLock(now)
		updateCarry(now)
	end)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Labels</string>
            <string name="Source"><![CDATA[--[[
	Labels : les étiquettes au-dessus des fantômes (nom, rareté, prix, revenu).
	Elles sont créées par chaque joueur dans SA langue.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local GhostData = require(Shared:WaitForChild("GhostData"))
local Rarities = require(Shared:WaitForChild("Rarities"))

local Lang = require(script.Parent.Lang)
local UI = require(script.Parent.UI)

local Labels = {}

-- mode = "path" (prix + revenu) ou "pedestal" (revenu seulement)
function Labels.ghost(adornee: BasePart, ghostId: string, mode: string, height: number): BillboardGui
	local ghost = GhostData.get(ghostId)
	local rarityColor = Rarities.color(ghost.Rarity)

	local gui = UI.new("BillboardGui", {
		Name = "GhostLabel",
		Size = UDim2.new(9, 0, 2.6, 0), -- en studs : grossit/rapetisse avec la distance
		StudsOffsetWorldSpace = Vector3.new(0, height + 1.7, 0),
		LightInfluence = 0,
		MaxDistance = if mode == "path" then 85 else 45,
		AutoLocalize = Lang.autoLocalize,
		Adornee = adornee,
	})
	UI.label({
		Name = "GhostName",
		Size = UDim2.fromScale(1, 0.4),
		Text = Lang.ghostName(ghostId),
		MaxTextSize = 60,
		Parent = gui,
	})
	local rarityText = string.upper(Lang.rarityName(ghost.Rarity))
	local mutation = GhostData.mutationOf(ghostId)
	if mutation then
		-- variante : "✨ DORÉ x3 • COMMUN"
		rarityText = "✨ " .. string.upper(mutation.Name[Lang.code] or mutation.Name.en) .. " x" .. mutation.Mult .. " • " .. rarityText
		rarityColor = Color3.fromRGB(mutation.Color[1], mutation.Color[2], mutation.Color[3])
	end
	UI.label({
		Name = "Rarity",
		Size = UDim2.fromScale(1, 0.26),
		Position = UDim2.fromScale(0, 0.4),
		Text = rarityText,
		TextColor3 = rarityColor,
		MaxTextSize = 40,
		Parent = gui,
	})
	local price, income = GhostData.priceOf(ghostId), GhostData.incomeOf(ghostId)
	local info = if mode == "path"
		then "🪙 " .. Format.short(price) .. "   +" .. Format.short(income) .. "/s"
		else "+" .. Format.short(income) .. "/s"
	UI.label({
		Name = "Info",
		Size = UDim2.fromScale(1, 0.34),
		Position = UDim2.fromScale(0, 0.66),
		Text = info,
		TextColor3 = UI.Colors.Gold,
		MaxTextSize = 48,
		Parent = gui,
	})
	gui.Parent = adornee
	return gui
end

-- Petite étiquette simple (ex. "!" sur un socle volé, cadenas sur un socle bloqué)
function Labels.simple(adornee: Instance, text: string, color: Color3, offset: Vector3, studsWidth: number?): BillboardGui
	local gui = UI.new("BillboardGui", {
		Size = UDim2.new(studsWidth or 6, 0, 1.6, 0),
		StudsOffsetWorldSpace = offset,
		LightInfluence = 0,
		MaxDistance = 60,
		AutoLocalize = Lang.autoLocalize,
		Adornee = adornee,
	})
	UI.label({
		Name = "Text",
		Size = UDim2.fromScale(1, 1),
		Text = text,
		TextColor3 = color,
		MaxTextSize = 60,
		Parent = gui,
	})
	gui.Parent = adornee
	return gui
end

return Labels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Lang</string>
            <string name="Source"><![CDATA[--[[
	Lang : choisit la langue du joueur (français si son Roblox est en français,
	sinon anglais) et traduit les textes.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local GhostData = require(Shared:WaitForChild("GhostData"))
local Monsters = require(Shared:WaitForChild("Monsters"))
local Strings = require(Shared:WaitForChild("Strings"))
local Weapons = require(Shared:WaitForChild("Weapons"))

local Lang = {}

local function detect(): string
	if Config.ForceLanguage == "fr" or Config.ForceLanguage == "en" then
		return Config.ForceLanguage
	end
	local ok, locale = pcall(function()
		return Players.LocalPlayer.LocaleId
	end)
	if ok and type(locale) == "string" and string.sub(string.lower(locale), 1, 2) == "fr" then
		return "fr"
	end
	return "en"
end

Lang.code = detect()

-- Roblox peut traduire automatiquement l'anglais vers d'autres langues (espagnol,
-- portugais...). On le désactive pour le français, déjà traduit à la main.
Lang.autoLocalize = Lang.code ~= "fr"

-- "DrapMou#Gold" -> "Drap Mou Doré" (fr) / "Golden Floppy Sheet" (en)
function Lang.ghostName(ghostKey: string): string
	local ghost = GhostData.get(ghostKey)
	if not ghost then
		return tostring(ghostKey)
	end
	local name = ghost.Name[Lang.code] or ghost.Name.en
	local mutation = GhostData.mutationOf(ghostKey)
	if mutation then
		local tag = mutation.Name[Lang.code] or mutation.Name.en
		return if Lang.code == "fr" then name .. " " .. tag else tag .. " " .. name
	end
	return name
end

function Lang.ghostGag(ghostId: string): string
	local ghost = GhostData.get(ghostId)
	if not ghost then
		return ""
	end
	return ghost.Gag[Lang.code] or ghost.Gag.en
end

-- Choisit le texte dans la bonne langue : { fr = "...", en = "..." }
function Lang.pick(texts: { [string]: string }?): string
	if not texts then
		return ""
	end
	return texts[Lang.code] or texts.en or ""
end

function Lang.monsterName(id: string): string
	local monster = Monsters.get(id)
	return if monster then Lang.pick(monster.Name) else tostring(id)
end

function Lang.weaponName(id: string): string
	local weapon = Weapons.get(id)
	return if weapon then Lang.pick(weapon.Name) else tostring(id)
end

function Lang.rarityName(rarity: string): string
	return Strings.format(Lang.code, "Rarity_" .. rarity)
end

-- Traduit une clé. Les paramètres "ghost" (Id) et "rarity" sont traduits aussi.
function Lang.t(key: string, params: { [string]: any }?): string
	local resolved = nil
	if params then
		resolved = {}
		for name, value in params do
			if name == "ghost" then
				resolved[name] = Lang.ghostName(value)
			elseif name == "rarity" then
				resolved[name] = Lang.rarityName(value)
			elseif name == "monster" then
				resolved[name] = Lang.monsterName(value)
			elseif name == "weapon" then
				resolved[name] = Lang.weaponName(value)
			else
				resolved[name] = value
			end
		end
	end
	return Strings.format(Lang.code, key, resolved)
end

return Lang
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">LeaderboardView</string>
            <string name="Source"><![CDATA[--[[
	LeaderboardView : affiche le top 10 des voleurs de la semaine sur le grand écran
	au-dessus du chemin (des deux côtés). Les données viennent du serveur.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Lang = require(script.Parent.Lang)
local UI = require(script.Parent.UI)

local LeaderboardView = {}

local player = Players.LocalPlayer

local MEDALS = { "🥇", "🥈", "🥉" }

local function buildFace(board: BasePart, face: Enum.NormalId)
	local surface = UI.new("SurfaceGui", {
		Name = "Leaderboard_" .. face.Name,
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 40,
		LightInfluence = 0,
		AutoLocalize = Lang.autoLocalize,
		Adornee = board,
		Parent = board,
	})
	UI.label({
		Name = "Title",
		Size = UDim2.new(1, -40, 0, 70),
		Position = UDim2.fromOffset(20, 10),
		Text = "🏆 " .. Lang.t("LeaderTitle") .. " 🏆",
		TextColor3 = UI.Colors.Gold,
		MaxTextSize = 60,
		Parent = surface,
	})
	local rows = {}
	for rank = 1, 10 do
		local row = UI.label({
			Name = "Row" .. rank,
			Size = UDim2.new(1, -80, 0, 42),
			Position = UDim2.fromOffset(40, 84 + (rank - 1) * 44),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 38,
			Parent = surface,
		})
		rows[rank] = row
	end
	local footer = UI.label({
		Name = "Footer",
		Size = UDim2.new(1, -40, 0, 40),
		Position = UDim2.new(0, 20, 1, -50),
		TextColor3 = UI.Colors.Info,
		MaxTextSize = 30,
		Parent = surface,
	})
	return rows, footer
end

function LeaderboardView.start()
	local map = workspace:WaitForChild("Map")
	local board = map:WaitForChild("Leaderboard", 30) :: BasePart?
	if not board then
		return
	end
	local faces = {}
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local rows, footer = buildFace(board, face)
		table.insert(faces, { Rows = rows, Footer = footer })
	end

	local function refresh()
		local raw = ReplicatedStorage:GetAttribute("LeaderboardData")
		local ok, list = pcall(function()
			return HttpService:JSONDecode(raw or "[]")
		end)
		if not ok or type(list) ~= "table" then
			list = {}
		end
		local resetAt = ReplicatedStorage:GetAttribute("LeaderboardResetAt") or 0
		local remaining = math.max(0, resetAt - workspace:GetServerTimeNow())
		local footerText = Lang.t("LeaderReset", { days = math.floor(remaining / 86400), hours = math.floor((remaining % 86400) / 3600) })
		for _, face in faces do
			for rank, row in face.Rows do
				local entry = list[rank]
				if entry then
					local medal = MEDALS[rank] or (tostring(rank) .. ".")
					row.Text = medal .. "  " .. tostring(entry.Name) .. "  :  " .. Lang.t("LeaderSteals", { count = entry.Value })
					row.TextColor3 = if entry.UserId == player.UserId then UI.Colors.Gold else UI.Colors.Text
				elseif rank == 1 then
					row.Text = Lang.t("LeaderEmpty")
					row.TextColor3 = UI.Colors.Gray
				else
					row.Text = ""
				end
			end
			face.Footer.Text = footerText
		end
	end

	ReplicatedStorage:GetAttributeChangedSignal("LeaderboardData"):Connect(refresh)
	refresh()
	-- le compte à rebours avance même sans nouveau vol
	task.spawn(function()
		while true do
			task.wait(60)
			refresh()
		end
	end)
end

return LeaderboardView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">MonsterView</string>
            <string name="Source"><![CDATA[--[[
	MonsterView : les monstres côté joueur (Gloutrouille la nuit, et ceux lâchés avec
	des Robux). Le serveur publie leur position sur une pièce invisible "<Id>Anchor" ;
	ici on dessine le vrai monstre, on le fait glisser en douceur et on l'anime.
	Quand un monstre te poursuit : bords de l'écran rouges + battements de cœur.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Monsters = require(Shared:WaitForChild("Monsters"))

local Effects = require(script.Parent.Effects)
local Lang = require(script.Parent.Lang)
local UI = require(script.Parent.UI)

local MonsterView = {}

local player = Players.LocalPlayer

type Shown = { Anchor: BasePart, Model: Model, Def: any, Wings: { BasePart }, Base: { [BasePart]: CFrame } }
local shown: { [BasePart]: Shown } = {}
local vignette: Frame

local function colorOf(def): Color3
	return Color3.fromRGB(def.Color[1], def.Color[2], def.Color[3])
end

local function addLabel(model: Model, anchor: BasePart, def)
	local root = model.PrimaryPart :: BasePart
	local summoner = anchor:GetAttribute("SummonerName") or ""
	local text = def.Icon .. " " .. string.upper(Lang.pick(def.Name))
	if summoner ~= "" then
		text ..= "\n" .. Lang.t("MonsterBy", { player = summoner })
	end
	local tag = UI.new("BillboardGui", {
		Name = "MonsterTag",
		Size = UDim2.fromOffset(260, if summoner ~= "" then 70 else 46),
		StudsOffsetWorldSpace = Vector3.new(0, 8, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 400,
		AutoLocalize = false,
		Adornee = root,
		Parent = root,
	})
	UI.label({
		Size = UDim2.fromScale(1, 1),
		Text = text,
		TextColor3 = colorOf(def),
		MaxTextSize = 32,
		Parent = tag,
	})
end

local function onAnchorAdded(anchor: Instance)
	if not anchor:IsA("BasePart") then
		return
	end
	local kind = anchor:GetAttribute("MonsterKind")
	local def = Monsters.get(kind)
	if not def or shown[anchor] then
		return
	end
	local model = Monsters.build(def.Id)
	local scale = anchor:GetAttribute("Scale") or 1
	if scale ~= 1 then
		model:ScaleTo(scale) -- Super Nuit : Gloutrouille géant
	end
	addLabel(model, anchor, def)
	-- les parties qui bougent (ailes, pattes, bras), avec leur position de départ
	local moving, base = {}, {}
	local root = model.PrimaryPart :: BasePart
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and (d.Name == "Wing" or d.Name == "Leg" or d.Name == "Arm") then
			table.insert(moving, d)
			base[d] = root.CFrame:ToObjectSpace(d.CFrame)
		end
	end
	model:PivotTo(anchor.CFrame)
	model.Parent = workspace
	shown[anchor] = { Anchor = anchor, Model = model, Def = def, Wings = moving, Base = base }
	Effects.poof(anchor.Position, colorOf(def))
end

local function onAnchorRemoved(anchor: Instance)
	local entry = shown[anchor :: BasePart]
	if entry then
		Effects.poof(entry.Model:GetPivot().Position, Color3.fromRGB(170, 80, 255))
		entry.Model:Destroy()
		shown[anchor :: BasePart] = nil
	end
end

function MonsterView.start()
	-- Bords rouges quand un monstre te poursuit
	local vignetteGui = UI.new("ScreenGui", {
		Name = "SAG_Vignette",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = -1,
		Parent = player:WaitForChild("PlayerGui"),
	})
	vignette = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 0, 40),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = vignetteGui,
	}, {
		UI.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.2, 0.9),
				NumberSequenceKeypoint.new(0.8, 0.9),
				NumberSequenceKeypoint.new(1, 0),
			}),
		}),
	})

	workspace.ChildAdded:Connect(onAnchorAdded)
	workspace.ChildRemoved:Connect(onAnchorRemoved)
	for _, child in workspace:GetChildren() do
		onAnchorAdded(child)
	end

	local nextHeartbeat = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		local chased = false
		local character = player.Character
		local myRoot = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		for anchor, entry in shown do
			if not anchor.Parent then
				onAnchorRemoved(anchor)
				continue
			end
			-- il glisse vers la position du serveur et rebondit
			local alpha = 1 - math.exp(-dt * 10)
			local goal = anchor.CFrame * CFrame.new(0, math.abs(math.sin(t * 5)) * 1.2, 0)
			entry.Model:PivotTo(entry.Model:GetPivot():Lerp(goal, alpha))
			-- ailes qui battent, pattes et bras qui s'agitent
			local root = entry.Model.PrimaryPart :: BasePart
			for _, moving in entry.Wings do
				local side = moving:GetAttribute("Side") or (if root.CFrame:PointToObjectSpace(moving.Position).X > 0 then 1 else -1)
				local speed = if moving.Name == "Wing" then 18 else 9
				local angle = math.sin(t * speed + side) * (if moving.Name == "Wing" then 0.5 else 0.2)
				moving.CFrame = root.CFrame * CFrame.Angles(0, 0, angle * side) * entry.Base[moving]
			end
			if myRoot and anchor:GetAttribute("TargetUserId") == player.UserId then
				chased = chased or (myRoot.Position - anchor.Position).Magnitude < 50
			end
		end
		if chased then
			vignette.BackgroundTransparency = 0.35 + math.abs(math.sin(t * 4)) * 0.4
			if t >= nextHeartbeat then
				nextHeartbeat = t + 0.6
				Effects.sound("Heartbeat")
			end
		else
			vignette.BackgroundTransparency = 1
		end
	end)
end

return MonsterView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">NightView</string>
            <string name="Source"><![CDATA[--[[
	NightView : l'ambiance de la Nuit Hantée côté joueur.
	  - le ciel devient violet et sombre (transition douce)
	  - le minuteur "Nuit dans 5:12" / "Nuit : 1:23" sous les pièces
	  - les pièces de la Nuit des Bonbons qui tournent
	(Gloutrouille est dessiné par MonsterView.)
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))

local Effects = require(script.Parent.Effects)
local HUD = require(script.Parent.HUD)
local Lang = require(script.Parent.Lang)
local UI = require(script.Parent.UI)

local NightView = {}

local NIGHT_LIGHTING = {
	ClockTime = 22.5,
	Brightness = 1,
	Ambient = Color3.fromRGB(90, 60, 140),
	OutdoorAmbient = Color3.fromRGB(80, 50, 130),
}
local NIGHT_ATMOSPHERE = {
	Density = 0.42,
	Haze = 1.5,
	Color = Color3.fromRGB(120, 80, 180),
	Decay = Color3.fromRGB(60, 30, 100),
}
local NIGHT_CC = {
	TintColor = Color3.fromRGB(215, 195, 255),
	Saturation = 0.25,
	Contrast = 0.12,
}

-- Ce qui change selon le thème de la nuit
local THEME_OVERRIDES = {
	Fog = { Atmosphere = { Density = 0.78, Haze = 4 } },
	Candy = { CC = { TintColor = Color3.fromRGB(255, 205, 235), Saturation = 0.45 } },
	Super = { CC = { TintColor = Color3.fromRGB(255, 180, 180), Contrast = 0.22 } },
}
local THEME_ICONS = { Classic = "🌙", Fog = "🌫️", Candy = "🍬", Super = "🔥" }

local dayLighting, dayAtmosphere, dayCC = {}, {}, {}
local music: Sound? = nil
local timerLabel: TextLabel

local function snapshot(target: Instance?, keys: { [string]: any }, into: { [string]: any })
	if not target then
		return
	end
	for key in keys do
		into[key] = (target :: any)[key]
	end
end

local function tweenTo(target: Instance?, goals: { [string]: any }, duration: number)
	if target and next(goals) then
		TweenService:Create(target, TweenInfo.new(duration, Enum.EasingStyle.Sine), goals):Play()
	end
end

local function applyNight(active: boolean, duration: number)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	local cc = Lighting:FindFirstChild("SAG_ColorCorrection")
	if active then
		local override = THEME_OVERRIDES[ReplicatedStorage:GetAttribute("NightTheme") or "Classic"] or {}
		local atmosphereGoals = table.clone(NIGHT_ATMOSPHERE)
		for key, value in override.Atmosphere or {} do
			atmosphereGoals[key] = value
		end
		local ccGoals = table.clone(NIGHT_CC)
		for key, value in override.CC or {} do
			ccGoals[key] = value
		end
		tweenTo(Lighting, NIGHT_LIGHTING, duration)
		tweenTo(atmosphere, atmosphereGoals, duration)
		tweenTo(cc, ccGoals, duration)
	else
		tweenTo(Lighting, dayLighting, duration)
		tweenTo(atmosphere, dayAtmosphere, duration)
		tweenTo(cc, dayCC, duration)
	end
end

---------------------------------------------------------------- Démarrage

function NightView.start()
	snapshot(Lighting, NIGHT_LIGHTING, dayLighting)
	snapshot(Lighting:FindFirstChildOfClass("Atmosphere"), NIGHT_ATMOSPHERE, dayAtmosphere)
	snapshot(Lighting:FindFirstChild("SAG_ColorCorrection"), NIGHT_CC, dayCC)

	local pill = HUD.pill(UI.Colors.Purple, 1)
	pill.Visible = true
	timerLabel = pill:FindFirstChild("Text") :: TextLabel

	local function onNightChanged()
		local active = ReplicatedStorage:GetAttribute("NightActive") == true
		applyNight(active, 3)
		if active then
			music = Effects.music("NightMusic")
		elseif music then
			music:Destroy()
			music = nil
		end
	end
	ReplicatedStorage:GetAttributeChangedSignal("NightActive"):Connect(onNightChanged)
	if ReplicatedStorage:GetAttribute("NightActive") then
		applyNight(true, 0.1)
	end

	RunService.RenderStepped:Connect(function()
		local now = workspace:GetServerTimeNow()
		local t = os.clock()

		-- minuteur
		if ReplicatedStorage:GetAttribute("NightActive") then
			local icon = THEME_ICONS[ReplicatedStorage:GetAttribute("NightTheme") or "Classic"] or "🌙"
			timerLabel.Text = icon .. " " .. Lang.t("NightTimer", { time = Format.time((ReplicatedStorage:GetAttribute("NightEndsAt") or now) - now) })
		else
			timerLabel.Text = "🌙 " .. Lang.t("DayTimer", { time = Format.time((ReplicatedStorage:GetAttribute("NextNightAt") or now) - now) })
		end

		-- Nuit des Bonbons : les pièces tournent sur elles-mêmes
		local coins = workspace:FindFirstChild("CandyCoins")
		if coins then
			for _, coin in coins:GetChildren() do
				local base = coin:GetAttribute("Base")
				if coin:IsA("BasePart") and typeof(base) == "CFrame" then
					coin.CFrame = CFrame.new(base.Position + Vector3.new(0, math.sin(t * 3) * 0.3, 0)) * CFrame.Angles(0, t * 3, 0)
				end
			end
		end
	end)
end

return NightView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[--[[
	Panels : les fenêtres "Cadeau du jour", "Rebirth" et "Boutique",
	et leurs gros boutons à gauche de l'écran.
	Comme partout, l'interface ne fait que DEMANDER : le serveur vérifie et décide.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local GhostData = require(Shared:WaitForChild("GhostData"))
local GhostFactory = require(Shared:WaitForChild("GhostFactory"))
local Missions = require(Shared:WaitForChild("Missions"))
local Monsters = require(Shared:WaitForChild("Monsters"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Shop = require(Shared:WaitForChild("Shop"))
local Strings = require(Shared:WaitForChild("Strings"))
local Weapons = require(Shared:WaitForChild("Weapons"))
local Wheel = require(Shared:WaitForChild("Wheel"))

local Effects = require(script.Parent.Effects)
local HUD = require(script.Parent.HUD)
local Lang = require(script.Parent.Lang)
local UI = require(script.Parent.UI)

local Panels = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local openPanel: Frame? = nil
local dailyInfo = nil
local indexInfo = nil
local missionsInfo = nil
local refreshers: { () -> () } = {}

local function rebirthCost(rebirths: number): number
	return math.floor(Config.RebirthBaseCost * Config.RebirthCostGrowth ^ rebirths)
end

---------------------------------------------------------------- Fenêtre générique

local function close()
	if openPanel then
		openPanel.Visible = false
		openPanel = nil
	end
end

local function open(panel: Frame)
	if openPanel == panel then
		close()
		return
	end
	close()
	panel.Visible = true
	openPanel = panel
	for _, refresh in refreshers do
		refresh()
	end
	UI.pop(panel)
end

local function makePanel(name: string, title: string, color: Color3): (Frame, Frame)
	local panel = UI.new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(600, 430),
		BackgroundColor3 = UI.Colors.Panel,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	}, { UI.corner(26), UI.stroke(color, 5) })
	UI.label({
		Size = UDim2.new(1, -120, 0, 56),
		Position = UDim2.fromOffset(60, 10),
		Text = title,
		TextColor3 = color,
		MaxTextSize = 44,
		Parent = panel,
	})
	local closeButton = UI.new("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(52, 52),
		BackgroundColor3 = UI.Colors.Bad,
		Text = "✕",
		TextScaled = true,
		Font = UI.Font,
		TextColor3 = UI.Colors.Text,
		AutoButtonColor = true,
		Parent = panel,
	}, { UI.corner(16), UI.stroke(nil, 3) })
	closeButton.Activated:Connect(function()
		Effects.sound("Click")
		close()
	end)
	local body = UI.new("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(20, 76),
		Size = UDim2.new(1, -40, 1, -96),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	return panel, body
end

local function actionButton(parent: Instance, text: string, color: Color3, position: UDim2, size: UDim2): (TextButton, TextLabel)
	local button = UI.new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = position,
		Size = size,
		BackgroundColor3 = color,
		Text = "",
		AutoButtonColor = true,
		Parent = parent,
	}, { UI.corner(18), UI.stroke(nil, 4) })
	local label = UI.label({
		Size = UDim2.new(1, -16, 1, -10),
		Position = UDim2.fromOffset(8, 5),
		Text = text,
		MaxTextSize = 36,
		Parent = button,
	})
	return button, label
end

---------------------------------------------------------------- Cadeau du jour

local function buildDaily(): Frame
	local panel, body = makePanel("Daily", "🎁 " .. Lang.t("DailyTitle"), UI.Colors.Gold)
	local grid = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 150),
		BackgroundTransparency = 1,
		Parent = body,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local tiles = {}
	for day = 1, #Config.DailyRewards do
		local tile = UI.new("Frame", {
			Size = UDim2.fromOffset(74, 140),
			BackgroundColor3 = UI.Colors.PanelLight,
			LayoutOrder = day,
			Parent = grid,
		}, { UI.corner(14), UI.stroke(nil, 3) })
		UI.label({ Name = "Day", Size = UDim2.new(1, -6, 0, 26), Position = UDim2.fromOffset(3, 4), Text = Lang.t("DailyDay", { day = day }), MaxTextSize = 20, Parent = tile })
		UI.label({ Name = "Icon", Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 30), Text = if Config.DailyRewards[day].RandomGhostRarity then "👻" else "🪙", MaxTextSize = 38, Parent = tile })
		UI.label({ Name = "Amount", Size = UDim2.new(1, -6, 0, 26), Position = UDim2.fromOffset(3, 76), TextColor3 = UI.Colors.Gold, MaxTextSize = 20, Parent = tile })
		UI.label({ Name = "Extra", Size = UDim2.new(1, -6, 0, 30), Position = UDim2.fromOffset(3, 104), TextColor3 = UI.Colors.Purple, MaxTextSize = 14, Parent = tile })
		tiles[day] = tile
	end

	local claim, claimLabel = actionButton(body, Lang.t("DailyClaim"), UI.Colors.Good, UDim2.new(0.5, 0, 1, -4), UDim2.fromOffset(320, 80))
	claim.Activated:Connect(function()
		if dailyInfo and dailyInfo.CanClaim then
			Effects.sound("Click")
			Remotes.get("ClaimDaily"):FireServer()
		end
	end)

	local function refresh()
		local info = dailyInfo
		if not info then
			return
		end
		local income = player:GetAttribute("Income") or 0
		for day, tile in tiles do
			local reward = Config.DailyRewards[day]
			local amount = math.max(reward.Min, math.floor(income * 60 * reward.Minutes))
			tile.Amount.Text = Format.short(amount)
			tile.Extra.Text = if reward.RandomGhostRarity then Lang.t("DailyGhostBonus") else ""
			local stroke = tile:FindFirstChildOfClass("UIStroke")
			local isToday = day == info.Day
			local done = day < info.Day or (isToday and not info.CanClaim)
			tile.BackgroundColor3 = if isToday then Color3.fromRGB(110, 70, 30) elseif done then UI.Colors.Panel else UI.Colors.PanelLight
			if stroke then
				stroke.Color = if isToday then UI.Colors.Gold else UI.Colors.Stroke
			end
			tile.Icon.Text = if done then "✅" elseif reward.RandomGhostRarity then "👻" else "🪙"
		end
		if info.CanClaim then
			claim.BackgroundColor3 = UI.Colors.Good
			claimLabel.Text = Lang.t("DailyClaim")
		else
			claim.BackgroundColor3 = UI.Colors.Gray
			local wait = (info.NextAt or 0) - workspace:GetServerTimeNow()
			claimLabel.Text = Lang.t("DailyNext", { time = Format.time(wait) })
		end
	end
	table.insert(refreshers, refresh)
	return panel
end

---------------------------------------------------------------- Rebirth

local function buildRebirth(): Frame
	local color = Color3.fromRGB(120, 255, 200)
	local panel, body = makePanel("Rebirth", "♻️ " .. Lang.t("RebirthTitle"), color)
	UI.label({ Size = UDim2.new(1, 0, 0, 34), Text = Lang.t("RebirthDesc"), MaxTextSize = 24, Parent = body })
	local gain = UI.label({ Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 40), TextColor3 = color, MaxTextSize = 34, Parent = body })
	local current = UI.label({ Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 90), TextColor3 = UI.Colors.Info, MaxTextSize = 22, Parent = body })
	local cost = UI.label({ Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 124), TextColor3 = UI.Colors.Gold, MaxTextSize = 26, Parent = body })

	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(40, 164),
		Size = UDim2.new(1, -80, 0, 22),
		BackgroundColor3 = UI.Colors.Stroke,
		Parent = body,
	}, { UI.corner(11) })
	local fill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color,
		Parent = bar,
	}, { UI.corner(11) })

	local button, buttonLabel = actionButton(body, Lang.t("RebirthConfirm"), color, UDim2.new(0.5, 0, 1, -4), UDim2.fromOffset(320, 80))
	local armedUntil = 0
	button.Activated:Connect(function()
		local rebirths = player:GetAttribute("Rebirths") or 0
		if (player:GetAttribute("Coins") or 0) < rebirthCost(rebirths) then
			Effects.sound("Error")
			return
		end
		-- double clic obligatoire : on ne perd pas tout par accident
		if os.clock() > armedUntil then
			armedUntil = os.clock() + 3
			buttonLabel.Text = Lang.t("RebirthSure")
			Effects.sound("Click")
			return
		end
		armedUntil = 0
		Remotes.get("Rebirth"):FireServer()
		close()
	end)

	local function refresh()
		local rebirths = player:GetAttribute("Rebirths") or 0
		local coins = player:GetAttribute("Coins") or 0
		local price = rebirthCost(rebirths)
		gain.Text = Lang.t("RebirthGain", { percent = math.floor(Config.RebirthIncomeBonus * 100) })
		current.Text = Lang.t("RebirthCurrent", { mult = 1 + rebirths * Config.RebirthIncomeBonus })
		cost.Text = Lang.t("RebirthCost", { coins = Format.short(price) })
		fill.Size = UDim2.fromScale(math.clamp(coins / price, 0, 1), 1)
		local ready = coins >= price
		button.BackgroundColor3 = if ready then color else UI.Colors.Gray
		if os.clock() > armedUntil then
			buttonLabel.Text = if ready then Lang.t("RebirthConfirm") else Lang.t("RebirthNotEnough", { coins = Format.short(price) })
		end
	end
	table.insert(refreshers, refresh)
	return panel
end

---------------------------------------------------------------- Boutique

local IS_STUDIO = RunService:IsStudio()

-- La roue est-elle assez près pour tourner ? (on joue devant elle, tout le monde regarde)
local function nearWheel(): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local map = workspace:FindFirstChild("Map")
	local anchor = map and map:FindFirstChild("FortuneWheelAnchor", true) :: BasePart?
	return root ~= nil and anchor ~= nil and (root.Position - anchor.Position).Magnitude < 45
end

local shopSelect: ((string) -> ())? = nil

-- L'icône d'un article : une image importée (Config.ShopIcons), sinon l'emoji
local function iconFor(id: string, emoji: string): string
	local image = Config.ShopIcons and Config.ShopIcons[id]
	return if type(image) == "string" and image ~= "" then image else emoji
end

local function buildShop(): Frame
	local panel, body = makePanel("Shop", "🛒 " .. Lang.t("ShopTitle"), UI.Colors.Orange)
	panel.Size = UDim2.fromOffset(660, 480)

	-- les onglets
	local tabs = UI.new("Frame", {
		Name = "Tabs",
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundTransparency = 1,
		Parent = body,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local content = UI.new("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(0, 62),
		Size = UDim2.new(1, 0, 1, -62),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = body,
	})

	local categories = table.clone(Shop.Categories)
	table.insert(categories, { Id = "Codes", Icon = "🎟️", Name = { fr = "Codes", en = "Codes" } })
	local pages: { [string]: Frame } = {}
	local tabButtons: { [string]: TextButton } = {}
	local updaters = {}

	local function selectTab(id: string)
		for key, page in pages do
			page.Visible = key == id
		end
		for key, button in tabButtons do
			button.BackgroundColor3 = if key == id then UI.Colors.Orange else UI.Colors.PanelLight
		end
		content.CanvasPosition = Vector2.zero
	end
	shopSelect = selectTab

	for order, category in categories do
		local tab = UI.new("TextButton", {
			Name = "Tab_" .. category.Id,
			Size = UDim2.new(1 / #categories, -6, 1, 0),
			BackgroundColor3 = UI.Colors.PanelLight,
			Text = "",
			LayoutOrder = order,
			Parent = tabs,
		}, { UI.corner(14), UI.stroke(nil, 3) })
		UI.label({
			Size = UDim2.new(1, -6, 1, -6),
			Position = UDim2.fromOffset(3, 3),
			Text = category.Icon .. " " .. Lang.pick(category.Name),
			MaxTextSize = 20,
			Parent = tab,
		})
		tab.Activated:Connect(function()
			Effects.sound("Click")
			selectTab(category.Id)
		end)
		tabButtons[category.Id] = tab
		pages[category.Id] = UI.new("Frame", {
			Name = "Page_" .. category.Id,
			Size = UDim2.new(1, -12, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Visible = false,
			Parent = content,
		}, {
			UI.new("UIListLayout", {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
	end

	-- Une carte : icône, titre, description, et un bouton à droite (optionnel)
	local function card(page: Frame, order: number, icon: string, title: string, withButton: boolean, height: number?)
		local frame = UI.new("Frame", {
			Size = UDim2.new(1, 0, 0, height or 76),
			BackgroundColor3 = UI.Colors.PanelLight,
			LayoutOrder = order,
			Parent = page,
		}, { UI.corner(16), UI.stroke(nil, 3) })
		local right = if withButton then 190 else 20
		if string.sub(icon, 1, 13) == "rbxassetid://" then
			UI.new("ImageLabel", {
				Name = "IconImage",
				Size = UDim2.fromOffset(58, 58),
				Position = UDim2.fromOffset(8, 9),
				BackgroundTransparency = 1,
				Image = icon,
				ScaleType = Enum.ScaleType.Fit,
				Parent = frame,
			})
		else
			UI.label({ Size = UDim2.fromOffset(58, 58), Position = UDim2.fromOffset(8, 9), Text = icon, MaxTextSize = 44, Parent = frame })
		end
		UI.label({
			Name = "Title",
			Size = UDim2.new(1, -(74 + right), 0, 30),
			Position = UDim2.fromOffset(72, 6),
			Text = title,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 26,
			Parent = frame,
		})
		local desc = UI.label({
			Name = "Desc",
			Size = UDim2.new(1, -(74 + right), 1, -42),
			Position = UDim2.fromOffset(72, 38),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextColor3 = UI.Colors.Info,
			MaxTextSize = 18,
			Parent = frame,
		})
		local button, label = nil, nil
		if withButton then
			button = UI.new("TextButton", {
				Name = "Buy",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(170, 56),
				BackgroundColor3 = UI.Colors.Good,
				Text = "",
				Parent = frame,
			}, { UI.corner(16), UI.stroke(nil, 3) })
			label = UI.label({ Size = UDim2.new(1, -12, 1, -10), Position = UDim2.fromOffset(6, 5), MaxTextSize = 26, Parent = button })
		end
		return frame, desc, button, label
	end

	-- Le bouton d'achat d'un article Robux (prix, "Acheté", "Bientôt", test gratuit dans Studio)
	local function itemCard(page: Frame, order: number, item, icon: string, title: string, describe: () -> string)
		local _, desc, button, label = card(page, order, icon, title, true)
		local id = Shop.idOf(item, Config)
		local robux: number? = nil
		if id ~= 0 then
			task.spawn(function()
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(id, if item.Kind == "Pass" then Enum.InfoType.GamePass else Enum.InfoType.Product)
				end)
				if ok and info then
					robux = info.PriceInRobux
				end
			end)
		end
		local enabled = false
		button.Activated:Connect(function()
			if enabled then
				Effects.sound("Click")
				Remotes.get("ShopBuy"):FireServer(item.Key)
			end
		end)
		table.insert(updaters, function()
			desc.Text = describe()
			local color = UI.Colors.Good
			enabled = false
			if item.Kind == "Pass" and player:GetAttribute(item.Attribute) then
				label.Text = "✅ " .. Lang.t("ShopOwned")
				color = UI.Colors.Gray
			elseif item.Random and player:GetAttribute("RandomItemsRestricted") ~= false then
				label.Text = Lang.t("ShopRestrictedShort")
				color = UI.Colors.Gray
			elseif id == 0 then
				if IS_STUDIO then
					label.Text = "🧪 " .. Lang.t("ShopTestFree")
					enabled = true
				else
					label.Text = Lang.t("ShopSoon")
					color = UI.Colors.Gray
				end
			else
				label.Text = "R$ " .. tostring(robux or item.Robux)
				enabled = true
			end
			button.BackgroundColor3 = color
		end)
	end

	---- Passes
	local order = 0
	for _, item in Shop.Items do
		order += 1
		if item.Category == "Passes" then
			itemCard(pages.Passes, order, item, item.Icon, Lang.pick(item.Name), function()
				return Lang.pick(item.Desc)
			end)
		elseif item.Category == "Coins" then
			itemCard(pages.Coins, order, item, item.Icon, Lang.pick(item.Name), function()
				local income = player:GetAttribute("Income") or 0
				local amount = math.max(Config.CoinPackMin, math.floor(income * 60 * Config.CoinPackMinutes))
				return Strings.fill(Lang.pick(item.Desc), { coins = Format.short(amount) })
			end)
		end
	end

	---- Armes : la Batte offerte, puis les armes Game Pass
	for _, weapon in Weapons.List do
		local stats = Lang.t("WeaponStats", { range = weapon.Range, cooldown = weapon.Cooldown })
		local function describe(): string
			return Lang.pick(weapon.Desc) .. "\n" .. stats .. (if weapon.Sweep then " · " .. Lang.t("WeaponSweep") else "")
		end
		if weapon.Free then
			local _, desc = card(pages.Weapons, weapon.Order, iconFor(weapon.Id, weapon.Icon), Lang.pick(weapon.Name) .. "  ✅ " .. Lang.t("ShopFree"), false, 84)
			desc.Text = describe()
		else
			for _, item in Shop.Items do
				if item.Weapon == weapon.Id then
					itemCard(pages.Weapons, weapon.Order, item, iconFor(weapon.Id, weapon.Icon), Lang.pick(weapon.Name), describe)
				end
			end
		end
	end

	---- Monstres
	for _, item in Shop.Items do
		local monster = item.Monster and Monsters.get(item.Monster)
		if monster then
			itemCard(pages.Monsters, monster.Order + 1, item, iconFor(monster.Id, monster.Icon), Lang.pick(monster.Name), function()
				return Lang.pick(monster.Desc) .. "\n" .. Lang.t("MonsterStats", { time = Format.time(monster.Duration) })
			end)
		end
	end
	local _, monsterInfo = card(pages.Monsters, 0, "👹", Lang.t("MonstersTitle"), false, 70)
	monsterInfo.Text = Lang.t("MonstersInfo")

	---- Roue de la Fortune : tours possédés, chances, achat
	local spinCard, spinDesc, spinButton, spinLabel = card(pages.Wheel, 1, iconFor("Wheel", "🎡"), Lang.t("WheelTitle"), true)
	spinButton.Name = "SpinButton"
	spinCard.Name = "SpinCard"
	spinButton.Activated:Connect(function()
		if (player:GetAttribute("Spins") or 0) <= 0 then
			return
		end
		Effects.sound("Click")
		if not nearWheel() then
			HUD.toast(Lang.t("WheelGoThere"), "info")
			return
		end
		Remotes.get("SpinWheel"):FireServer()
		close()
	end)
	table.insert(updaters, function()
		local spins = player:GetAttribute("Spins") or 0
		spinDesc.Text = Lang.t("WheelSpins", { count = spins })
		spinLabel.Text = Lang.t("WheelSpin")
		spinButton.BackgroundColor3 = if spins > 0 then UI.Colors.Gold else UI.Colors.Gray
	end)

	local oddsHeight = 44 + #Wheel.Segments * 26
	local oddsCard = card(pages.Wheel, 2, "🎲", Lang.t("WheelOdds"), false, oddsHeight)
	oddsCard.Name = "OddsCard"
	local total = Wheel.totalChance()
	for index, segment in Wheel.Segments do
		local percent = math.floor(segment.Chance / total * 1000 + 0.5) / 10
		UI.label({
			Name = "Odds_" .. segment.Id,
			Size = UDim2.new(1, -90, 0, 24),
			Position = UDim2.fromOffset(72, 38 + (index - 1) * 26),
			Text = segment.Icon .. "  " .. Lang.t("Wheel_" .. segment.Id) .. "  :  " .. Format.percent(percent),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 20,
			Parent = oddsCard,
		})
	end
	for _, item in Shop.Items do
		if item.Category == "Wheel" then
			itemCard(pages.Wheel, 2 + item.Order, item, item.Icon, Lang.pick(item.Name), function()
				if player:GetAttribute("RandomItemsRestricted") ~= false then
					return Lang.t("ShopRestricted")
				end
				return Lang.pick(item.Desc)
			end)
		end
	end

	---- Codes secrets : le joueur tape le code, le serveur vérifie tout
	local codeCard = card(pages.Codes, 1, "🎟️", Lang.t("Codes"), false)
	local codeDesc = codeCard:FindFirstChild("Desc") :: TextLabel
	codeDesc.Text = Lang.t("CodesDesc")
	codeDesc.Size = UDim2.new(1, -340, 1, -42)
	local title = codeCard:FindFirstChild("Title") :: TextLabel
	title.Size = UDim2.new(1, -340, 0, 30)
	local codeBox = UI.new("TextBox", {
		Name = "CodeBox",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -96, 0.5, 0),
		Size = UDim2.fromOffset(170, 50),
		BackgroundColor3 = UI.Colors.Panel,
		PlaceholderText = Lang.t("CodePlaceholder"),
		PlaceholderColor3 = UI.Colors.Gray,
		Text = "",
		ClearTextOnFocus = false,
		Font = UI.Font,
		TextColor3 = UI.Colors.Text,
		TextScaled = true,
		Parent = codeCard,
	}, { UI.corner(12), UI.stroke(nil, 2) })
	local codeButton = UI.new("TextButton", {
		Name = "CodeButton",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(78, 50),
		BackgroundColor3 = UI.Colors.Purple,
		Text = "",
		Parent = codeCard,
	}, { UI.corner(12), UI.stroke(nil, 3) })
	UI.label({ Size = UDim2.new(1, -10, 1, -10), Position = UDim2.fromOffset(5, 5), Text = Lang.t("CodeRedeem"), MaxTextSize = 28, Parent = codeButton })
	codeButton.Activated:Connect(function()
		local code = codeBox.Text
		if #code > 0 and #code <= 30 then
			Effects.sound("Click")
			Remotes.get("RedeemCode"):FireServer(code)
			codeBox.Text = ""
		end
	end)

	selectTab("Passes")
	table.insert(refreshers, function()
		for _, update in updaters do
			update()
		end
	end)
	return panel
end

---------------------------------------------------------------- Fantômédex

local function buildIndex(): Frame
	local panel, body = makePanel("Index", "📖 " .. Lang.t("IndexTitle"), UI.Colors.Purple)

	-- Progression par rareté en haut
	local chips = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		Parent = body,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local chipLabels = {}
	for order, rarity in Rarities.Order do
		local chip = UI.new("Frame", {
			Size = UDim2.fromOffset(88, 30),
			BackgroundColor3 = UI.Colors.Panel,
			LayoutOrder = order,
			Parent = chips,
		}, { UI.corner(10), UI.stroke(Rarities.color(rarity), 2) })
		chipLabels[rarity] = UI.label({
			Size = UDim2.new(1, -8, 1, -6),
			Position = UDim2.fromOffset(4, 3),
			TextColor3 = Rarities.color(rarity),
			MaxTextSize = 16,
			Parent = chip,
		})
	end

	-- Grille des 32 fantômes (construite à la première ouverture)
	local grid = UI.new("ScrollingFrame", {
		Name = "Grid",
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 1, -84),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = body,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(100, 112),
			CellPadding = UDim2.fromOffset(8, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local info = UI.label({
		Name = "Info",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 42),
		TextColor3 = UI.Colors.Gold,
		MaxTextSize = 22,
		TextWrapped = true,
		Parent = body,
	})

	local tiles = {}
	local selected: string? = nil

	local function isFound(ghostId: string): boolean
		return indexInfo ~= nil and table.find(indexInfo.Discovered, ghostId) ~= nil
	end

	local function buildTiles()
		for _, ghost in GhostData.List do
			local tile = UI.new("TextButton", {
				Name = ghost.Id,
				BackgroundColor3 = UI.Colors.PanelLight,
				Text = "",
				AutoButtonColor = true,
				LayoutOrder = ghost.Order,
				Parent = grid,
			}, { UI.corner(14), UI.stroke(Rarities.color(ghost.Rarity), 3) })
			local viewport = UI.new("ViewportFrame", {
				Size = UDim2.new(1, -8, 0, 80),
				Position = UDim2.fromOffset(4, 4),
				BackgroundTransparency = 1,
				Ambient = Color3.fromRGB(190, 190, 200),
				LightColor = Color3.fromRGB(255, 255, 255),
				LightDirection = Vector3.new(-1, -1, 1),
				Parent = tile,
			})
			local model = GhostFactory.build(ghost.Id)
			model.Parent = viewport
			local cf, size = model:GetBoundingBox()
			local distance = math.max(size.X, size.Y) * 1.5 + 2
			local camera = Instance.new("Camera")
			camera.FieldOfView = 40
			camera.CFrame = CFrame.lookAt(cf.Position + Vector3.new(distance * 0.3, size.Y * 0.1, -distance), cf.Position)
			camera.Parent = viewport
			viewport.CurrentCamera = camera
			local name = UI.label({
				Size = UDim2.new(1, -6, 0, 24),
				Position = UDim2.new(0, 3, 1, -27),
				MaxTextSize = 16,
				Parent = tile,
			})
			tile.Activated:Connect(function()
				Effects.sound("Click")
				selected = ghost.Id
				for _, refresh in refreshers do
					refresh()
				end
			end)
			tiles[ghost.Id] = { Viewport = viewport, Name = name }
		end
	end

	local function refresh()
		if not panel.Visible then
			return
		end
		if next(tiles) == nil then
			buildTiles()
		end
		for _, rarity in Rarities.Order do
			local list = GhostData.ByRarity[rarity] or {}
			local found = 0
			for _, ghost in list do
				if isFound(ghost.Id) then
					found += 1
				end
			end
			local done = indexInfo and indexInfo.Rewarded and indexInfo.Rewarded[rarity]
			chipLabels[rarity].Text = Lang.rarityName(rarity) .. " " .. found .. "/" .. #list .. (if done then " ✅" else "")
		end
		for ghostId, tile in tiles do
			local found = isFound(ghostId)
			-- pas encore trouvé : silhouette noire et "???"
			tile.Viewport.ImageColor3 = if found then Color3.new(1, 1, 1) else Color3.new(0, 0, 0)
			tile.Name.Text = if found then Lang.ghostName(ghostId) else Lang.t("IndexUnknown")
		end
		local percent = math.floor(Config.IndexCompleteBonus * 100)
		if selected then
			local ghost = GhostData.get(selected)
			if isFound(selected) then
				info.Text = Lang.t("IndexCard", { ghost = selected, gag = Lang.ghostGag(selected) })
					.. "  (+" .. Format.short(ghost.Income) .. "/s)"
			else
				info.Text = Lang.rarityName(ghost.Rarity) .. " : " .. Lang.t("IndexUnknownHint")
			end
		elseif indexInfo and indexInfo.Complete then
			info.Text = "🏆 " .. Lang.t("IndexBonusDone", { percent = percent })
		else
			info.Text = Lang.t("IndexBonus", { percent = percent }) .. "  •  " .. Lang.t("IndexHint")
		end
	end
	table.insert(refreshers, refresh)
	return panel
end

---------------------------------------------------------------- Missions du jour

local TIER_COLORS = {
	easy = Color3.fromRGB(80, 220, 120),
	medium = Color3.fromRGB(255, 190, 40),
	hard = Color3.fromRGB(255, 80, 90),
}

local function buildMissions(): Frame
	local panel, body = makePanel("Missions", "📋 " .. Lang.t("MissionsTitle"), UI.Colors.Info)
	local cards = {}
	for i = 1, 3 do
		local card = UI.new("Frame", {
			Name = "Mission" .. i,
			Size = UDim2.new(1, 0, 0, 72),
			Position = UDim2.fromOffset(0, (i - 1) * 80),
			BackgroundColor3 = UI.Colors.PanelLight,
			Parent = body,
		}, { UI.corner(16), UI.stroke(nil, 3) })
		local icon = UI.label({ Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(8, 8), MaxTextSize = 44, Parent = card })
		local tier = UI.label({ Size = UDim2.fromOffset(110, 22), Position = UDim2.fromOffset(72, 4), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 18, Parent = card })
		local text = UI.label({ Name = "Text", Size = UDim2.new(1, -230, 0, 26), Position = UDim2.fromOffset(72, 24), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = card })
		local bar = UI.new("Frame", {
			Position = UDim2.fromOffset(72, 54),
			Size = UDim2.new(1, -230, 0, 10),
			BackgroundColor3 = UI.Colors.Stroke,
			Parent = card,
		}, { UI.corner(5) })
		local fill = UI.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = UI.Colors.Good, Parent = bar }, { UI.corner(5) })
		local count = UI.label({ Name = "Count", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -110, 0, 18), Size = UDim2.fromOffset(110, 40), MaxTextSize = 26, Parent = card })
		local reward = UI.label({ Name = "Reward", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 18), Size = UDim2.fromOffset(100, 40), TextColor3 = UI.Colors.Gold, MaxTextSize = 26, Parent = card })
		cards[i] = { Icon = icon, Tier = tier, Text = text, Fill = fill, Count = count, Reward = reward }
	end
	local bonus = UI.label({ Name = "Bonus", Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 244), TextColor3 = UI.Colors.Gold, MaxTextSize = 24, Parent = body })
	local footer = UI.label({ Name = "Footer", Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 284), TextColor3 = UI.Colors.Info, MaxTextSize = 20, Parent = body })

	local function refresh()
		local info = missionsInfo
		if not info or not panel.Visible then
			return
		end
		local income = player:GetAttribute("Income") or 0
		for i, card in cards do
			local mission = info.List[i]
			if mission then
				local def = Missions.Defs[mission.Id] or {}
				local n = if mission.Id == "Earn" then Format.short(mission.Target) else mission.Target
				card.Icon.Text = if mission.Done then "✅" else (def.Icon or "⭐")
				card.Tier.Text = Lang.t("MissionTier_" .. mission.Tier)
				card.Tier.TextColor3 = TIER_COLORS[mission.Tier] or UI.Colors.Text
				card.Text.Text = Lang.t("Mission_" .. mission.Id, { n = n })
				card.Fill.Size = UDim2.fromScale(math.clamp(mission.Progress / mission.Target, 0, 1), 1)
				card.Count.Text = if mission.Id == "Earn"
					then Format.short(mission.Progress) .. "/" .. Format.short(mission.Target)
					else mission.Progress .. "/" .. mission.Target
				card.Reward.Text = if mission.Done then "✅" else "🪙 " .. Format.short(Missions.reward(mission.Tier, income))
			end
		end
		if info.BonusDone then
			bonus.Text = Lang.t("MissionsBonusDone")
		else
			bonus.Text = Lang.t("MissionsBonus", { coins = Format.short(Missions.reward("bonus", income)) })
		end
		footer.Text = Lang.t("MissionsNext", { time = Format.time((info.ResetAt or 0) - workspace:GetServerTimeNow()) })
	end
	table.insert(refreshers, refresh)
	return panel
end

---------------------------------------------------------------- Démarrage

-- Ouvre la boutique sur un onglet ("Passes", "Weapons", "Wheel", "Monsters", "Coins", "Codes")
function Panels.openShop(category: string?)
	local panel = gui and gui:FindFirstChild("Shop") :: Frame?
	if not panel then
		return
	end
	if openPanel ~= panel then
		open(panel)
	end
	if shopSelect then
		shopSelect(category or "Passes")
	end
end

function Panels.openDaily()
	local panel = gui and gui:FindFirstChild("Daily") :: Frame?
	if panel and openPanel ~= panel then
		open(panel)
	end
end

function Panels.start()
	gui = UI.screen("SAG_Panels", 3)
	local daily = buildDaily()
	local missions = buildMissions()
	local index = buildIndex()
	local rebirth = buildRebirth()
	local shop = buildShop()

	local column = HUD.leftColumn
	local size = 76
	local giftButton = UI.bigButton({ Name = "Gift", Icon = "🎁", Text = Lang.t("Daily"), Color = UI.Colors.Gold, Size = size, LayoutOrder = 1, Parent = column })
	local missionsButton = UI.bigButton({ Name = "MissionsButton", Icon = "📋", Text = Lang.t("Missions"), Color = UI.Colors.Info, Size = size, LayoutOrder = 2, Parent = column })
	local indexButton = UI.bigButton({ Name = "Index", Icon = "📖", Text = Lang.t("Index"), Color = UI.Colors.Purple, Size = size, LayoutOrder = 3, Parent = column })
	local rebirthButton = UI.bigButton({ Name = "Rebirth", Icon = "♻️", Text = Lang.t("Rebirth"), Color = Color3.fromRGB(60, 190, 150), Size = size, LayoutOrder = 4, Parent = column })
	local shopButton = UI.bigButton({ Name = "Shop", Icon = "🛒", Text = Lang.t("Shop"), Color = UI.Colors.Orange, Size = size, LayoutOrder = 5, Parent = column })

	-- Pastille rouge sur un bouton (cadeau prêt, nouveau fantôme...)
	local function makeDot(parent: Instance, text: string): TextLabel
		local dot = UI.label({
			Name = "Dot",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(34, 34),
			BackgroundTransparency = 0,
			BackgroundColor3 = UI.Colors.Bad,
			Text = text,
			MaxTextSize = 28,
			Visible = false,
			Parent = parent,
		})
		UI.corner(17).Parent = dot
		return dot
	end
	local dot = makeDot(giftButton, "!")
	local indexDot = makeDot(indexButton, "!")
	local missionsDot = makeDot(missionsButton, "!")
	local seenMissionsDay = nil

	missionsButton.Activated:Connect(function()
		Effects.sound("Click")
		missionsDot.Visible = false
		seenMissionsDay = missionsInfo and missionsInfo.Day
		open(missions)
	end)
	Remotes.get("MissionsInfo").OnClientEvent:Connect(function(info)
		missionsInfo = info
		-- point rouge : nouvelles missions pas encore regardées
		missionsDot.Visible = info.Day ~= seenMissionsDay and not info.BonusDone
		for _, refresh in refreshers do
			refresh()
		end
	end)

	giftButton.Activated:Connect(function()
		Effects.sound("Click")
		open(daily)
	end)
	indexButton.Activated:Connect(function()
		Effects.sound("Click")
		indexDot.Visible = false
		open(index)
	end)
	Remotes.get("IndexInfo").OnClientEvent:Connect(function(info)
		local previous = if indexInfo then #indexInfo.Discovered else nil
		indexInfo = info
		if previous and #info.Discovered > previous and openPanel ~= index then
			indexDot.Visible = true
		end
		for _, refresh in refreshers do
			refresh()
		end
	end)
	rebirthButton.Activated:Connect(function()
		Effects.sound("Click")
		open(rebirth)
	end)
	shopButton.Activated:Connect(function()
		Effects.sound("Click")
		open(shop)
	end)

	local function maybeAutoOpen()
		if dailyInfo and dailyInfo.CanClaim and player:GetAttribute("TutorialDone") then
			task.delay(2, Panels.openDaily)
		end
	end
	Remotes.get("DailyInfo").OnClientEvent:Connect(function(info)
		local first = dailyInfo == nil
		dailyInfo = info
		dot.Visible = info.CanClaim
		if first then
			maybeAutoOpen()
		end
		for _, refresh in refreshers do
			refresh()
		end
	end)
	player:GetAttributeChangedSignal("TutorialDone"):Connect(maybeAutoOpen)
	for _, attribute in { "Spins", "RandomItemsRestricted" } do
		player:GetAttributeChangedSignal(attribute):Connect(function()
			if openPanel then
				for _, refresh in refreshers do
					refresh()
				end
			end
		end)
	end

	-- Rafraîchit la fenêtre ouverte (prix, compte à rebours)
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if openPanel and accumulator >= 0.5 then
			accumulator = 0
			for _, refresh in refreshers do
				refresh()
			end
		end
	end)
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">PathView</string>
            <string name="Source"><![CDATA[--[[
	PathView : affiche les fantômes qui défilent sur le chemin hanté.
	Le serveur dit seulement "tel fantôme est parti à telle heure" : on calcule
	nous-mêmes sa position à chaque image (pas de saccades, pas de lag réseau).
	Le bouton "Acheter" envoie juste une DEMANDE au serveur, qui vérifie tout.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local GhostData = require(Shared:WaitForChild("GhostData"))
local GhostFactory = require(Shared:WaitForChild("GhostFactory"))
local Rarities = require(Shared:WaitForChild("Rarities"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Effects = require(script.Parent.Effects)
local Labels = require(script.Parent.Labels)
local Lang = require(script.Parent.Lang)

local PathView = {}

type Item = { Model: Model, SpawnTime: number, Height: number, Phase: number, Spin: number }

local items: { [Instance]: Item } = {}
local container: Folder

-- Colonne de lumière visible de loin pour les fantômes très rares
local function addBeacon(model: Model, color: Color3)
	local beacon = Instance.new("Part")
	beacon.Name = "Beacon"
	beacon.Anchored = true
	beacon.CanCollide = false
	beacon.CanQuery = false
	beacon.CanTouch = false
	beacon.CastShadow = false
	beacon.Shape = Enum.PartType.Cylinder
	beacon.Size = Vector3.new(80, 3, 3)
	beacon.CFrame = (model.PrimaryPart :: BasePart).CFrame * CFrame.new(0, 40, 0) * CFrame.Angles(0, 0, math.rad(90))
	beacon.Color = color
	beacon.Material = Enum.Material.Neon
	beacon.Transparency = 0.55
	beacon.Parent = model
end

-- Où se trouve ce fantôme à l'instant "now" ?
function PathView.positionOf(spawnTime: number, now: number, height: number): Vector3
	local x = Config.PathStartX + (now - spawnTime) * Config.PathSpeed
	return Vector3.new(x, height, Config.PathZ)
end

-- Renvoie le fantôme du chemin le plus proche d'une position (utilisé par le tutoriel)
function PathView.closest(position: Vector3): Model?
	local best, bestDist = nil, math.huge
	for _, item in items do
		local root = item.Model.PrimaryPart
		if root then
			local dist = (root.Position - position).Magnitude
			if dist < bestDist then
				best, bestDist = item.Model, dist
			end
		end
	end
	return best
end

local function add(holder: Instance)
	local ghostId = holder:GetAttribute("GhostId")
	local spawnTime = holder:GetAttribute("SpawnTime")
	local ghost = GhostData.get(ghostId)
	if not ghost or not spawnTime then
		return
	end
	local model = GhostFactory.build(ghostId)
	local root = model.PrimaryPart :: BasePart
	local height = (model:GetAttribute("Bottom") or 2) + 1.2
	local top = model:GetAttribute("Top") or 2

	model:PivotTo(CFrame.new(PathView.positionOf(spawnTime, workspace:GetServerTimeNow(), height)))
	Labels.ghost(root, ghostId, "path", top)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = Lang.t("Buy") .. "  🪙 " .. Format.short(GhostData.priceOf(ghostId))
	prompt.ObjectText = Lang.ghostName(ghostId)
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = Config.BuyRange
	prompt.RequiresLineOfSight = false
	prompt.AutoLocalize = Lang.autoLocalize
	prompt.Parent = root
	prompt.Triggered:Connect(function()
		Effects.sound("Click")
		Remotes.get("BuyGhost"):FireServer(holder.Name)
	end)

	local mutation = GhostData.mutationOf(ghostId)
	if Rarities.rank(ghost.Rarity) >= Rarities.rank("Mythic") then
		addBeacon(model, Rarities.color(ghost.Rarity))
	elseif mutation and mutation.Mult >= 5 then
		addBeacon(model, Color3.fromRGB(mutation.Color[1], mutation.Color[2], mutation.Color[3]))
	end

	model.Parent = container
	items[holder] = {
		Model = model,
		SpawnTime = spawnTime,
		Height = height,
		Phase = math.random() * math.pi * 2,
		Spin = model:GetAttribute("Spin") or 1,
	}
end

local function remove(holder: Instance)
	local item = items[holder]
	if item then
		items[holder] = nil
		local root = item.Model.PrimaryPart
		if root and root.Position.X < Config.PathEndX - 2 then
			Effects.poof(root.Position) -- acheté par quelqu'un : petit nuage
		end
		item.Model:Destroy()
	end
end

function PathView.start()
	container = Instance.new("Folder")
	container.Name = "ClientPathGhosts"
	container.Parent = workspace

	local folder = ReplicatedStorage:WaitForChild("PathGhosts")
	folder.ChildAdded:Connect(function(holder)
		-- on attend que les attributs soient arrivés
		if holder:GetAttribute("SpawnTime") == nil then
			holder:GetAttributeChangedSignal("SpawnTime"):Wait()
		end
		if holder.Parent then
			add(holder)
		end
	end)
	folder.ChildRemoved:Connect(remove)
	for _, holder in folder:GetChildren() do
		add(holder)
	end

	RunService.RenderStepped:Connect(function()
		local now = workspace:GetServerTimeNow()
		local t = os.clock()
		for holder, item in items do
			local pos = PathView.positionOf(item.SpawnTime, now, item.Height)
			if pos.X > Config.PathEndX + 4 then
				items[holder] = nil
				item.Model:Destroy()
			else
				local bob = math.sin(t * 2 + item.Phase) * 0.4
				local angle = t * 0.6 * item.Spin + item.Phase
				item.Model:PivotTo(CFrame.new(pos.X, pos.Y + bob, pos.Z) * CFrame.Angles(0, angle, 0))
			end
		end
	end)
end

return PathView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--[[
	Tutorial : le tutoriel des nouveaux joueurs, en 3 flèches et presque sans texte.
	  1. "Achète !"  -> flèche sur un fantôme du chemin (fini quand on a acheté)
	  2. "Récupère !" -> flèche sur la plaque verte qui a le plus de pièces (fini à la 1re récolte)
	  3. "Vole !"    -> flèche sur la base d'un autre joueur (fini quand on vole, ou après 25 s)
	Une ligne jaune relie le joueur à la flèche. À la fin, le serveur note que c'est fait.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local Effects = require(script.Parent.Effects)
local Lang = require(script.Parent.Lang)
local PathView = require(script.Parent.PathView)
local UI = require(script.Parent.UI)

local Tutorial = {}

local player = Players.LocalPlayer

local marker: Part
local arrowGui: BillboardGui
local arrowText: TextLabel
local beam: Beam
local playerAttachment: Attachment?

local function root(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function basesFolder(): Instance?
	local map = workspace:FindFirstChild("Map")
	return map and map:FindFirstChild("Bases")
end

local function myBase(): Model?
	local folder = basesFolder()
	local index = player:GetAttribute("BaseIndex")
	return folder and index and folder:FindFirstChild("Base_" .. index) :: Model?
end

-- La base d'un autre joueur la plus proche, qui a au moins un fantôme
local function nearestOtherBase(position: Vector3): Model?
	local folder = basesFolder()
	if not folder then
		return nil
	end
	local best, bestDist = nil, math.huge
	for _, base in folder:GetChildren() do
		local owner = base:GetAttribute("OwnerUserId") or 0
		if owner ~= 0 and owner ~= player.UserId then
			local hasGhost = false
			for _, ped in base.Pedestals:GetChildren() do
				if (ped:GetAttribute("GhostId") or "") ~= "" then
					hasGhost = true
					break
				end
			end
			local origin = base:GetAttribute("Origin") :: CFrame
			local dist = (origin.Position - position).Magnitude
			if hasGhost and dist < bestDist then
				best, bestDist = base, dist
			end
		end
	end
	return best
end

local function buildMarker()
	marker = Instance.new("Part")
	marker.Name = "TutorialMarker"
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanQuery = false
	marker.CanTouch = false
	marker.Transparency = 1
	marker.Size = Vector3.one
	marker.Parent = workspace

	arrowGui = UI.new("BillboardGui", {
		Size = UDim2.fromOffset(180, 150),
		AlwaysOnTop = true,
		LightInfluence = 0,
		AutoLocalize = Lang.autoLocalize,
		Adornee = marker,
		Parent = marker,
	})
	arrowText = UI.label({
		Size = UDim2.new(1, 0, 0, 50),
		TextColor3 = UI.Colors.Gold,
		MaxTextSize = 40,
		Parent = arrowGui,
	})
	UI.label({
		Size = UDim2.new(1, 0, 0, 100),
		Position = UDim2.fromOffset(0, 50),
		Text = "⬇️",
		MaxTextSize = 90,
		Parent = arrowGui,
	})

	local targetAttachment = Instance.new("Attachment")
	targetAttachment.Parent = marker
	beam = Instance.new("Beam")
	beam.Attachment1 = targetAttachment
	beam.Color = ColorSequence.new(UI.Colors.Gold)
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Transparency = NumberSequence.new(0.25)
	beam.Segments = 1
	beam.Parent = marker
end

local function attachBeamToPlayer()
	local r = root()
	if r and (not playerAttachment or playerAttachment.Parent ~= r) then
		local attachment = Instance.new("Attachment")
		attachment.Name = "TutorialAttachment"
		attachment.Parent = r
		playerAttachment = attachment
		beam.Attachment0 = attachment
	end
end

local function cleanup()
	if marker then
		marker:Destroy()
	end
	if playerAttachment then
		playerAttachment:Destroy()
	end
end

function Tutorial.start()
	if player:GetAttribute("TutorialDone") then
		return
	end
	buildMarker()
	local step = 1
	local stepStarted = os.clock()
	local finished = false
	local connection: RBXScriptConnection

	local function nextStep()
		step += 1
		stepStarted = os.clock()
		Effects.sound("Gift")
	end

	local function finish()
		if finished then
			return
		end
		finished = true
		connection:Disconnect()
		cleanup()
		Remotes.get("TutorialDone"):FireServer()
	end

	connection = RunService.RenderStepped:Connect(function()
		local r = root()
		if not r then
			return
		end
		attachBeamToPlayer()
		local t = os.clock()
		local targetPosition: Vector3? = nil

		if step == 1 then
			arrowText.Text = "🛒 " .. Lang.t("Tuto1")
			local ghost = PathView.closest(r.Position)
			if ghost and ghost.PrimaryPart then
				targetPosition = ghost.PrimaryPart.Position + Vector3.new(0, 4, 0)
			end
			if player:GetAttribute("HasBought") then
				nextStep()
			end
		elseif step == 2 then
			arrowText.Text = "💰 " .. Lang.t("Tuto2")
			local base = myBase()
			if base then
				-- la plaque verte du socle qui a le plus de pièces en attente
				local bestPad, bestStored = nil, -1
				for _, ped in base.Pedestals:GetChildren() do
					local stored = ped:GetAttribute("Stored") or 0
					local pad = ped:FindFirstChild("CollectPad") :: BasePart?
					if pad and ped:GetAttribute("Floor") ~= 2 and stored > bestStored then
						bestPad, bestStored = pad, stored
					end
				end
				targetPosition = if bestPad then bestPad.Position + Vector3.new(0, 3, 0) else nil
				if player:GetAttribute("HasCollected") or t - stepStarted > 45 then
					nextStep()
				end
			else
				nextStep()
			end
		elseif step == 3 then
			arrowText.Text = "🦹 " .. Lang.t("Tuto3")
			local other = nearestOtherBase(r.Position)
			local mat = other and other:FindFirstChild("Mat") :: BasePart?
			if mat then
				targetPosition = mat.Position + Vector3.new(0, 4, 0)
			end
			if not other or player:GetAttribute("CarryGhost") or t - stepStarted > 25 then
				finish()
				return
			end
		end

		if targetPosition then
			marker.CFrame = CFrame.new(targetPosition + Vector3.new(0, 3 + math.abs(math.sin(t * 4)) * 1.5, 0))
			arrowGui.Enabled = true
			beam.Enabled = true
		else
			arrowGui.Enabled = false
			beam.Enabled = false
		end
	end)

	player:GetAttributeChangedSignal("TutorialDone"):Connect(function()
		if player:GetAttribute("TutorialDone") then
			finish()
		end
	end)
end

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--[[
	UI : petite boîte à outils pour créer l'interface (couleurs, coins arrondis,
	gros boutons qui rebondissent, mise à l'échelle automatique pour les mobiles).
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Lang = require(script.Parent.Lang)

local UI = {}

UI.Font = Enum.Font.FredokaOne
UI.Colors = {
	Panel = Color3.fromRGB(38, 24, 58),
	PanelLight = Color3.fromRGB(70, 45, 105),
	Stroke = Color3.fromRGB(20, 10, 30),
	Text = Color3.fromRGB(255, 255, 255),
	Gold = Color3.fromRGB(255, 205, 60),
	Good = Color3.fromRGB(80, 220, 120),
	Bad = Color3.fromRGB(255, 80, 90),
	Info = Color3.fromRGB(120, 190, 255),
	Purple = Color3.fromRGB(170, 100, 255),
	Orange = Color3.fromRGB(255, 140, 30),
	Gray = Color3.fromRGB(110, 105, 120),
}

local player = Players.LocalPlayer

function UI.isMobile(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- Crée une instance avec ses propriétés et ses enfants en une seule fois
function UI.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance: any = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UI.corner(radius: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

function UI.stroke(color: Color3?, thickness: number?): UIStroke
	return UI.new("UIStroke", {
		Color = color or UI.Colors.Stroke,
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.textStroke(thickness: number?): UIStroke
	return UI.new("UIStroke", {
		Color = UI.Colors.Stroke,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

-- Un texte qui s'adapte à sa boîte (taille max pour rester lisible)
function UI.label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextColor3 = UI.Colors.Text,
		TextScaled = true,
		Text = "",
	}
	for key, value in props do
		defaults[key] = value
	end
	local maxSize = defaults.MaxTextSize
	defaults.MaxTextSize = nil
	local label = UI.new("TextLabel", defaults)
	UI.new("UITextSizeConstraint", { MaxTextSize = maxSize or 40, MinTextSize = 8, Parent = label })
	UI.textStroke(2).Parent = label
	return label
end

-- Le conteneur principal de l'interface, mis à l'échelle selon l'écran
function UI.screen(name: string, displayOrder: number?): ScreenGui
	local gui = UI.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 0,
		AutoLocalize = Lang.autoLocalize,
	})
	local scale = UI.new("UIScale", { Parent = gui })
	local function update()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local size = camera.ViewportSize
		-- l'interface est dessinée pour un écran de 720 px de haut
		scale.Scale = math.clamp(math.min(size.X, size.Y) / 720, 0.72, 1.35)
	end
	update()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(update)
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
	gui.Parent = player:WaitForChild("PlayerGui")
	return gui
end

-- Gros bouton rond ou carré avec une icône (emoji) et un texte en dessous
function UI.bigButton(props: {
	Name: string,
	Icon: string,
	Text: string,
	Color: Color3,
	Size: number?,
	Parent: Instance?,
	LayoutOrder: number?,
}): (TextButton, TextLabel, TextLabel)
	local size = props.Size or 104
	local button = UI.new("TextButton", {
		Name = props.Name,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = props.Color,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	}, { UI.corner(math.floor(size * 0.28)), UI.stroke(nil, 4) })
	local icon = UI.label({
		Name = "Icon",
		Size = UDim2.fromScale(1, 0.58),
		Position = UDim2.fromScale(0, 0.04),
		Text = props.Icon,
		MaxTextSize = 60,
		Parent = button,
	})
	local text = UI.label({
		Name = "Caption",
		Size = UDim2.fromScale(0.92, 0.32),
		Position = UDim2.fromScale(0.04, 0.62),
		Text = props.Text,
		MaxTextSize = 22,
		Parent = button,
	})
	local scaler = UI.new("UIScale", { Parent = button })
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scaler, TweenInfo.new(0.08), { Scale = 0.9 }):Play()
	end)
	local function release()
		TweenService:Create(scaler, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)
	return button, icon, text
end

-- Petit rebond pour attirer l'œil
function UI.pop(guiObject: GuiObject)
	local scaler = guiObject:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = guiObject })
	scaler.Scale = 1.25
	TweenService:Create(scaler, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">WeaponView</string>
            <string name="Source"><![CDATA[--[[
	WeaponView : les armes côté joueur.
	  - clic (ou toucher l'écran) avec une arme en main : on frappe
	  - un gros bouton rouge apparaît quand un voleur (ou un intrus dans ta base) est
	    à portée : il prend ta meilleure arme et frappe. Touche Q sur ordinateur.
	Le serveur vérifie tout (distance, recharge) et décide de l'effet.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Weapons = require(Shared:WaitForChild("Weapons"))

local AnimView = require(script.Parent.AnimView)
local Effects = require(script.Parent.Effects)
local HUD = require(script.Parent.HUD)
local Lang = require(script.Parent.Lang)
local UI = require(script.Parent.UI)

local WeaponView = {}

local player = Players.LocalPlayer
local readyAt = 0
local hitButton: TextButton
local hitIcon: TextLabel
local hitText: TextLabel
local connected: { [Tool]: boolean } = {}

local function myRoot(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Toutes mes armes (dans le sac ou en main)
local function myTools(): { Tool }
	local list = {}
	for _, container in { player:FindFirstChildOfClass("Backpack"), player.Character } do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and Weapons.get(child:GetAttribute("WeaponId")) then
					table.insert(list, child)
				end
			end
		end
	end
	return list
end

local function equipped(): Tool?
	local character = player.Character
	if not character then
		return nil
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and Weapons.get(child:GetAttribute("WeaponId")) then
			return child
		end
	end
	return nil
end

-- La meilleure arme : celle en main, sinon celle qui porte le plus loin
local function bestTool(): Tool?
	local current = equipped()
	if current then
		return current
	end
	local best, bestRange = nil, -1
	for _, tool in myTools() do
		local weapon = Weapons.get(tool:GetAttribute("WeaponId"))
		if weapon and weapon.Range > bestRange then
			best, bestRange = tool, weapon.Range
		end
	end
	return best
end

local function myBase(): Model?
	local map = workspace:FindFirstChild("Map")
	local folder = map and map:FindFirstChild("Bases")
	local index = player:GetAttribute("BaseIndex")
	return folder and index and folder:FindFirstChild("Base_" .. index) :: Model?
end

local function insideBase(base: Model, position: Vector3): boolean
	local origin = base:GetAttribute("Origin")
	if typeof(origin) ~= "CFrame" then
		return false
	end
	local localPos = origin:PointToObjectSpace(position)
	return math.abs(localPos.X) < 18 and math.abs(localPos.Z) < 20
end

-- Y a-t-il quelqu'un à frapper à portée ? (voleur, ou intrus dans ma base)
local function targetInRange(range: number): boolean
	local root = myRoot()
	if not root then
		return false
	end
	local base = myBase()
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local otherRoot = other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if otherRoot and (otherRoot.Position - root.Position).Magnitude <= range + 1 then
				if other:GetAttribute("CarryGhost") or (base and insideBase(base, otherRoot.Position)) then
					return true
				end
			end
		end
	end
	return false
end

function WeaponView.swing(tool: Tool?)
	local chosen = tool or bestTool()
	local weapon = Weapons.get(if chosen then chosen:GetAttribute("WeaponId") else "Batte") or Weapons.ById.Batte
	local t = os.clock()
	if t < readyAt or player:GetAttribute("CarryGhost") then
		return
	end
	readyAt = t + weapon.Cooldown
	if chosen then
		-- on prend l'arme en main si besoin
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and chosen.Parent ~= character then
			humanoid:EquipTool(chosen)
		end
		-- l'animation officielle de Roblox ("Slash" ou "Lunge"), jouée par mon personnage
		-- et montrée par Roblox à tous les autres joueurs
		AnimView.playToolAnim(chosen, weapon.Anim or "Slash")
	end
	-- traînée tout de suite sur mon écran ; le serveur prévient les autres
	AnimView.swing(player.Character, weapon.Id, nil, true, false)
	Effects.sound("Swing")
	Remotes.get("Bonk"):FireServer(weapon.Id)
end

local function hookTool(tool: Instance)
	if not tool:IsA("Tool") or connected[tool] or not Weapons.get(tool:GetAttribute("WeaponId")) then
		return
	end
	connected[tool] = true
	tool.Activated:Connect(function()
		WeaponView.swing(tool)
	end)
	tool.AncestryChanged:Connect(function()
		if not tool.Parent then
			connected[tool] = nil
		end
	end)
end

local function watch(container: Instance?)
	if not container then
		return
	end
	for _, child in container:GetChildren() do
		hookTool(child)
	end
	container.ChildAdded:Connect(hookTool)
end

function WeaponView.start()
	local caption = Lang.t("Bonk") .. (if UI.isMobile() then "" else " (Q)")
	hitButton, hitIcon, hitText = UI.bigButton({
		Name = "Bonk",
		Icon = "🏏",
		Text = caption,
		Color = UI.Colors.Bad,
		Size = 112,
		LayoutOrder = 2,
		Parent = HUD.rightColumn,
	})
	hitButton.Visible = false
	hitButton.Activated:Connect(function()
		WeaponView.swing(nil)
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Q then
			WeaponView.swing(nil)
		end
	end)

	watch(player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5))
	player.CharacterAdded:Connect(function(character)
		watch(character)
		task.defer(function()
			watch(player:FindFirstChildOfClass("Backpack"))
		end)
	end)
	if player.Character then
		watch(player.Character)
	end

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.1 then
			return
		end
		accumulator = 0
		local tool = bestTool()
		local weapon = Weapons.get(if tool then tool:GetAttribute("WeaponId") else "Batte") or Weapons.ById.Batte
		local inRange = not player:GetAttribute("CarryGhost") and targetInRange(weapon.Range)
		local wasVisible = hitButton.Visible
		hitButton.Visible = inRange
		if inRange and not wasVisible then
			UI.pop(hitButton)
		end
		hitIcon.Text = weapon.Icon
		local cooldown = readyAt - os.clock()
		if cooldown > 0 then
			hitButton.BackgroundColor3 = UI.Colors.Gray
			hitText.Text = string.format("%.1f", cooldown)
		else
			hitButton.BackgroundColor3 = UI.Colors.Bad
			hitText.Text = caption
		end
	end)
end

return WeaponView
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
